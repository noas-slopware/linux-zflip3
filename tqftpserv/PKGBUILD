# b2q: the AUR's tqftpserv PKGBUILD (1.2-1), moved to upstream master after 1.3
# (eb4b9a0, 2026-10-27): 1.3 adds tqftpserv-populate-readwrite, which copies the
# modem's readwrite files from the persist partition before tqftpserv starts,
# and the commit after it installs its script under /usr/libexec.
# Maintainer: Super Tecno Gym <banana@grrlz.net>

pkgname="tqftpserv"
pkgdesc="Trivial File Transfer Protocol server over AF_QIPCRTR"
_commit=eb4b9a04ff92d2753ededf32cc3b6ed287f6e29b
pkgver=1.3.r4.geb4b9a0
pkgrel=1
arch=(aarch64 x86_64)
url="https://github.com/linux-msm/tqftpserv"
license=("BSD-3-Clause")
depends=(qrtr zstd xz)
conflicts=("${pkgname%-git}")
groups=(qcom-icnss-wlan)
_srcname="${pkgname}-${_commit}"
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/linux-msm/tqftpserv/archive/${_commit}.tar.gz")
sha256sums=('a8739ad1c8c8d159ed8f83fc3b20020d222557343a634e0308fc535f80dcaaf7')
makedepends=(meson)

build() {
        cd "$_srcname"

        mkdir -p build
        meson setup build --prefix=/usr
        meson compile -C build

}

package() {
        cd "$_srcname"

        meson install -C build --destdir "$pkgdir"
        install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}
