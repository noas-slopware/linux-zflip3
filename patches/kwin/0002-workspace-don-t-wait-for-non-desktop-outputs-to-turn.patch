+void OutputChangesTest::testDpmsOffWithNonDesktopOutput()
+{
+    // a desktop output and a non-desktop one, such as a display leased to a client
+    Test::setOutputConfig({
+        Test::OutputInfo{
+            .geometry = Rect(0, 0, 1280, 1024),
+            .connectorName = QStringLiteral("TEST"),
+        },
+        Test::OutputInfo{
+            .geometry = Rect(1280, 0, 512, 260),
+            .connectorName = QStringLiteral("LEASED"),
+            .nonDesktop = true,
+        },
+    });
+    const auto outputs = kwinApp()->outputBackend()->outputs();
+    QCOMPARE(outputs.size(), 2);
+    QVERIFY(outputs[1]->isNonDesktop());
+    workspace()->requestDpmsState(Workspace::DpmsState::On);
+    QCOMPARE(workspace()->dpmsState(), Workspace::DpmsState::On);
+
+    // turning the outputs off ends in Off, which releases the sleep inhibitor,
+    // even though the non-desktop output is not ours to turn off
+    workspace()->requestDpmsState(Workspace::DpmsState::Off);
+    QCOMPARE(workspace()->dpmsState(), Workspace::DpmsState::AboutToTurnOff);
+    QSignalSpy dpmsChanged(workspace(), &Workspace::dpmsStateChanged);
+    QVERIFY(dpmsChanged.wait());
+    QTRY_COMPARE(workspace()->dpmsState(), Workspace::DpmsState::Off);
+    QCOMPARE(outputs[0]->dpmsMode(), BackendOutput::DpmsMode::Off);
+
+    workspace()->requestDpmsState(Workspace::DpmsState::On);
+    QCOMPARE(workspace()->dpmsState(), Workspace::DpmsState::On);
+}
+
 } // namespace KWin
 
 WAYLANDTEST_MAIN(KWin::OutputChangesTest)
