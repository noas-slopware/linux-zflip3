diff --git a/src/mm-broadband-modem-qmi.c b/src/mm-broadband-modem-qmi.c
index 7ce39d5..08d1b23 100644
--- a/src/mm-broadband-modem-qmi.c
+++ b/src/mm-broadband-modem-qmi.c
@@ -52,6 +52,9 @@
 #include "mm-sms-part-cdma.h"
 #include "mm-call-qmi.h"
 #include "mm-call-list.h"
+#include "mm-ims-backend-b2q.h"
+#include "mm-call-ims.h"
+#include "mm-sms-ims.h"
 
 static void iface_modem_init                      (MMIfaceModemInterface                   *iface);
 static void iface_modem_3gpp_init                 (MMIfaceModem3gppInterface               *iface);
@@ -181,8 +184,53 @@ struct _MMBroadbandModemQmiPrivate {
     /* Packet service state helpers when using NAS System Info and DSD
      * (not applicable when using NAS Serving System) */
     gboolean dsd_supported;
+
+    /* B2Q IMS backend */
+    gboolean b2q_ims_checked;
+    gboolean b2q_ims_enabled;
+    GObject *b2q_ims_backend;
 };
 
+gboolean
+mm_broadband_modem_qmi_is_b2q_ims_enabled (MMBroadbandModemQmi *self)
+{
+    if (!self->priv->b2q_ims_checked) {
+        GList *ports;
+        GList *l;
+
+        self->priv->b2q_ims_checked = TRUE;
+        self->priv->b2q_ims_enabled = FALSE;
+
+        ports = mm_base_modem_find_ports (MM_BASE_MODEM (self), MM_PORT_SUBSYS_UNKNOWN, MM_PORT_TYPE_UNKNOWN);
+        for (l = ports; l; l = g_list_next (l)) {
+            MMKernelDevice *kernel_device = mm_port_peek_kernel_device (MM_PORT (l->data));
+            if (kernel_device) {
+                if (mm_kernel_device_get_global_property_as_boolean (kernel_device, "ID_MM_B2Q_IMS") ||
+                    mm_kernel_device_get_property_as_boolean (kernel_device, "ID_MM_B2Q_IMS")) {
+                    self->priv->b2q_ims_enabled = TRUE;
+                    break;
+                }
+            }
+        }
+        g_list_free_full (ports, g_object_unref);
+
+        if (self->priv->b2q_ims_enabled) {
+            mm_obj_info (self, "b2q IMS support enabled via udev tag ID_MM_B2Q_IMS");
+            self->priv->b2q_ims_backend = (GObject *) mm_ims_backend_b2q_new (self);
+        }
+    }
+
+    return self->priv->b2q_ims_enabled;
+}
+
+MMImsBackendB2q *
+mm_broadband_modem_qmi_peek_ims_backend (MMBroadbandModemQmi *self)
+{
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self))
+        return MM_IMS_BACKEND_B2Q (self->priv->b2q_ims_backend);
+    return NULL;
+}
+
 /*****************************************************************************/
 
 static QmiClient *
@@ -7545,6 +7593,13 @@ messaging_check_support (MMIfaceModemMessaging *self,
 
     task = g_task_new (self, NULL, callback, user_data);
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (MM_BROADBAND_MODEM_QMI (self))) {
+        mm_obj_dbg (self, "messaging capabilities supported via b2q IMS");
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
     /* If we have support for the WMS client, messaging is supported */
     if (!mm_shared_qmi_peek_client (MM_SHARED_QMI (self),
                                     QMI_SERVICE_WMS,
@@ -7693,6 +7748,14 @@ messaging_init_current_storages (MMIfaceModemMessaging *_self,
 {
     MMBroadbandModemQmi *self = MM_BROADBAND_MODEM_QMI (_self);
     QmiClient *client = NULL;
+    GTask *task;
+
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        task = g_task_new (self, NULL, callback, user_data);
+        g_task_return_int (task, (gssize)MM_SMS_STORAGE_ME);
+        g_object_unref (task);
+        return;
+    }
 
     /* Handle AT URC only fallback */
     if (self->priv->messaging_fallback_at_only) {
@@ -7804,6 +7867,14 @@ messaging_set_default_storage (MMIfaceModemMessaging *_self,
     QmiMessageWmsSetRoutesInput *input;
     GArray *routes_array;
     QmiMessageWmsSetRoutesInputRouteListElement route;
+    GTask *task;
+
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        task = g_task_new (self, NULL, callback, user_data);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
 
     /* Handle AT URC only fallback */
     if (self->priv->messaging_fallback_at_only) {
@@ -8261,6 +8332,20 @@ load_initial_sms_parts_step (GTask *task)
     qmi_message_wms_list_messages_input_unref (input);
 }
 
+static void
+b2q_load_initial_sms_ready (MMImsBackendB2q *backend,
+                            GAsyncResult    *res,
+                            GTask           *task)
+{
+    GError *error = NULL;
+
+    if (!mm_ims_backend_b2q_load_initial_sms_finish (backend, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
 static void
 load_initial_sms_parts (MMIfaceModemMessaging *_self,
                         MMSmsStorage storage,
@@ -8272,6 +8357,15 @@ load_initial_sms_parts (MMIfaceModemMessaging *_self,
     GTask *task;
     QmiClient *client = NULL;
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        /* b2q-imsd's inbox holds what arrived while ModemManager was not listening. */
+        task = g_task_new (self, NULL, callback, user_data);
+        mm_ims_backend_b2q_load_initial_sms (MM_IMS_BACKEND_B2Q (self->priv->b2q_ims_backend),
+                                             (GAsyncReadyCallback) b2q_load_initial_sms_ready,
+                                             task);
+        return;
+    }
+
     /* Handle AT URC only fallback */
     if (self->priv->messaging_fallback_at_only) {
         return iface_modem_messaging_parent->load_initial_sms_parts (_self, storage, callback, user_data);
@@ -8483,6 +8577,9 @@ common_setup_cleanup_messaging_unsolicited_events (MMBroadbandModemQmi  *self,
 {
     QmiClient *client = NULL;
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self))
+        return TRUE;
+
     client = mm_shared_qmi_peek_client (MM_SHARED_QMI (self),
                                         QMI_SERVICE_WMS,
                                         MM_PORT_QMI_FLAG_DEFAULT,
@@ -8692,6 +8789,12 @@ common_enable_disable_messaging_unsolicited_events (MMBroadbandModemQmi *self,
     QmiMessageWmsSetEventReportInput *input;
     GError *error = NULL;
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
     client = mm_shared_qmi_peek_client (MM_SHARED_QMI (self),
                                         QMI_SERVICE_WMS, MM_PORT_QMI_FLAG_DEFAULT, &error);
     if (!client) {
@@ -8844,6 +8947,10 @@ messaging_create_sms (MMIfaceModemMessaging *_self)
 {
     MMBroadbandModemQmi *self = MM_BROADBAND_MODEM_QMI (_self);
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        return mm_sms_ims_new (MM_BASE_MODEM (self));
+    }
+
     /* Handle AT URC only fallback */
     if (self->priv->messaging_fallback_at_only) {
         return iface_modem_messaging_parent->create_sms (_self);
@@ -10548,6 +10655,17 @@ modem_voice_check_support (MMIfaceModemVoice   *self,
 
     task = g_task_new (self, NULL, callback, user_data);
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (MM_BROADBAND_MODEM_QMI (self))) {
+        g_object_set (self,
+                      MM_IFACE_MODEM_VOICE_PERIODIC_CALL_LIST_CHECK_DISABLED, TRUE,
+                      MM_IFACE_MODEM_VOICE_INDICATION_CALL_LIST_RELOAD_ENABLED, FALSE,
+                      NULL);
+        mm_obj_dbg (self, "Voice capabilities supported via b2q IMS");
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
     /* If we have support for the Voice client, Voice is supported */
     if (!mm_shared_qmi_peek_client (MM_SHARED_QMI (self),
                                     QMI_SERVICE_VOICE,
@@ -10765,6 +10883,13 @@ common_voice_setup_cleanup_unsolicited_events (MMBroadbandModemQmi *self,
     GTask     *task;
     QmiClient *client = NULL;
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        task = g_task_new (self, NULL, callback, user_data);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
     if (!mm_shared_qmi_ensure_client (MM_SHARED_QMI (self),
                                       QMI_SERVICE_VOICE, &client,
                                       callback, user_data))
@@ -10876,6 +11001,13 @@ common_voice_enable_disable_unsolicited_events (MMBroadbandModemQmi *self,
     GTask     *task;
     QmiClient *client;
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        task = g_task_new (self, NULL, callback, user_data);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
     if (!mm_shared_qmi_ensure_client (MM_SHARED_QMI (self),
                                       QMI_SERVICE_VOICE, &client,
                                       callback, user_data))
@@ -10939,6 +11071,13 @@ common_voice_setup_in_call_cleanup_unsolicited_events (MMBroadbandModemQmi *self
     GTask     *task;
     QmiClient *client = NULL;
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (self)) {
+        task = g_task_new (self, NULL, callback, user_data);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
     if (!mm_shared_qmi_ensure_client (MM_SHARED_QMI (self),
                                       QMI_SERVICE_VOICE, &client,
                                       callback, user_data))
@@ -11148,6 +11287,16 @@ modem_voice_load_call_list (MMIfaceModemVoice   *self,
     QmiClient *client = NULL;
     GTask *task;
 
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (MM_BROADBAND_MODEM_QMI (self))) {
+        MMImsBackendB2q *backend = mm_broadband_modem_qmi_peek_ims_backend (MM_BROADBAND_MODEM_QMI (self));
+        GList *call_list = backend ? mm_ims_backend_b2q_get_call_list (backend) : NULL;
+
+        task = g_task_new (self, NULL, callback, user_data);
+        g_task_return_pointer (task, call_list, (GDestroyNotify) mm_3gpp_call_info_list_free);
+        g_object_unref (task);
+        return;
+    }
+
     if (!mm_shared_qmi_ensure_client (MM_SHARED_QMI (self),
                                       QMI_SERVICE_VOICE, &client,
                                       callback, user_data))
@@ -11172,6 +11321,12 @@ modem_voice_create_call (MMIfaceModemVoice *self,
                          MMCallDirection    direction,
                          const gchar       *number)
 {
+    if (mm_broadband_modem_qmi_is_b2q_ims_enabled (MM_BROADBAND_MODEM_QMI (self))) {
+        return mm_call_ims_new (MM_BASE_MODEM (self),
+                                direction,
+                                number);
+    }
+
     return mm_call_qmi_new (MM_BASE_MODEM (self),
                             direction,
                             number);
@@ -13995,6 +14150,7 @@ dispose (GObject *object)
     self->priv->firmware_list = NULL;
 
     g_clear_object (&self->priv->current_firmware);
+    g_clear_object (&self->priv->b2q_ims_backend);
 
     G_OBJECT_CLASS (mm_broadband_modem_qmi_parent_class)->dispose (object);
 }
