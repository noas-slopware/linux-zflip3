diff --git a/src/mm-call-ims.c b/src/mm-call-ims.c
new file mode 100644
index 0000000..f42c9b7
--- /dev/null
+++ b/src/mm-call-ims.c
@@ -0,0 +1,245 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Copyright (C) 2026 Noa Himesaka <himesaka@noa.codes>
