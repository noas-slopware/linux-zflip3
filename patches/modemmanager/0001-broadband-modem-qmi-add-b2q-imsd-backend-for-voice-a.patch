diff --git a/src/mm-sms-ims.c b/src/mm-sms-ims.c
new file mode 100644
index 0000000..d250c26
--- /dev/null
+++ b/src/mm-sms-ims.c
@@ -0,0 +1,169 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Copyright (C) 2026 Noa Himesaka <himesaka@noa.codes>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include "mm-sms-ims.h"
+#include "mm-ims-backend-b2q.h"
+#include "mm-broadband-modem-qmi.h"
+#include "mm-log-object.h"
+#include "mm-errors-types.h"
+
+G_DEFINE_TYPE (MMSmsIms, mm_sms_ims, MM_TYPE_BASE_SMS)
+
+/*****************************************************************************/
+/* Send SMS */
+
+static gboolean
+sms_send_finish (MMBaseSms     *self,
+                 GAsyncResult  *res,
+                 GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+send_sms_ready (MMImsBackendB2q *backend,
+                GAsyncResult    *res,
+                GTask           *task)
+{
+    MMBaseSms *self;
+    GError    *error = NULL;
+    gchar     *ref = NULL;
+
+    self = MM_BASE_SMS (g_task_get_source_object (task));
+
+    if (!mm_ims_backend_b2q_send_sms_finish (backend, res, &ref, &error)) {
+        g_task_return_error (task, error);
+    } else {
+        GList *parts;
+
+        /* Set message reference on first part if available */
+        parts = mm_base_sms_get_parts (self);
+        if (parts && parts->data) {
+            guint msg_ref = (guint) g_ascii_strtoull (ref ? ref : "0", NULL, 10);
+            mm_sms_part_set_message_reference ((MMSmsPart *)parts->data, msg_ref);
+        }
+        g_free (ref);
+        g_task_return_boolean (task, TRUE);
+    }
+    g_object_unref (task);
+}
+
+static void
+sms_send (MMBaseSms           *self,
+          GAsyncReadyCallback  callback,
+          gpointer             user_data)
+{
+    MMBroadbandModemQmi *modem = NULL;
+    MMImsBackendB2q     *backend = NULL;
+    GTask               *task;
+    const gchar         *number;
+    const gchar         *text;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    g_object_get (self, MM_BASE_SMS_MODEM, &modem, NULL);
+    if (!modem) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No modem associated with this SMS");
+        g_object_unref (task);
+        return;
+    }
+
+    backend = mm_broadband_modem_qmi_peek_ims_backend (modem);
+    if (!backend || !mm_ims_backend_b2q_is_available (backend)) {
+        g_object_unref (modem);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
+                                 "IMS backend is not available");
+        g_object_unref (task);
+        return;
+    }
+
+    number = mm_gdbus_sms_get_number (MM_GDBUS_SMS (self));
+    text = mm_gdbus_sms_get_text (MM_GDBUS_SMS (self));
+
+    if (!number || !text) {
+        GList *parts = mm_base_sms_get_parts (self);
+        if (parts && parts->data) {
+            if (!number)
+                number = mm_sms_part_get_number ((MMSmsPart *)parts->data);
+            if (!text)
+                text = mm_sms_part_get_text ((MMSmsPart *)parts->data);
+        }
+    }
+
+    if (!number || !text) {
+        g_object_unref (modem);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                 "Cannot send SMS: number or text is missing");
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "sending IMS SMS to %s", number);
+
+    mm_ims_backend_b2q_send_sms (backend,
+                                 number,
+                                 text,
+                                 NULL,
+                                 (GAsyncReadyCallback) send_sms_ready,
+                                 task);
+    g_object_unref (modem);
+}
+
+/*****************************************************************************/
+/* Delete SMS */
+
+static gboolean
+sms_delete_finish (MMBaseSms     *self,
+                   GAsyncResult  *res,
+                   GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+sms_delete (MMBaseSms           *self,
+            GAsyncReadyCallback  callback,
+            gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+
+MMBaseSms *
+mm_sms_ims_new (MMBaseModem *modem)
+{
+    return MM_BASE_SMS (g_object_new (MM_TYPE_SMS_IMS,
+                                      MM_BASE_SMS_MODEM, modem,
+                                      NULL));
+}
+
+static void
+mm_sms_ims_init (MMSmsIms *self)
+{
+}
+
+static void
+mm_sms_ims_class_init (MMSmsImsClass *klass)
+{
+    MMBaseSmsClass *base_sms_class = MM_BASE_SMS_CLASS (klass);
+
+    base_sms_class->send = sms_send;
+    base_sms_class->send_finish = sms_send_finish;
+    base_sms_class->delete = sms_delete;
+    base_sms_class->delete_finish = sms_delete_finish;
+}
