diff --git a/src/mm-ims-backend-b2q.c b/src/mm-ims-backend-b2q.c
new file mode 100644
index 0000000..f58dc26
--- /dev/null
+++ b/src/mm-ims-backend-b2q.c
@@ -0,0 +1,781 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Copyright (C) 2026 Noa Himesaka <himesaka@noa.codes>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include "mm-ims-backend-b2q.h"
+#include "mm-log-object.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-iface-modem-messaging.h"
+#include "mm-sms-part.h"
+#include "mm-sms-part-3gpp.h"
+#include "mm-modem-helpers.h"
+
+G_DEFINE_TYPE (MMImsBackendB2q, mm_ims_backend_b2q, G_TYPE_OBJECT)
+
+struct _MMImsBackendB2qPrivate {
+    MMBroadbandModemQmi *modem;
+    GDBusConnection     *connection;
+    guint                name_watch_id;
+    guint                call_added_id;
+    guint                call_state_changed_id;
+    guint                pdu_received_id;
+    guint                reg_state_id;
+    GHashTable          *taken_pdus;   /* inbox ids already handed to messaging */
+    gboolean             messaging_ready; /* the SMS list exists (load_initial_sms_parts ran) */
+    gboolean             is_available;
+    gint                 reg_state;
+    guint32              call_id;
+    gchar               *call_number;
+    MMCallDirection      call_direction;
+    MMCallState          call_state;
+};
+
+static MMCallState
+map_imsd_call_state (gint state)
+{
+    switch (state) {
+    case 1:
+        return MM_CALL_STATE_DIALING;
+    case 2:
+        return MM_CALL_STATE_RINGING_OUT;
+    case 3:
+        return MM_CALL_STATE_RINGING_IN;
+    case 4:
+        return MM_CALL_STATE_ACTIVE;
+    case 5:
+        return MM_CALL_STATE_HELD;
+    case 6:
+    case 7:
+        return MM_CALL_STATE_TERMINATED;
+    default:
+        return MM_CALL_STATE_UNKNOWN;
+    }
+}
+
+static void
+on_call_added (GDBusConnection *connection,
+               const gchar     *sender_name,
+               const gchar     *object_path,
+               const gchar     *interface_name,
+               const gchar     *signal_name,
+               GVariant        *parameters,
+               gpointer         user_data)
+{
+    MMImsBackendB2q *self = MM_IMS_BACKEND_B2Q (user_data);
+    guint32 call_id = 0;
+    const gchar *number = NULL;
+    gint32 direction = 0;
+
+    if (!self->priv->modem)
+        return;
+
+    g_variant_get (parameters, "(u&si)", &call_id, &number, &direction);
+    self->priv->call_id = call_id;
+    g_clear_pointer (&self->priv->call_number, g_free);
+    self->priv->call_number = g_strdup (number);
+    self->priv->call_direction = (direction == 1) ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+    self->priv->call_state = (direction == 1) ? MM_CALL_STATE_RINGING_IN : MM_CALL_STATE_DIALING;
+    mm_obj_dbg (self->priv->modem, "b2q-ims: CallAdded signal (id %u, number %s, dir %d)",
+                call_id, number ? number : "", direction);
+
+    if (direction == 1) {
+        MMCallInfo info;
+
+        memset (&info, 0, sizeof (info));
+        info.index = call_id;
+        info.direction = MM_CALL_DIRECTION_INCOMING;
+        info.state = MM_CALL_STATE_RINGING_IN;
+        info.number = (gchar *)number;
+        mm_iface_modem_voice_report_call (MM_IFACE_MODEM_VOICE (self->priv->modem), &info);
+    }
+}
+
+static void
+on_call_state_changed (GDBusConnection *connection,
+                       const gchar     *sender_name,
+                       const gchar     *object_path,
+                       const gchar     *interface_name,
+                       const gchar     *signal_name,
+                       GVariant        *parameters,
+                       gpointer         user_data)
+{
+    MMImsBackendB2q *self = MM_IMS_BACKEND_B2Q (user_data);
+    guint32 call_id = 0;
+    gint32 state = 0;
+    gint32 reason = 0;
+    MMCallInfo info;
+
+    if (!self->priv->modem)
+        return;
+
+    g_variant_get (parameters, "(uii)", &call_id, &state, &reason);
+    if (call_id == self->priv->call_id)
+        self->priv->call_state = map_imsd_call_state (state);
+    mm_obj_dbg (self->priv->modem, "b2q-ims: CallStateChanged signal (id %u, state %d, reason %d)",
+                call_id, state, reason);
+
+    memset (&info, 0, sizeof (info));
+    info.index = call_id;
+    info.direction = MM_CALL_DIRECTION_UNKNOWN;
+    info.state = map_imsd_call_state (state);
+    info.number = NULL;
+
+    mm_iface_modem_voice_report_call (MM_IFACE_MODEM_VOICE (self->priv->modem), &info);
+}
+
+static void
+ack_pdu_ready (GDBusConnection *connection,
+               GAsyncResult    *res,
+               MMImsBackendB2q *self)
+{
+    g_autoptr(GVariant) ret = NULL;
+    g_autoptr(GError)   error = NULL;
+
+    ret = g_dbus_connection_call_finish (connection, res, &error);
+    if (!ret && self->priv->modem)
+        mm_obj_warn (self->priv->modem, "b2q-ims: AckPdu failed: %s", error->message);
+    g_object_unref (self);
+}
+
+/*
+ * Hand one inbox entry to the messaging interface, then tell b2q-imsd it can
+ * drop it. Live PduReceived signals and the GetPendingPdus backlog both land
+ * here; an id already taken in this ModemManager run is only acked again.
+ *
+ * An entry is acked only once ModemManager holds it: take_part() refuses
+ * (and frees) parts while the SMS list does not exist yet, early in modem
+ * initialization. Such an entry stays in the inbox and is fetched again from
+ * load_initial_sms_parts. One that can never be parsed is acked so it is not
+ * handed over forever.
+ */
+static void
+take_pdu (MMImsBackendB2q *self,
+          const gchar     *id,
+          const gchar     *hexpdu)
+{
+    g_autoptr(GError) error = NULL;
+    MMSmsPart        *part;
+
+    if (!self->priv->modem || !self->priv->connection)
+        return;
+
+    if (!g_hash_table_contains (self->priv->taken_pdus, id)) {
+        mm_obj_info (self->priv->modem, "b2q-ims: MT-SMS %s (%" G_GSIZE_FORMAT " PDU bytes)",
+                     id, strlen (hexpdu) / 2);
+        part = mm_sms_part_3gpp_new_from_pdu (SMS_PART_INVALID_INDEX, hexpdu,
+                                              self->priv->modem, &error);
+        if (!part) {
+            mm_obj_warn (self->priv->modem, "b2q-ims: couldn't parse 3GPP PDU %s (%s): %s",
+                         id, hexpdu, error->message);
+        } else if (!mm_iface_modem_messaging_take_part (MM_IFACE_MODEM_MESSAGING (self->priv->modem),
+                                                       part,
+                                                       MM_SMS_STATE_RECEIVED,
+                                                       MM_SMS_STORAGE_UNKNOWN)) {
+            mm_obj_info (self->priv->modem,
+                         "b2q-ims: messaging not ready, MT-SMS %s stays in the b2q-imsd inbox", id);
+            return;
+        }
+        g_hash_table_add (self->priv->taken_pdus, g_strdup (id));
+    }
+
+    g_dbus_connection_call (self->priv->connection,
+                            "org.b2q.Imsd",
+                            "/org/b2q/Imsd",
+                            "org.b2q.Imsd",
+                            "AckPdu",
+                            g_variant_new ("(s)", id),
+                            NULL,
+                            G_DBUS_CALL_FLAGS_NONE,
+                            -1,
+                            NULL,
+                            (GAsyncReadyCallback) ack_pdu_ready,
+                            g_object_ref (self));
+}
+
+static void
+on_pdu_received (GDBusConnection *connection,
+                 const gchar     *sender_name,
+                 const gchar     *object_path,
+                 const gchar     *interface_name,
+                 const gchar     *signal_name,
+                 GVariant        *parameters,
+                 gpointer         user_data)
+{
+    const gchar *id = NULL;
+    const gchar *hexpdu = NULL;
+
+    g_variant_get (parameters, "(&s&s)", &id, &hexpdu);
+    take_pdu (MM_IMS_BACKEND_B2Q (user_data), id, hexpdu);
+}
+
+static void
+get_pending_pdus_ready (GDBusConnection *connection,
+                        GAsyncResult    *res,
+                        GTask           *task)
+{
+    MMImsBackendB2q        *self = g_task_get_source_object (task);
+    g_autoptr(GVariant)     ret = NULL;
+    g_autoptr(GVariantIter) iter = NULL;
+    g_autoptr(GError)       error = NULL;
+    const gchar            *id;
+    const gchar            *hexpdu;
+
+    ret = g_dbus_connection_call_finish (connection, res, &error);
+    if (!ret) {
+        /* Not fatal for messaging: the entries stay in the inbox. */
+        if (self->priv->modem)
+            mm_obj_warn (self->priv->modem, "b2q-ims: GetPendingPdus failed: %s", error->message);
+    } else {
+        g_variant_get (ret, "(a(ss))", &iter);
+        if (self->priv->modem && g_variant_iter_n_children (iter) > 0)
+            mm_obj_info (self->priv->modem, "b2q-ims: %" G_GSIZE_FORMAT " pending MT-SMS in the inbox",
+                         g_variant_iter_n_children (iter));
+        while (g_variant_iter_loop (iter, "(&s&s)", &id, &hexpdu))
+            take_pdu (self, id, hexpdu);
+    }
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+fetch_pending_pdus (MMImsBackendB2q     *self,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    GTask *task = g_task_new (self, NULL, callback, user_data);
+
+    g_dbus_connection_call (self->priv->connection,
+                            "org.b2q.Imsd",
+                            "/org/b2q/Imsd",
+                            "org.b2q.Imsd",
+                            "GetPendingPdus",
+                            NULL,
+                            G_VARIANT_TYPE ("(a(ss))"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            -1,
+                            NULL,
+                            (GAsyncReadyCallback) get_pending_pdus_ready,
+                            task);
+}
+
+/*
+ * Called from load_initial_sms_parts, the step where ModemManager loads stored
+ * messages, once the SMS list exists: b2q-imsd's inbox is this modem's storage.
+ */
+void
+mm_ims_backend_b2q_load_initial_sms (MMImsBackendB2q     *self,
+                                     GAsyncReadyCallback  callback,
+                                     gpointer             user_data)
+{
+    self->priv->messaging_ready = TRUE;
+    if (self->priv->is_available && self->priv->connection) {
+        fetch_pending_pdus (self, callback, user_data);
+        return;
+    }
+    /* b2q-imsd not on the bus yet: on_name_appeared fetches the inbox. */
+    GTask *task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+gboolean
+mm_ims_backend_b2q_load_initial_sms_finish (MMImsBackendB2q  *self,
+                                            GAsyncResult     *res,
+                                            GError          **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+on_reg_state_changed (GDBusConnection *connection,
+                      const gchar     *sender_name,
+                      const gchar     *object_path,
+                      const gchar     *interface_name,
+                      const gchar     *signal_name,
+                      GVariant        *parameters,
+                      gpointer         user_data)
+{
+    MMImsBackendB2q *self = MM_IMS_BACKEND_B2Q (user_data);
+    gint32 state = 0;
+
+    g_variant_get (parameters, "(i)", &state);
+    self->priv->reg_state = state;
+    if (self->priv->modem) {
+        mm_obj_info (self->priv->modem, "b2q-ims: registration state changed to %d (%s)",
+                     state, state == 2 ? "registered" : (state == 1 ? "registering" : "down"));
+    }
+}
+
+static void
+subscribe_signals (MMImsBackendB2q *self)
+{
+    if (!self->priv->connection)
+        return;
+
+    if (self->priv->call_added_id == 0) {
+        self->priv->call_added_id = g_dbus_connection_signal_subscribe (
+            self->priv->connection,
+            "org.b2q.Imsd",
+            "org.b2q.Imsd",
+            "CallAdded",
+            "/org/b2q/Imsd",
+            NULL,
+            G_DBUS_SIGNAL_FLAGS_NONE,
+            on_call_added,
+            self,
+            NULL);
+    }
+
+    if (self->priv->call_state_changed_id == 0) {
+        self->priv->call_state_changed_id = g_dbus_connection_signal_subscribe (
+            self->priv->connection,
+            "org.b2q.Imsd",
+            "org.b2q.Imsd",
+            "CallStateChanged",
+            "/org/b2q/Imsd",
+            NULL,
+            G_DBUS_SIGNAL_FLAGS_NONE,
+            on_call_state_changed,
+            self,
+            NULL);
+    }
+
+    if (self->priv->pdu_received_id == 0) {
+        self->priv->pdu_received_id = g_dbus_connection_signal_subscribe (
+            self->priv->connection,
+            "org.b2q.Imsd",
+            "org.b2q.Imsd",
+            "PduReceived",
+            "/org/b2q/Imsd",
+            NULL,
+            G_DBUS_SIGNAL_FLAGS_NONE,
+            on_pdu_received,
+            self,
+            NULL);
+    }
+    if (self->priv->reg_state_id == 0) {
+        self->priv->reg_state_id = g_dbus_connection_signal_subscribe (
+            self->priv->connection,
+            "org.b2q.Imsd",
+            "org.b2q.Imsd",
+            "RegistrationStateChanged",
+            "/org/b2q/Imsd",
+            NULL,
+            G_DBUS_SIGNAL_FLAGS_NONE,
+            on_reg_state_changed,
+            self,
+            NULL);
+    }
+}
+
+static void
+unsubscribe_signals (MMImsBackendB2q *self)
+{
+    if (!self->priv->connection)
+        return;
+
+    if (self->priv->call_added_id != 0) {
+        g_dbus_connection_signal_unsubscribe (self->priv->connection, self->priv->call_added_id);
+        self->priv->call_added_id = 0;
+    }
+    if (self->priv->call_state_changed_id != 0) {
+        g_dbus_connection_signal_unsubscribe (self->priv->connection, self->priv->call_state_changed_id);
+        self->priv->call_state_changed_id = 0;
+    }
+    if (self->priv->pdu_received_id != 0) {
+        g_dbus_connection_signal_unsubscribe (self->priv->connection, self->priv->pdu_received_id);
+        self->priv->pdu_received_id = 0;
+    }
+    if (self->priv->reg_state_id != 0) {
+        g_dbus_connection_signal_unsubscribe (self->priv->connection, self->priv->reg_state_id);
+        self->priv->reg_state_id = 0;
+    }
+}
+
+static void
+on_name_appeared (GDBusConnection *connection,
+                  const gchar     *name,
+                  const gchar     *name_owner,
+                  gpointer         user_data)
+{
+    MMImsBackendB2q *self = MM_IMS_BACKEND_B2Q (user_data);
+
+    if (self->priv->modem)
+        mm_obj_info (self->priv->modem, "b2q-ims: %s appeared on system bus (owner %s)", name, name_owner);
+    self->priv->is_available = TRUE;
+    subscribe_signals (self);
+
+    /*
+     * Messages b2q-imsd stored while nobody was listening. Before messaging
+     * is enabled there is no SMS list to put them in; load_initial_sms_parts
+     * fetches them then.
+     */
+    if (self->priv->messaging_ready)
+        fetch_pending_pdus (self, NULL, NULL);
+}
+
+static void
+on_name_vanished (GDBusConnection *connection,
+                  const gchar     *name,
+                  gpointer         user_data)
+{
+    MMImsBackendB2q *self = MM_IMS_BACKEND_B2Q (user_data);
+
+    if (self->priv->modem)
+        mm_obj_warn (self->priv->modem, "b2q-ims: %s vanished from system bus", name);
+    self->priv->is_available = FALSE;
+    unsubscribe_signals (self);
+}
+
+gboolean
+mm_ims_backend_b2q_is_available (MMImsBackendB2q *self)
+{
+    g_return_val_if_fail (MM_IS_IMS_BACKEND_B2Q (self), FALSE);
+    return self->priv->is_available;
+}
+
+/*****************************************************************************/
+/* Call methods */
+
+static void
+dbus_create_call_ready (GDBusConnection *connection,
+                        GAsyncResult    *res,
+                        GTask           *task)
+{
+    GError *error = NULL;
+    g_autoptr(GVariant) reply = NULL;
+
+    reply = g_dbus_connection_call_finish (connection, res, &error);
+    if (!reply) {
+        g_task_return_error (task, error);
+    } else {
+        guint32 call_id = 0;
+        g_variant_get (reply, "(u)", &call_id);
+        g_task_return_int (task, (gssize)call_id);
+    }
+    g_object_unref (task);
+}
+
+void
+mm_ims_backend_b2q_create_call (MMImsBackendB2q    *self,
+                                const gchar        *number,
+                                GCancellable       *cancellable,
+                                GAsyncReadyCallback callback,
+                                gpointer            user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    if (!self->priv->is_available || !self->priv->connection) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "b2q-imsd is not available");
+        g_object_unref (task);
+        return;
+    }
+
+    g_dbus_connection_call (self->priv->connection,
+                            "org.b2q.Imsd",
+                            "/org/b2q/Imsd",
+                            "org.b2q.Imsd",
+                            "CreateCall",
+                            g_variant_new ("(s)", number ? number : ""),
+                            G_VARIANT_TYPE ("(u)"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            15000,
+                            cancellable,
+                            (GAsyncReadyCallback) dbus_create_call_ready,
+                            task);
+}
+
+gboolean
+mm_ims_backend_b2q_create_call_finish (MMImsBackendB2q  *self,
+                                       GAsyncResult     *res,
+                                       guint32          *out_call_id,
+                                       GError          **error)
+{
+    gssize val;
+
+    val = g_task_propagate_int (G_TASK (res), error);
+    if (val < 0)
+        return FALSE;
+    if (out_call_id)
+        *out_call_id = (guint32)val;
+    return TRUE;
+}
+
+static void
+dbus_answer_call_ready (GDBusConnection *connection,
+                        GAsyncResult    *res,
+                        GTask           *task)
+{
+    GError *error = NULL;
+    g_autoptr(GVariant) reply = NULL;
+
+    reply = g_dbus_connection_call_finish (connection, res, &error);
+    if (!reply)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+void
+mm_ims_backend_b2q_answer_call (MMImsBackendB2q    *self,
+                                guint32             call_id,
+                                GCancellable       *cancellable,
+                                GAsyncReadyCallback callback,
+                                gpointer            user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    if (!self->priv->is_available || !self->priv->connection) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "b2q-imsd is not available");
+        g_object_unref (task);
+        return;
+    }
+
+    g_dbus_connection_call (self->priv->connection,
+                            "org.b2q.Imsd",
+                            "/org/b2q/Imsd",
+                            "org.b2q.Imsd",
+                            "AnswerCall",
+                            g_variant_new ("(u)", call_id),
+                            G_VARIANT_TYPE ("()"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            10000,
+                            cancellable,
+                            (GAsyncReadyCallback) dbus_answer_call_ready,
+                            task);
+}
+
+gboolean
+mm_ims_backend_b2q_answer_call_finish (MMImsBackendB2q  *self,
+                                       GAsyncResult     *res,
+                                       GError          **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+dbus_hangup_call_ready (GDBusConnection *connection,
+                        GAsyncResult    *res,
+                        GTask           *task)
+{
+    GError *error = NULL;
+    g_autoptr(GVariant) reply = NULL;
+
+    reply = g_dbus_connection_call_finish (connection, res, &error);
+    if (!reply)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+void
+mm_ims_backend_b2q_hangup_call (MMImsBackendB2q    *self,
+                                guint32             call_id,
+                                GCancellable       *cancellable,
+                                GAsyncReadyCallback callback,
+                                gpointer            user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    if (!self->priv->is_available || !self->priv->connection) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+
+    g_dbus_connection_call (self->priv->connection,
+                            "org.b2q.Imsd",
+                            "/org/b2q/Imsd",
+                            "org.b2q.Imsd",
+                            "HangupCall",
+                            g_variant_new ("(u)", call_id),
+                            G_VARIANT_TYPE ("()"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            10000,
+                            cancellable,
+                            (GAsyncReadyCallback) dbus_hangup_call_ready,
+                            task);
+}
+
+gboolean
+mm_ims_backend_b2q_hangup_call_finish (MMImsBackendB2q  *self,
+                                       GAsyncResult     *res,
+                                       GError          **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+/*****************************************************************************/
+/* SMS methods */
+
+static void
+dbus_send_sms_ready (GDBusConnection *connection,
+                     GAsyncResult    *res,
+                     GTask           *task)
+{
+    GError *error = NULL;
+    g_autoptr(GVariant) reply = NULL;
+
+    reply = g_dbus_connection_call_finish (connection, res, &error);
+    if (!reply) {
+        g_task_return_error (task, error);
+    } else {
+        const gchar *ref = NULL;
+        g_variant_get (reply, "(&s)", &ref);
+        g_task_return_pointer (task, g_strdup (ref), g_free);
+    }
+    g_object_unref (task);
+}
+
+void
+mm_ims_backend_b2q_send_sms (MMImsBackendB2q    *self,
+                             const gchar        *number,
+                             const gchar        *text,
+                             GCancellable       *cancellable,
+                             GAsyncReadyCallback callback,
+                             gpointer            user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    if (!self->priv->is_available || !self->priv->connection) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "b2q-imsd is not available");
+        g_object_unref (task);
+        return;
+    }
+
+    g_dbus_connection_call (self->priv->connection,
+                            "org.b2q.Imsd",
+                            "/org/b2q/Imsd",
+                            "org.b2q.Imsd",
+                            "SendSms",
+                            g_variant_new ("(ss)", number ? number : "", text ? text : ""),
+                            G_VARIANT_TYPE ("(s)"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            30000,
+                            cancellable,
+                            (GAsyncReadyCallback) dbus_send_sms_ready,
+                            task);
+}
+
+gboolean
+mm_ims_backend_b2q_send_sms_finish (MMImsBackendB2q  *self,
+                                    GAsyncResult     *res,
+                                    gchar           **out_ref,
+                                    GError          **error)
+{
+    gchar *ref;
+
+    ref = g_task_propagate_pointer (G_TASK (res), error);
+    if (!ref)
+        return FALSE;
+    if (out_ref)
+        *out_ref = ref;
+    else
+        g_free (ref);
+    return TRUE;
+}
+
+/*****************************************************************************/
+
+GList *
+mm_ims_backend_b2q_get_call_list (MMImsBackendB2q *self)
+{
+    MMCallInfo *info;
+
+    if (!self->priv->call_id || self->priv->call_state == MM_CALL_STATE_UNKNOWN)
+        return NULL;
+
+    info = g_new0 (MMCallInfo, 1);
+    info->index = self->priv->call_id;
+    info->direction = self->priv->call_direction;
+    info->state = self->priv->call_state;
+    info->number = g_strdup (self->priv->call_number);
+    return g_list_append (NULL, info);
+}
+
+/*****************************************************************************/
+
+MMImsBackendB2q *
+mm_ims_backend_b2q_new (MMBroadbandModemQmi *modem)
+{
+    MMImsBackendB2q *self;
+    GDBusConnection *conn = NULL;
+
+    self = g_object_new (MM_TYPE_IMS_BACKEND_B2Q, NULL);
+    self->priv->modem = modem;
+
+    g_object_get (modem, MM_BASE_MODEM_CONNECTION, &conn, NULL);
+    if (!conn)
+        conn = g_bus_get_sync (G_BUS_TYPE_SYSTEM, NULL, NULL);
+
+    self->priv->connection = conn;
+    if (self->priv->connection) {
+        self->priv->name_watch_id = g_bus_watch_name_on_connection (
+            self->priv->connection,
+            "org.b2q.Imsd",
+            G_BUS_NAME_WATCHER_FLAGS_NONE,
+            on_name_appeared,
+            on_name_vanished,
+            self,
+            NULL);
+    }
+
+    return self;
+}
+
+static void
+mm_ims_backend_b2q_init (MMImsBackendB2q *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self, MM_TYPE_IMS_BACKEND_B2Q, MMImsBackendB2qPrivate);
+    self->priv->is_available = FALSE;
+    self->priv->reg_state = 0;
+    self->priv->taken_pdus = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+}
+
+static void
+dispose (GObject *object)
+{
+    MMImsBackendB2q *self = MM_IMS_BACKEND_B2Q (object);
+
+    if (self->priv->name_watch_id != 0) {
+        g_bus_unwatch_name (self->priv->name_watch_id);
+        self->priv->name_watch_id = 0;
+    }
+
+    unsubscribe_signals (self);
+
+    g_clear_object (&self->priv->connection);
+    g_clear_pointer (&self->priv->taken_pdus, g_hash_table_unref);
+    g_clear_pointer (&self->priv->call_number, g_free);
+    self->priv->modem = NULL;
+
+    G_OBJECT_CLASS (mm_ims_backend_b2q_parent_class)->dispose (object);
+}
+
+static void
+mm_ims_backend_b2q_class_init (MMImsBackendB2qClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    g_type_class_add_private (object_class, sizeof (MMImsBackendB2qPrivate));
+    object_class->dispose = dispose;
+}
