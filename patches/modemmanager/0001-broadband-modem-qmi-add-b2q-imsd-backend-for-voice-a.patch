+#include "config.h"
+
+#include "mm-call-ims.h"
+#include "mm-ims-backend-b2q.h"
+#include "mm-broadband-modem-qmi.h"
+#include "mm-log-object.h"
+#include "mm-errors-types.h"
+
+G_DEFINE_TYPE (MMCallIms, mm_call_ims, MM_TYPE_BASE_CALL)
+
+/*****************************************************************************/
+/* Start the call */
+
+static gboolean
+call_start_finish (MMBaseCall    *self,
+                   GAsyncResult  *res,
+                   GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+create_call_ready (MMImsBackendB2q *backend,
+                   GAsyncResult    *res,
+                   GTask           *task)
+{
+    MMBaseCall *self;
+    GError     *error = NULL;
+    guint32     call_id = 0;
+
+    self = MM_BASE_CALL (g_task_get_source_object (task));
+
+    if (!mm_ims_backend_b2q_create_call_finish (backend, res, &call_id, &error)) {
+        g_task_return_error (task, error);
+    } else {
+        mm_base_call_set_index (self, call_id);
+        g_task_return_boolean (task, TRUE);
+    }
+    g_object_unref (task);
+}
+
+static void
+call_start (MMBaseCall          *self,
+            GCancellable        *cancellable,
+            GAsyncReadyCallback  callback,
+            gpointer             user_data)
+{
+    MMBroadbandModemQmi *modem = NULL;
+    MMImsBackendB2q     *backend = NULL;
+    GTask               *task;
+    const gchar         *number;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+
+    g_object_get (self, MM_BASE_CALL_MODEM, &modem, NULL);
+    if (!modem) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No modem associated with this call");
+        g_object_unref (task);
+        return;
+    }
+
+    backend = mm_broadband_modem_qmi_peek_ims_backend (modem);
+    if (!backend || !mm_ims_backend_b2q_is_available (backend)) {
+        g_object_unref (modem);
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
+                                 "IMS backend is not available");
+        g_object_unref (task);
+        return;
+    }
+
+    number = mm_gdbus_call_get_number (MM_GDBUS_CALL (self));
+    mm_obj_dbg (self, "starting IMS call to %s", number ? number : "");
+
+    mm_ims_backend_b2q_create_call (backend,
+                                    number,
+                                    cancellable,
+                                    (GAsyncReadyCallback) create_call_ready,
+                                    task);
+    g_object_unref (modem);
+}
+
+/*****************************************************************************/
+/* Accept the call */
+
+static gboolean
+call_accept_finish (MMBaseCall    *self,
+                    GAsyncResult  *res,
+                    GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+answer_call_ready (MMImsBackendB2q *backend,
+                   GAsyncResult    *res,
+                   GTask           *task)
+{
+    GError *error = NULL;
+
+    if (!mm_ims_backend_b2q_answer_call_finish (backend, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+call_accept (MMBaseCall          *self,
+             GAsyncReadyCallback  callback,
+             gpointer             user_data)
+{
+    MMBroadbandModemQmi *modem = NULL;
+    MMImsBackendB2q     *backend = NULL;
+    GTask               *task;
+    guint                call_id;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    call_id = mm_base_call_get_index (self);
+
+    g_object_get (self, MM_BASE_CALL_MODEM, &modem, NULL);
+    if (modem) {
+        backend = mm_broadband_modem_qmi_peek_ims_backend (modem);
+        if (backend && mm_ims_backend_b2q_is_available (backend)) {
+            mm_obj_dbg (self, "accepting IMS call %u", call_id);
+            mm_ims_backend_b2q_answer_call (backend,
+                                            call_id,
+                                            NULL,
+                                            (GAsyncReadyCallback) answer_call_ready,
+                                            task);
+            g_object_unref (modem);
+            return;
+        }
+        g_object_unref (modem);
+    }
+
+    g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                             "Cannot accept call: IMS backend unavailable");
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+
+/* Hangup the call */
+
+static gboolean
+call_hangup_finish (MMBaseCall    *self,
+                    GAsyncResult  *res,
+                    GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+hangup_call_ready (MMImsBackendB2q *backend,
+                   GAsyncResult    *res,
+                   GTask           *task)
+{
+    GError *error = NULL;
+
+    if (!mm_ims_backend_b2q_hangup_call_finish (backend, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+call_hangup (MMBaseCall          *self,
+             GAsyncReadyCallback  callback,
+             gpointer             user_data)
+{
+    MMBroadbandModemQmi *modem = NULL;
+    MMImsBackendB2q     *backend = NULL;
+    GTask               *task;
+    guint                call_id;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    call_id = mm_base_call_get_index (self);
+
+    g_object_get (self, MM_BASE_CALL_MODEM, &modem, NULL);
+    if (modem) {
+        backend = mm_broadband_modem_qmi_peek_ims_backend (modem);
+        if (backend && mm_ims_backend_b2q_is_available (backend)) {
+            mm_obj_dbg (self, "hanging up IMS call %u", call_id);
+            mm_ims_backend_b2q_hangup_call (backend,
+                                            call_id,
+                                            NULL,
+                                            (GAsyncReadyCallback) hangup_call_ready,
+                                            task);
+            g_object_unref (modem);
+            return;
+        }
+        g_object_unref (modem);
+    }
+
+    /* Backend unavailable, complete hangup locally */
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+
+MMBaseCall *
+mm_call_ims_new (MMBaseModem     *modem,
+                 MMCallDirection  direction,
+                 const gchar     *number)
+{
+    return MM_BASE_CALL (g_object_new (MM_TYPE_CALL_IMS,
+                                       MM_BASE_CALL_MODEM,                       modem,
+                                       "direction",                              direction,
+                                       "number",                                 number,
+                                       MM_BASE_CALL_SKIP_INCOMING_TIMEOUT,       TRUE,
+                                       MM_BASE_CALL_SUPPORTS_DIALING_TO_RINGING, TRUE,
+                                       MM_BASE_CALL_SUPPORTS_RINGING_TO_ACTIVE,  TRUE,
+                                       NULL));
+}
+
+static void
+mm_call_ims_init (MMCallIms *self)
+{
+}
+
+static void
+mm_call_ims_class_init (MMCallImsClass *klass)
+{
+    MMBaseCallClass *base_call_class = MM_BASE_CALL_CLASS (klass);
+
+    base_call_class->start = call_start;
+    base_call_class->start_finish = call_start_finish;
+    base_call_class->accept = call_accept;
+    base_call_class->accept_finish = call_accept_finish;
+    base_call_class->hangup = call_hangup;
+    base_call_class->hangup_finish = call_hangup_finish;
+}
