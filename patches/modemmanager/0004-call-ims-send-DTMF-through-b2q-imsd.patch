From c0db057852025f2f9bfd0f0869b428846d48a830 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Tue, 10 Nov 2026 11:25:57 +0900
Subject: [PATCH] call-ims: send DTMF through b2q-imsd

MMCallIms implemented start, accept and hangup but no send_dtmf, so
every Call.SendDtmf on an IMS call failed with "Sending dtmf is not
supported by this modem" before reaching the IMS daemon.

Forward the digits to org.b2q.Imsd.SendDtmf with the call's index.
b2q-imsd queues them and sends RFC 4733 telephone-event packets on the
call's RTP stream, at the clock of the speech codec in use, and refuses
when the far end did not negotiate telephone-event for that clock.
---
 src/mm-call-ims.c        | 63 ++++++++++++++++++++++++++++++++++++++++
 src/mm-ims-backend-b2q.c | 60 ++++++++++++++++++++++++++++++++++++++
 src/mm-ims-backend-b2q.h | 10 +++++++
 3 files changed, 133 insertions(+)

diff --git a/src/mm-call-ims.c b/src/mm-call-ims.c
index f42c9b7..f35d7a5 100644
--- a/src/mm-call-ims.c
+++ b/src/mm-call-ims.c
@@ -209,6 +209,67 @@ call_hangup (MMBaseCall          *self,
     g_object_unref (task);
 }
 
+/*****************************************************************************/
+/* Send DTMF */
+
+static gboolean
+call_send_dtmf_finish (MMBaseCall    *self,
+                       GAsyncResult  *res,
+                       GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+send_dtmf_ready (MMImsBackendB2q *backend,
+                 GAsyncResult    *res,
+                 GTask           *task)
+{
+    GError *error = NULL;
+
+    if (!mm_ims_backend_b2q_send_dtmf_finish (backend, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+call_send_dtmf (MMBaseCall          *self,
+                const gchar         *dtmf,
+                GAsyncReadyCallback  callback,
+                gpointer             user_data)
+{
+    MMBroadbandModemQmi *modem = NULL;
+    MMImsBackendB2q     *backend = NULL;
+    GTask               *task;
+    guint                call_id;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    call_id = mm_base_call_get_index (self);
+
+    g_object_get (self, MM_BASE_CALL_MODEM, &modem, NULL);
+    if (modem) {
+        backend = mm_broadband_modem_qmi_peek_ims_backend (modem);
+        if (backend && mm_ims_backend_b2q_is_available (backend)) {
+            mm_obj_dbg (self, "sending DTMF on IMS call %u", call_id);
+            mm_ims_backend_b2q_send_dtmf (backend,
+                                          call_id,
+                                          dtmf,
+                                          NULL,
+                                          (GAsyncReadyCallback) send_dtmf_ready,
+                                          task);
+            g_object_unref (modem);
+            return;
+        }
+        g_object_unref (modem);
+    }
+
+    g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                             "Cannot send DTMF: IMS backend unavailable");
+    g_object_unref (task);
+}
+
 /*****************************************************************************/
 
 MMBaseCall *
@@ -242,4 +303,6 @@ mm_call_ims_class_init (MMCallImsClass *klass)
     base_call_class->accept_finish = call_accept_finish;
     base_call_class->hangup = call_hangup;
     base_call_class->hangup_finish = call_hangup_finish;
+    base_call_class->send_dtmf = call_send_dtmf;
+    base_call_class->send_dtmf_finish = call_send_dtmf_finish;
 }
diff --git a/src/mm-ims-backend-b2q.c b/src/mm-ims-backend-b2q.c
index f58dc26..0520572 100644
--- a/src/mm-ims-backend-b2q.c
+++ b/src/mm-ims-backend-b2q.c
@@ -622,6 +622,66 @@ mm_ims_backend_b2q_hangup_call_finish (MMImsBackendB2q  *self,
     return g_task_propagate_boolean (G_TASK (res), error);
 }
 
+/*****************************************************************************/
+/* DTMF: b2q-imsd sends the digits as RFC 4733 telephone-event packets on the
+ * call's RTP stream. */
+
+static void
+dbus_send_dtmf_ready (GDBusConnection *connection,
+                      GAsyncResult    *res,
+                      GTask           *task)
+{
+    GError *error = NULL;
+    g_autoptr(GVariant) reply = NULL;
+
+    reply = g_dbus_connection_call_finish (connection, res, &error);
+    if (!reply)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+void
+mm_ims_backend_b2q_send_dtmf (MMImsBackendB2q    *self,
+                              guint32             call_id,
+                              const gchar        *dtmf,
+                              GCancellable       *cancellable,
+                              GAsyncReadyCallback callback,
+                              gpointer            user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    if (!self->priv->is_available || !self->priv->connection) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
+                                 "IMS backend is not available");
+        g_object_unref (task);
+        return;
+    }
+
+    g_dbus_connection_call (self->priv->connection,
+                            "org.b2q.Imsd",
+                            "/org/b2q/Imsd",
+                            "org.b2q.Imsd",
+                            "SendDtmf",
+                            g_variant_new ("(us)", call_id, dtmf),
+                            G_VARIANT_TYPE ("()"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            10000,
+                            cancellable,
+                            (GAsyncReadyCallback) dbus_send_dtmf_ready,
+                            task);
+}
+
+gboolean
+mm_ims_backend_b2q_send_dtmf_finish (MMImsBackendB2q  *self,
+                                     GAsyncResult     *res,
+                                     GError          **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
 /*****************************************************************************/
 /* SMS methods */
 
diff --git a/src/mm-ims-backend-b2q.h b/src/mm-ims-backend-b2q.h
index 66d046e..fddd461 100644
--- a/src/mm-ims-backend-b2q.h
+++ b/src/mm-ims-backend-b2q.h
@@ -83,6 +83,16 @@ gboolean mm_ims_backend_b2q_hangup_call_finish (MMImsBackendB2q  *self,
                                                 GAsyncResult     *res,
                                                 GError          **error);
 
+void mm_ims_backend_b2q_send_dtmf (MMImsBackendB2q    *self,
+                                   guint32             call_id,
+                                   const gchar        *dtmf,
+                                   GCancellable       *cancellable,
+                                   GAsyncReadyCallback callback,
+                                   gpointer            user_data);
+gboolean mm_ims_backend_b2q_send_dtmf_finish (MMImsBackendB2q  *self,
+                                              GAsyncResult     *res,
+                                              GError          **error);
+
 void mm_ims_backend_b2q_send_sms (MMImsBackendB2q    *self,
                                   const gchar        *number,
                                   const gchar        *text,
-- 
