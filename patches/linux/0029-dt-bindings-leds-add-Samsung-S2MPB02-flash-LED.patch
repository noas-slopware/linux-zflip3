From: Noa Himesaka <himesaka@noa.codes>
Subject: [PATCH] dt-bindings: leds: add Samsung S2MPB02 flash LED

Document the flash LED controller of the Samsung S2MPB02 PMIC as a
sub-node of the PMIC. It has a separate torch and flash current source,
each enabled by a GPIO pin or over I2C, and a programmable safety timer.

Signed-off-by: Noa Himesaka <himesaka@noa.codes>
Assisted-by: Claude:claude-opus-5-5
---
 .../bindings/leds/samsung,s2mpb02-flash.yaml       | 42 ++++++++++++++++++++++
 .../devicetree/bindings/mfd/samsung,s2mpb02.yaml   | 20 +++++++++++
 2 files changed, 62 insertions(+)

diff --git a/Documentation/devicetree/bindings/leds/samsung,s2mpb02-flash.yaml b/Documentation/devicetree/bindings/leds/samsung,s2mpb02-flash.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/samsung,s2mpb02-flash.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/samsung,s2mpb02-flash.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPB02 flash and torch LED
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description: |
+  The flash LED controller of the Samsung S2MPB02 PMIC, a sub-node of the
+  PMIC (see ../mfd/samsung,s2mpb02.yaml). It has a flash current source
+  and a torch current source; each is enabled by its own GPIO pin or over
+  I2C. The controller has an internal safety timer that turns the LED off
+  after a programmable delay.
+
+properties:
+  compatible:
+    const: samsung,s2mpb02-flash
+
+  torch-gpios:
+    description: GPIO connected to the torch enable pin.
+    maxItems: 1
+
+  flash-gpios:
+    description: GPIO connected to the flash enable pin.
+    maxItems: 1
+
+  led:
+    type: object
+    $ref: common.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - torch-gpios
+  - flash-gpios
+  - led
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/mfd/samsung,s2mpb02.yaml b/Documentation/devicetree/bindings/mfd/samsung,s2mpb02.yaml
--- a/Documentation/devicetree/bindings/mfd/samsung,s2mpb02.yaml
+++ b/Documentation/devicetree/bindings/mfd/samsung,s2mpb02.yaml
@@ -25,6 +25,9 @@ properties:
   reg:
     maxItems: 1
 
+  flash:
+    $ref: /schemas/leds/samsung,s2mpb02-flash.yaml#
+
   regulators:
     type: object
     description: The LDOs, bucks and the buck-boost.
@@ -45,6 +48,9 @@ additionalProperties: false
 
 examples:
   - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/leds/common.h>
+
     i2c {
         #address-cells = <1>;
         #size-cells = <0>;
@@ -53,6 +59,20 @@ examples:
             compatible = "samsung,s2mpb02";
             reg = <0x59>;
 
+            flash {
+                compatible = "samsung,s2mpb02-flash";
+                torch-gpios = <&tlmm 115 GPIO_ACTIVE_HIGH>;
+                flash-gpios = <&tlmm 155 GPIO_ACTIVE_HIGH>;
+
+                led {
+                    function = LED_FUNCTION_FLASH;
+                    color = <LED_COLOR_ID_WHITE>;
+                    led-max-microamp = <180000>;
+                    flash-max-microamp = <1000000>;
+                    flash-max-timeout-us = <500000>;
+                };
+            };
+
             regulators {
                 ldo11 {
                     regulator-name = "panel_vci_sub";
