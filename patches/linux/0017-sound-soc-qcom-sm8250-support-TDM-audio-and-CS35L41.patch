--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -10,6 +10,7 @@
 #include <sound/pcm_params.h>
 #include <linux/soundwire/sdw.h>
 #include <sound/jack.h>
+#include <sound/cs35l41.h>
 #include <linux/input-event-codes.h>
 #include "qdsp6/q6afe.h"
 #include "common.h"
@@ -18,6 +19,12 @@
 
 #define MI2S_BCLK_RATE		1536000
 
+/* Primary TDM: 4 slots of 32 bits at 48 kHz, two codecs on slots 0 and 1 */
+#define TDM_SLOTS		4
+#define TDM_SLOT_WIDTH		32
+#define TDM_SLOT_MASK		0x3
+#define TDM_BCLK_RATE		(48000 * TDM_SLOTS * TDM_SLOT_WIDTH)
+
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
@@ -78,6 +85,8 @@
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	struct snd_soc_dai *dai;
+	int i;
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX:
@@ -128,6 +137,15 @@
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
 		break;
+	case PRIMARY_TDM_RX_0:
+		codec_dai_fmt |= SND_SOC_DAIFMT_DSP_A | SND_SOC_DAIFMT_IB_NF;
+		snd_soc_dai_set_sysclk(cpu_dai,
+			Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT,
+			TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+		snd_soc_dai_set_fmt(cpu_dai, fmt);
+		for_each_rtd_codec_dais(rtd, i, dai)
+			snd_soc_dai_set_fmt(dai, codec_dai_fmt);
+		break;
 	default:
 		break;
 	}
@@ -135,6 +153,79 @@
 	return qcom_snd_sdw_startup(substream);
 }
 
+static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+	if (cpu_dai->id == PRIMARY_TDM_RX_0)
+		snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT,
+				       0, SNDRV_PCM_STREAM_PLAYBACK);
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
+/*
+ * Codec N of the dai-link listens on TDM slot N, so the order of the codecs
+ * in the DT is the channel order.
+ */
+static int sm8250_snd_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	unsigned int clk_freq = params_rate(params) * TDM_SLOTS * TDM_SLOT_WIDTH;
+	unsigned int slot_offset[TDM_SLOTS];
+	struct snd_soc_dai *codec_dai;
+	unsigned int rx_slot;
+	int i, ret;
+
+	if (cpu_dai->id != PRIMARY_TDM_RX_0)
+		return 0;
+
+	/* AFE channel map: byte offset of each slot in the frame */
+	for (i = 0; i < TDM_SLOTS; i++)
+		slot_offset[i] = i * TDM_SLOT_WIDTH / 8;
+
+	ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, TDM_SLOT_MASK,
+				       TDM_SLOTS, TDM_SLOT_WIDTH);
+	if (ret < 0)
+		return ret;
+
+	ret = snd_soc_dai_set_channel_map(cpu_dai, 0, NULL,
+					  params_channels(params), slot_offset);
+	if (ret < 0)
+		return ret;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		if (i >= hweight32(TDM_SLOT_MASK))
+			return -EINVAL;
+
+		ret = snd_soc_component_set_sysclk(codec_dai->component,
+						   CS35L41_CLKID_SCLK, 0,
+						   clk_freq, SND_SOC_CLOCK_IN);
+		if (ret < 0 && ret != -ENOTSUPP)
+			return ret;
+
+		ret = snd_soc_dai_set_sysclk(codec_dai, CS35L41_CLKID_SCLK,
+					     clk_freq, SND_SOC_CLOCK_IN);
+		if (ret < 0 && ret != -ENOTSUPP)
+			return ret;
+
+		ret = snd_soc_dai_set_tdm_slot(codec_dai, 0, BIT(i),
+					       TDM_SLOTS, TDM_SLOT_WIDTH);
+		if (ret < 0 && ret != -ENOTSUPP)
+			return ret;
+
+		rx_slot = i;
+		ret = snd_soc_dai_set_channel_map(codec_dai, 0, NULL, 1, &rx_slot);
+		if (ret < 0 && ret != -ENOTSUPP)
+			return ret;
+	}
+
+	return 0;
+}
+
 static int sm8250_snd_prepare(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -155,7 +246,8 @@
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.hw_params = sm8250_snd_hw_params,
+	.shutdown = sm8250_snd_shutdown,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,
 };
