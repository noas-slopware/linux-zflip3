+/*
+ * csiphy_cphy_config_rate - Apply the C-PHY settings for the symbol rate
+ *
+ * A C-PHY link frequency is half the symbol rate on each trio. Pick the
+ * lowest tier that covers the rate, or the top one if the rate is higher
+ * than every tier.
+ */
+static void csiphy_cphy_config_rate(struct csiphy_device *csiphy,
+				    const struct csiphy_cphy_rate_regs *rates,
+				    int num_rates, s64 link_freq, u8 settle_cnt)
+{
+	u64 sps = link_freq > 0 ? 2 * (u64)link_freq : 0;
+	int i;
+
+	for (i = 0; i < num_rates - 1; i++)
+		if (sps <= rates[i].max_sps)
+			break;
+
+	if (sps > rates[i].max_sps)
+		dev_warn(csiphy->camss->dev,
+			 "C-PHY symbol rate %llu above the highest tier %llu\n",
+			 sps, rates[i].max_sps);
+
+	csiphy_gen2_write_regs(csiphy, rates[i].regs, rates[i].num_regs,
+			       settle_cnt);
+}
