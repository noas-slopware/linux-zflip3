-				unsigned int clamp_min, unsigned int clamp_max,
-				unsigned int div, int val)
+static int max77705_set_input_current(struct max77705_charger_data *chg, int microamp)
 {
 	unsigned int regval;
 
-	regval = clamp_val(val, clamp_min, clamp_max) / div;
+	/*
+	 * 1 LSB is 25 mA and the register holds the limit minus one step, as
+	 * Samsung's driver writes it: 100 mA is 0x03, 500 mA is 0x13.
+	 */
+	regval = clamp_val(microamp, MAX77705_CURRENT_CHGIN_MIN,
+			   MAX77705_CURRENT_CHGIN_MAX);
+	regval = regval / MAX77705_CURRENT_CHGIN_STEP - 1;
 
-	return regmap_field_write(chg->rfield[fidx], regval);
+	return regmap_field_write(chg->rfield[MAX77705_CHG_CHGIN_LIM], regval);
+}
+
+static int max77705_set_charge_current(struct max77705_charger_data *chg, int microamp)
+{
+	unsigned int regval;
+
+	regval = clamp_val(microamp, MAX77705_CURRENT_CHGIN_MIN,
+			   MAX77705_CURRENT_CHG_MAX);
+	regval = regval / MAX77705_CURRENT_CHG_STEP;
+
+	return regmap_field_write(chg->rfield[MAX77705_CHG_CC_LIM], regval);
 }
 
