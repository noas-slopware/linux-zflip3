@@ -486,12 +496,221 @@
 	power_supply_changed(chg->psy_chg);
 }
 
+/*
+ * Port type as the USB-C block reports it in REG_BC_STATUS.CHGTYP. The value
+ * is one more than the index of the matching current limit in the DT arrays.
+ */
+enum max77705_port_type {
+	MAX77705_PORT_NONE = 0,
+	MAX77705_PORT_SDP,
+	MAX77705_PORT_CDP,
+	MAX77705_PORT_DCP,
+};
+
+static int max77705_set_b2sovrc(struct max77705_charger_data *chg)
+{
+	unsigned int regval;
+	int ret;
+
+	/* 1 LSB is 200 mA from 4.6 A, zero disables the protection */
+	regval = chg->b2sovrc_ua ? MAX77705_B2SOVRC_4_6A +
+			(chg->b2sovrc_ua / 1000 - 4600) / 200 :
+			MAX77705_B2SOVRC_DISABLE;
+
+	ret = regmap_field_write(chg->rfield[MAX77705_REG_B2SOVRC], regval);
+	if (ret)
+		return ret;
+
+	if (chg->b2sovrc_dtc_100ms)
+		return regmap_update_bits(chg->regmap, MAX77705_CHG_REG_CNFG_06,
+					  MAX77705_B2SOVRC_DTC_MASK,
+					  MAX77705_B2SOVRC_DTC_MASK);
+
+	return 0;
+}
+
+static int max77705_charger_parse_dt(struct max77705_charger_data *chg)
+{
+	struct device *dev = chg->dev;
+	unsigned int fsw_hz = 1500000;
+	unsigned int b2sovrc_ua = 4800000;
+
+	device_property_read_u32(dev, "maxim,switching-frequency-hz", &fsw_hz);
+
+	switch (fsw_hz) {
+	case 3000000:
+		chg->fsw = MAX77705_CHG_FSW_3MHz;
+		break;
+	case 2000000:
+		chg->fsw = MAX77705_CHG_FSW_2MHz;
+		break;
+	case 1500000:
+		chg->fsw = MAX77705_CHG_FSW_1_5MHz;
+		break;
+	default:
+		return dev_err_probe(dev, -EINVAL,
+				     "unsupported switching frequency %u Hz\n",
+				     fsw_hz);
+	}
+
+	if (device_property_read_u32(dev, "maxim,topoff-time-minutes",
+				     &chg->topoff_minutes))
+		chg->topoff_minutes = 30;
+	if (chg->topoff_minutes > 70 || chg->topoff_minutes % 10)
+		return dev_err_probe(dev, -EINVAL,
+				     "unsupported top-off time %u minutes\n",
+				     chg->topoff_minutes);
+
+	if (device_property_read_u32(dev, "maxim,b2sovrc-current-microamp",
+				     &b2sovrc_ua))
+		b2sovrc_ua = 4800000;
+	if (b2sovrc_ua && (b2sovrc_ua < 4600000 || b2sovrc_ua > 6200000 ||
+			   (b2sovrc_ua - 4600000) % 200000))
+		return dev_err_probe(dev, -EINVAL,
+				     "unsupported BAT to SYS current %u uA\n",
+				     b2sovrc_ua);
+	chg->b2sovrc_ua = b2sovrc_ua;
+	chg->b2sovrc_dtc_100ms =
+		device_property_read_bool(dev, "maxim,b2sovrc-dtc-100ms");
+
+	device_property_read_u32_array(dev, "maxim,input-current-limits-microamp",
+				       chg->input_current_limit,
+				       MAX77705_NUM_PORT_TYPES);
+	device_property_read_u32_array(dev, "maxim,charge-current-limits-microamp",
+				       chg->charge_current_limit,
+				       MAX77705_NUM_PORT_TYPES);
+
+	return 0;
+}
+
+static int max77705_charger_apply_port_current(struct max77705_charger_data *chg,
+					       unsigned int port)
+{
+	unsigned int idx;
+	int ret;
+
+	if (port <= MAX77705_PORT_NONE || port > MAX77705_PORT_DCP)
+		return 0;
+
+	idx = port - 1;
+
+	/* both limits are optional, an unset one stays as it is */
+	if (chg->input_current_limit[idx]) {
+		ret = max77705_set_input_current(chg, chg->input_current_limit[idx]);
+		if (ret)
+			return ret;
+	}
+
+	if (chg->charge_current_limit[idx]) {
+		ret = max77705_set_charge_current(chg, chg->charge_current_limit[idx]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int max77705_charger_update_port(struct max77705_charger_data *chg)
+{
+	unsigned int port, status;
+	int ret;
+
+	ret = regmap_read(chg->regmap_muic, MAX77705_USBC_REG_BC_STATUS, &status);
+	if (ret)
+		return ret;
+
+	/*
+	 * Follow VBUS at the connector, not the charger's own CHGIN_OK: the
+	 * USB-C block sees a cable the charger input has not seen yet.
+	 */
+	if (status & MAX77705_USBC_BC_STATUS_VBUSDET)
+		ret = regmap_field_write(chg->rfield[MAX77705_VCHGIN],
+					 MAX77705_VCHGIN_4_6);
+	else
+		ret = regmap_field_write(chg->rfield[MAX77705_VCHGIN],
+					 MAX77705_VCHGIN_4_5);
+	if (ret)
+		return ret;
+
+	port = status & MAX77705_USBC_BC_STATUS_CHGTYP;
+	ret = max77705_charger_apply_port_current(chg, port);
+	if (ret)
+		return ret;
+
+	power_supply_changed(chg->psy_chg);
+
+	return 0;
+}
+
+static irqreturn_t max77705_charger_usbc_irq(int irq, void *data)
+{
+	struct max77705_charger_data *chg = data;
+	unsigned int int_status;
+	int ret;
+
+	/* UIC_INT is cleared by reading it */
+	ret = regmap_read(chg->regmap_muic, MAX77705_USBC_REG_UIC_INT, &int_status);
+	if (ret)
+		return IRQ_HANDLED;
+
+	dev_dbg(chg->dev, "UIC_INT 0x%02x\n", int_status);
+
+	max77705_charger_update_port(chg);
+
+	return IRQ_HANDLED;
+}
+
+static int max77705_charger_setup_usbc(struct max77705_charger_data *chg)
+{
+	unsigned int val;
+	int irq, ret;
+
+	if (!chg->regmap_muic)
+		return 0;
+
+	/*
+	 * The second interrupt is the PMIC's USB-C source. Without it only the
+	 * state at probe time is applied: leaving the block's interrupts on
+	 * without a handler would keep the PMIC line asserted.
+	 */
+	if (of_irq_count(chg->dev->of_node) < 2)
+		return max77705_charger_update_port(chg);
+
+	irq = of_irq_get(chg->dev->of_node, 1);
+	if (irq < 0)
+		return irq;
+
+	ret = devm_request_threaded_irq(chg->dev, irq, NULL,
+					max77705_charger_usbc_irq,
+					IRQF_TRIGGER_NONE, "usbc-irq", chg);
+	if (ret)
+		return ret;
+
+	/* drop what the bootloader left pending, then watch the cable */
+	ret = regmap_read(chg->regmap_muic, MAX77705_USBC_REG_UIC_INT, &val);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(chg->regmap_muic, MAX77705_USBC_REG_UIC_INT_M,
+				 MAX77705_USBC_UIC_INT_VBUSDET |
+				 MAX77705_USBC_UIC_INT_CHGTYP, 0);
+	if (ret)
+		return ret;
+
+	return max77705_charger_update_port(chg);
+}
+
 static int max77705_charger_initialize(struct max77705_charger_data *chg)
 {
 	struct power_supply_battery_info *info;
 	struct regmap *regmap = chg->regmap;
+	unsigned int regval;
 	int err;
 
+	err = max77705_charger_parse_dt(chg);
+	if (err)
+		return err;
+
 	err = power_supply_get_battery_info(chg->psy_chg, &info);
 	if (err)
 		return dev_err_probe(chg->dev, err, "error on getting battery info");
@@ -508,6 +727,12 @@
 	if (err)
 		goto err;
 
+	/* factory mode may have left AICL off */
+	err = regmap_update_bits(regmap, MAX77705_CHG_REG_CNFG_06,
+				 MAX77705_DIS_AICL_MASK, 0);
+	if (err)
+		goto err;
+
 	/* fast charge timer disable */
 	/* restart threshold disable */
 	/* pre-qual charge disable */
@@ -523,6 +748,12 @@
 	if (err)
 		goto err;
 
+	/* restart the charge cycle after an overcurrent event */
+	err = regmap_field_write(chg->rfield[MAX77705_CHG_RECYCLE],
+				 MAX77705_RECYCLE_EN_ENABLE);
+	if (err)
+		goto err;
+
 	err = regmap_field_write(chg->rfield[MAX77705_MODE],
 			MAX77705_CHG_MASK | MAX77705_BUCK_MASK);
 	if (err)
@@ -534,18 +765,23 @@
 	if (err)
 		goto err;
 
-	/* BAT to SYS OCP 4.80A */
-	err = regmap_field_write(chg->rfield[MAX77705_REG_B2SOVRC], MAX77705_B2SOVRC_4_8A);
+	/* UNO current limit 1.0A */
+	err = regmap_field_write(chg->rfield[MAX77705_REG_UNOILIM], MAX77705_UNOILIM_1000);
+	if (err)
+		goto err;
+
+	/* BAT to SYS OCP */
+	err = max77705_set_b2sovrc(chg);
 	if (err)
 		goto err;
 
 	/* top off current 150mA */
-	/* top off timer 30min */
 	err = regmap_field_write(chg->rfield[MAX77705_TO], MAX77705_TO_ITH_150MA);
 	if (err)
 		goto err;
 
-	err = regmap_field_write(chg->rfield[MAX77705_TO_TIME], MAX77705_TO_TIME_30M);
+	err = regmap_field_write(chg->rfield[MAX77705_TO_TIME],
+				 chg->topoff_minutes / 10);
 	if (err)
 		goto err;
 
@@ -562,7 +798,23 @@
 		max77705_set_float_voltage(chg, info->voltage_max_design_uv);
 	}
 
-	err = regmap_field_write(chg->rfield[MAX77705_VCHGIN], MAX77705_VCHGIN_4_5);
+	/*
+	 * VCHGIN: 4.6 V with a charger attached, 4.5 V without. The higher
+	 * threshold keeps cheap battery packs from tripping CHGIN UVLO.
+	 */
+	err = regmap_read(regmap, MAX77705_CHG_REG_INT_OK, &regval);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_VCHGIN],
+				 (regval & MAX77705_CHGIN_OK) ?
+				 MAX77705_VCHGIN_4_6 : MAX77705_VCHGIN_4_5);
+	if (err)
+		goto err;
+
+	/* charge from CHGIN, this board has no wireless charger */
+	err = regmap_update_bits(regmap, MAX77705_CHG_REG_CNFG_12,
+				 MAX77705_CHGINSEL_MASK, MAX77705_CHGINSEL_MASK);
 	if (err)
 		goto err;
 
@@ -570,6 +822,14 @@
 	if (err)
 		goto err;
 
+	/* boost allowed in factory mode, FGSRC from the grounded jig pin, no ship mode */
+	err = regmap_update_bits(regmap, MAX77705_CHG_REG_CNFG_07,
+				 MAX77705_REG_FMBST_MASK | MAX77705_REG_FGSRC_MASK |
+				 MAX77705_REG_SHIPMODE_MASK,
+				 MAX77705_REG_FMBST_MASK);
+	if (err)
+		goto err;
+
 	/* Watchdog timer */
 	regmap_update_bits(regmap, MAX77705_CHG_REG_CNFG_00,
 				MAX77705_WDTEN_MASK, 0);
@@ -579,8 +839,13 @@
 	if (err)
 		goto err;
 
-	/* Switching Frequency : 1.5MHz */
-	err = regmap_field_write(chg->rfield[MAX77705_REG_FSW], MAX77705_CHG_FSW_1_5MHz);
+	/* auto ship mode must stay off: it cuts the rail under 2.6 V */
+	err = regmap_update_bits(regmap, MAX77705_CHG_REG_CNFG_03,
+				 MAX77705_AUTO_SHIPMODE_MASK, 0);
+	if (err)
+		goto err;
+
+	err = regmap_field_write(chg->rfield[MAX77705_REG_FSW], chg->fsw);
 	if (err)
 		goto err;
 
@@ -596,6 +861,32 @@
 
 }
 
+static int max77705_charger_get_pmic(struct max77705_charger_data *chg)
+{
+	struct max77693_dev *pmic;
+	struct device_node *np;
+	struct i2c_client *i2c;
+
+	np = of_parse_phandle(chg->dev->of_node, "maxim,pmic", 0);
+	if (!np)
+		return -ENODEV;
+
+	i2c = of_find_i2c_device_by_node(np);
+	of_node_put(np);
+	if (!i2c)
+		return -EPROBE_DEFER;
+
+	pmic = i2c_get_clientdata(i2c);
+	put_device(&i2c->dev);
+
+	if (!pmic || !pmic->regmap_muic)
+		return -EPROBE_DEFER;
+
+	chg->regmap_muic = pmic->regmap_muic;
+
+	return 0;
+}
+
 static int max77705_charger_probe(struct i2c_client *i2c)
 {
 	struct power_supply_config pscfg = {};
@@ -614,6 +905,10 @@
 	chg->dev = dev;
 	i2c_set_clientdata(i2c, chg);
 
+	ret = max77705_charger_get_pmic(chg);
+	if (ret && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "failed to get the MAX77705 PMIC\n");
+
 	chip_desc = devm_kmemdup(dev, &max77705_charger_irq_chip,
 				 sizeof(max77705_charger_irq_chip),
 				 GFP_KERNEL);
@@ -658,6 +953,10 @@
