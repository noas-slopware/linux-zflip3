+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K3L6 image sensor driver
+ *
+ * The Galaxy Z Flip3's (SM-F711N) rear ultrawide module comes with a Sony IMX258 or this
+ * sensor. Register settings, power sequence and timings are Samsung's, from the stock
+ * firmware's CamX sensor module (com.samsung.sensormodule.2_lsi_s5k3l6.bin): its init
+ * settings, its full resolution mode and its stream on and off settings. The structure
+ * follows the S5K3M5 driver.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+/*
+ * The output PLL as stock sets it: 19.2 MHz / 3 (0x030c) x 89 (0x030e) = 569.6 MHz, the
+ * 1139 Mbps per lane stock also writes to 0x0820. The pixel array runs at stock's
+ * output pixel clock, 478 MHz: 4896 x 3253 x 30 fps.
+ */
+#define S5K3L6_LINK_FREQ_569P6MHZ	(569600ULL * HZ_PER_KHZ)
+#define S5K3L6_PIXEL_RATE		(478 * HZ_PER_MHZ)
+#define S5K3L6_MCLK_FREQ_19P2MHZ	19200000
+#define S5K3L6_DATA_LANES		4
+
+/* Register map is similar to MIPI CCS compliant camera sensors */
+#define S5K3L6_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5K3L6_CHIP_ID			0x30c6
+
+/* mode_select (0x0100) and image_orientation (0x0101) in one write */
+#define S5K3L6_REG_CTRL_MODE		CCI_REG16(0x0100)
+#define S5K3L6_MODE_STREAMING		BIT(8)
+#define S5K3L6_VFLIP			BIT(1)
+#define S5K3L6_HFLIP			BIT(0)
+/* stock's stream on writes it after mode_select */
+#define S5K3L6_REG_STREAM_ON_2		CCI_REG16(0x3c1e)
+
+#define S5K3L6_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K3L6_EXPOSURE_MIN		4
+#define S5K3L6_EXPOSURE_STEP		1
+#define S5K3L6_EXPOSURE_MARGIN		10
+
+/* 0x0020 is a gain of 1, stock's maximum is 16 */
+#define S5K3L6_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K3L6_AGAIN_MIN		0x0020
+#define S5K3L6_AGAIN_MAX		0x0200
+#define S5K3L6_AGAIN_STEP		1
+#define S5K3L6_AGAIN_DEFAULT		0x0020
+
+#define S5K3L6_REG_VTS			CCI_REG16(0x0340)
+#define S5K3L6_VTS_MAX			0xffff
+
+#define S5K3L6_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_s5k3l6(_sd)			container_of(_sd, struct s5k3l6, sd)
+
+static const s64 s5k3l6_link_freq_menu[] = {
+	S5K3L6_LINK_FREQ_569P6MHZ,
+};
+
+/* GBRG unflipped (stock's colour filter arrangement 2), by vflip << 1 | hflip */
+static const u32 s5k3l6_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGBRG10_1X10,	MEDIA_BUS_FMT_SBGGR10_1X10,
+	MEDIA_BUS_FMT_SRGGB10_1X10,	MEDIA_BUS_FMT_SGRBG10_1X10,
+};
+
+struct s5k3l6_reg_list {
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+struct s5k3l6_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
+	u32 hts;			/* Horizontal timing size */
+	u32 vts;			/* Default vertical timing size */
+	u32 exposure;			/* Default exposure value */
+
+	const struct s5k3l6_reg_list reg_list;	/* Sensor register setting */
+};
+
+static const char * const s5k3l6_test_pattern_menu[] = {
+	"Disabled",
+	"Solid colour",
+	"Colour bars",
+	"Fade to grey colour bars",
+	"PN9",
+};
+
+/* In stock's power-up order: analog, digital core, I/O */
+static const char * const s5k3l6_supply_names[] = {
+	"vdda",		/* Analog power */
+	"vddd",		/* Digital core power */
+	"vddio",	/* Digital I/O power */
+};
+
+#define S5K3L6_NUM_SUPPLIES	ARRAY_SIZE(s5k3l6_supply_names)
+
+struct s5k3l6 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[S5K3L6_NUM_SUPPLIES];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	const struct s5k3l6_mode *mode;
+};
+
+/* initSettings */
+static const struct cci_reg_sequence s5k3l6_init_setting[] = {
+	{ CCI_REG16(0x306a), 0x2f4c },
+	{ CCI_REG16(0x306c), 0xca01 },
+	{ CCI_REG16(0x307a), 0x0d20 },
+	{ CCI_REG16(0x309e), 0x002d },
+	{ CCI_REG16(0x3072), 0x0013 },
+	{ CCI_REG16(0x3074), 0x0977 },
+	{ CCI_REG16(0x3076), 0x9411 },
+	{ CCI_REG16(0x3024), 0x0016 },
+	{ CCI_REG16(0x3002), 0x0e00 },
+	{ CCI_REG16(0x3006), 0x1000 },
+	{ CCI_REG16(0x300a), 0x0c00 },
+	{ CCI_REG16(0x3018), 0xc500 },
+	{ CCI_REG16(0x303a), 0x0204 },
+	{ CCI_REG16(0x3266), 0x0001 },
+	{ CCI_REG16(0x38da), 0x000a },
+	{ CCI_REG16(0x38dc), 0x000b },
+	{ CCI_REG16(0x38d6), 0x000a },
+	{ CCI_REG16(0x3070), 0x3d00 },
+	{ CCI_REG16(0x3084), 0x1314 },
+	{ CCI_REG16(0x3086), 0x0ce7 },
+	{ CCI_REG16(0x3004), 0x0800 },
+	{ CCI_REG16(0x3c08), 0xffff },
+};
+
+/* resolutionData[0]: 4000x3000, 30 fps, 4 lanes */
+static const struct cci_reg_sequence s5k3l6_4000x3000_30fps_mode[] = {
+	{ CCI_REG16(0x314a), 0x5f00 },
+	{ CCI_REG16(0x3064), 0xffcf },
+	{ CCI_REG16(0x3066), 0x7e00 },
+	{ CCI_REG16(0x309c), 0x0640 },
+	{ CCI_REG16(0x380c), 0x001a },
+	{ CCI_REG16(0x32b2), 0x0000 },
+	{ CCI_REG16(0x32b4), 0x0000 },
+	{ CCI_REG16(0x32b6), 0x0000 },
+	{ CCI_REG16(0x32b8), 0x0000 },
+	{ CCI_REG16(0x3090), 0x8800 },
+	{ CCI_REG16(0x3238), 0x000c },
+	{ CCI_REG16(0x0100), 0x0000 },
+	{ CCI_REG16(0x0344), 0x0070 },
+	{ CCI_REG16(0x0348), 0x100f },
+	{ CCI_REG16(0x0346), 0x0044 },
+	{ CCI_REG16(0x034a), 0x0bfb },
+	{ CCI_REG16(0x034c), 0x0fa0 },
+	{ CCI_REG16(0x034e), 0x0bb8 },
+	{ CCI_REG16(0x0202), 0x03de },
+	{ CCI_REG16(0x3400), 0x0000 },
+	{ CCI_REG16(0x3402), 0x4e42 },
+	{ CCI_REG16(0x0136), 0x1333 },
+	{ CCI_REG16(0x0304), 0x0003 },
+	{ CCI_REG16(0x0306), 0x0070 },
+	{ CCI_REG16(0x030c), 0x0003 },
+	{ CCI_REG16(0x030e), 0x0059 },
+	{ CCI_REG16(0x3c16), 0x0000 },
+	{ CCI_REG16(0x0342), 0x1320 },
+	{ CCI_REG16(0x0340), 0x0cb5 },
+	{ CCI_REG16(0x0900), 0x0000 },
+	{ CCI_REG16(0x0386), 0x0001 },
+	{ CCI_REG16(0x3452), 0x0000 },
+	{ CCI_REG16(0x345a), 0x0000 },
+	{ CCI_REG16(0x345c), 0x0000 },
+	{ CCI_REG16(0x345e), 0x0000 },
+	{ CCI_REG16(0x3460), 0x0000 },
+	{ CCI_REG16(0x38c4), 0x0009 },
+	{ CCI_REG16(0x38d8), 0x0028 },
+	{ CCI_REG16(0x38da), 0x000a },
+	{ CCI_REG16(0x38dc), 0x000a },
+	{ CCI_REG16(0x38c2), 0x0009 },
+	{ CCI_REG16(0x38c0), 0x000e },
+	{ CCI_REG16(0x38d6), 0x0009 },
+	{ CCI_REG16(0x38d4), 0x0008 },
+	{ CCI_REG16(0x38b0), 0x000e },
+	{ CCI_REG16(0x3932), 0x1000 },
+	{ CCI_REG16(0x0820), 0x0473 },
+	{ CCI_REG16(0x3c34), 0x0008 },
+	{ CCI_REG16(0x3c36), 0x3800 },
+	{ CCI_REG16(0x3c38), 0x0020 },
+	{ CCI_REG16(0x393e), 0x4000 },
+	{ CCI_REG16(0x3892), 0x3600 },
+	{ CCI_REG16(0x3c1e), 0x0100 },
+};
+
+static const struct s5k3l6_mode s5k3l6_supported_modes[] = {
+	{
+		.width = 4000,
+		.height = 3000,
+		.hts = 4896,
+		.vts = 3253,
+		.exposure = 0x03de,
+		.reg_list = {
+			.regs = s5k3l6_4000x3000_30fps_mode,
+			.num_regs = ARRAY_SIZE(s5k3l6_4000x3000_30fps_mode),
+		},
+	},
+};
+
+static int s5k3l6_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k3l6 *s5k3l6 = container_of(ctrl->handler, struct s5k3l6,
+					     ctrl_handler);
+	const struct s5k3l6_mode *mode = s5k3l6->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		/* The orientation settings are applied along with streaming */
+		return 0;
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - S5K3L6_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k3l6->exposure,
+					 s5k3l6->exposure->minimum,
+					 exposure_max,
+					 s5k3l6->exposure->step,
+					 s5k3l6->exposure->default_value);
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5k3l6->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_AGAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k3l6->regmap, S5K3L6_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k3l6->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k3l6_ctrl_ops = {
+	.s_ctrl = s5k3l6_set_ctrl,
+};
+
+static int s5k3l6_init_controls(struct s5k3l6 *s5k3l6)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5k3l6->ctrl_handler;
+	const struct s5k3l6_mode *mode = s5k3l6->mode;
+	s64 pixel_rate, hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+
+	s5k3l6->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5k3l6_link_freq_menu) - 1,
+					0, s5k3l6_link_freq_menu);
+	if (s5k3l6->link_freq)
+		s5k3l6->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	pixel_rate = S5K3L6_PIXEL_RATE;
+	s5k3l6->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       0, pixel_rate, 1, pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5k3l6->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (s5k3l6->hblank)
+		s5k3l6->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k3l6->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K3L6_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5k3l6_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K3L6_AGAIN_MIN, S5K3L6_AGAIN_MAX,
+			  S5K3L6_AGAIN_STEP, S5K3L6_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts - S5K3L6_EXPOSURE_MARGIN;
+	s5k3l6->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K3L6_EXPOSURE_MIN,
+					     exposure_max,
+					     S5K3L6_EXPOSURE_STEP,
+					     mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5k3l6_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k3l6_test_pattern_menu) - 1,
+				     0, 0, s5k3l6_test_pattern_menu);
+
+	s5k3l6->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k3l6->hflip)
+		s5k3l6->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k3l6->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k3l6->vflip)
+		s5k3l6->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ret = v4l2_fwnode_device_parse(s5k3l6->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5k3l6_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	s5k3l6->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int s5k3l6_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	const struct s5k3l6_reg_list *reg_list = &s5k3l6->mode->reg_list;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k3l6->dev);
+	if (ret)
+		return ret;
+
+	cci_multi_reg_write(s5k3l6->regmap, s5k3l6_init_setting,
+			    ARRAY_SIZE(s5k3l6_init_setting), &ret);
+	cci_multi_reg_write(s5k3l6->regmap, reg_list->regs,
+			    reg_list->num_regs, &ret);
+	if (ret)
+		goto error;
+
+	ret = __v4l2_ctrl_handler_setup(s5k3l6->sd.ctrl_handler);
+
+	cci_write(s5k3l6->regmap, S5K3L6_REG_CTRL_MODE,
+		  S5K3L6_MODE_STREAMING |
+		  (s5k3l6->vflip->val ? S5K3L6_VFLIP : 0) |
+		  (s5k3l6->hflip->val ? S5K3L6_HFLIP : 0), &ret);
+	cci_write(s5k3l6->regmap, S5K3L6_REG_STREAM_ON_2, 0x0000, &ret);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(s5k3l6->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k3l6->dev);
+
+	return ret;
+}
+
+static int s5k3l6_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	int ret;
+
+	ret = cci_write(s5k3l6->regmap, CCI_REG8(0x0100), 0, NULL);
+	if (ret)
+		dev_err(s5k3l6->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(s5k3l6->dev);
+
+	return ret;
+}
+
+static u32 s5k3l6_get_format_code(struct s5k3l6 *s5k3l6)
+{
+	unsigned int i;
+
+	i = (s5k3l6->vflip->val ? 2 : 0) | (s5k3l6->hflip->val ? 1 : 0);
+
+	return s5k3l6_mbus_formats[i];
+}
+
+static void s5k3l6_update_pad_format(struct s5k3l6 *s5k3l6,
+				     const struct s5k3l6_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k3l6_get_format_code(s5k3l6);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k3l6_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	s64 hblank, vblank, exposure_max;
+	const struct s5k3l6_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5k3l6_supported_modes,
+				      ARRAY_SIZE(s5k3l6_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5k3l6_update_pad_format(s5k3l6, mode, &fmt->format);
+
+	/* Format code could be updated with respect to flip controls */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k3l6->mode == mode)
+		goto set_format;
+
+	/* Update limits and set FPS and exposure to default values */
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5k3l6->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5k3l6->vblank, vblank,
+				 S5K3L6_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5k3l6->vblank, vblank);
+
+	exposure_max = mode->vts - S5K3L6_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(s5k3l6->exposure, S5K3L6_EXPOSURE_MIN,
+				 exposure_max, S5K3L6_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5k3l6->exposure, mode->exposure);
+
+	if (s5k3l6->sd.ctrl_handler->error)
+		return s5k3l6->sd.ctrl_handler->error;
+
+	s5k3l6->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k3l6_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+
+	/* Media bus code index is constant, but code formats are not */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k3l6_get_format_code(s5k3l6);
+
+	return 0;
+}
+
+static int s5k3l6_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5k3l6_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k3l6_get_format_code(s5k3l6))
+		return -EINVAL;
+
+	fse->min_width = s5k3l6_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k3l6_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k3l6_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+
+	if (sel->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = s5k3l6->mode->width;
+		sel->r.height = s5k3l6->mode->height;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int s5k3l6_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			/* Media bus code depends on current flip controls */
+			.width = s5k3l6->mode->width,
+			.height = s5k3l6->mode->height,
+		},
+	};
+
+	s5k3l6_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k3l6_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k3l6_pad_ops = {
+	.set_fmt = s5k3l6_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k3l6_get_selection,
+	.enum_mbus_code = s5k3l6_enum_mbus_code,
+	.enum_frame_size = s5k3l6_enum_frame_size,
+	.enable_streams = s5k3l6_enable_streams,
+	.disable_streams = s5k3l6_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k3l6_subdev_ops = {
+	.video = &s5k3l6_video_ops,
+	.pad = &s5k3l6_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k3l6_internal_ops = {
+	.init_state = s5k3l6_init_state,
+};
+
+static const struct media_entity_operations s5k3l6_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k3l6_identify_sensor(struct s5k3l6 *s5k3l6)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(s5k3l6->regmap, S5K3L6_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5k3l6->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != S5K3L6_CHIP_ID) {
+		dev_err(s5k3l6->dev, "chip id mismatch: %x!=%llx\n",
+			S5K3L6_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int s5k3l6_check_hwcfg(struct s5k3l6 *s5k3l6)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k3l6->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus = {
+			.mipi_csi2 = {
+				.num_data_lanes = S5K3L6_DATA_LANES,
+			},
+		},
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K3L6_DATA_LANES) {
+		dev_err(s5k3l6->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k3l6->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k3l6_link_freq_menu,
+				       ARRAY_SIZE(s5k3l6_link_freq_menu),
+				       &freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/*
+ * Stock's power-up sequence: VANA, VDIG, VIO, 1 ms apart, then MCLK and 1 ms, then out
+ * of reset and 18 ms before the first access; power-down in the reverse order.
+ */
+static int s5k3l6_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	int i, ret;
+
+	for (i = 0; i < S5K3L6_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(s5k3l6->supplies[i].consumer);
+		if (ret)
+			goto disable_regulators;
+		usleep_range(1000, 1100);
+	}
+
+	ret = clk_prepare_enable(s5k3l6->mclk);
+	if (ret)
+		goto disable_regulators;
+	usleep_range(1000, 1100);
+
+	gpiod_set_value_cansleep(s5k3l6->reset_gpio, 0);
+	usleep_range(18 * USEC_PER_MSEC, 19 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_regulators:
+	while (--i >= 0)
+		regulator_disable(s5k3l6->supplies[i].consumer);
+
+	return ret;
+}
+
+static int s5k3l6_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+	int i;
+
+	gpiod_set_value_cansleep(s5k3l6->reset_gpio, 1);
+	usleep_range(1000, 1100);
+
+	clk_disable_unprepare(s5k3l6->mclk);
+	usleep_range(1000, 1100);
+
+	for (i = S5K3L6_NUM_SUPPLIES - 1; i >= 0; i--)
+		regulator_disable(s5k3l6->supplies[i].consumer);
+
+	return 0;
+}
+
+static int s5k3l6_probe(struct i2c_client *client)
+{
+	struct s5k3l6 *s5k3l6;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k3l6 = devm_kzalloc(&client->dev, sizeof(*s5k3l6), GFP_KERNEL);
+	if (!s5k3l6)
+		return -ENOMEM;
+
+	s5k3l6->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5k3l6->sd, client, &s5k3l6_subdev_ops);
+
+	s5k3l6->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k3l6->regmap))
+		return dev_err_probe(s5k3l6->dev, PTR_ERR(s5k3l6->regmap),
+				     "failed to init CCI\n");
+
+	s5k3l6->mclk = devm_v4l2_sensor_clk_get(s5k3l6->dev, NULL);
+	if (IS_ERR(s5k3l6->mclk))
+		return dev_err_probe(s5k3l6->dev, PTR_ERR(s5k3l6->mclk),
+				     "failed to get MCLK clock\n");
+
+	freq = clk_get_rate(s5k3l6->mclk);
+	if (freq != S5K3L6_MCLK_FREQ_19P2MHZ)
+		return dev_err_probe(s5k3l6->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5k3l6_check_hwcfg(s5k3l6);
+	if (ret)
+		return dev_err_probe(s5k3l6->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5k3l6->reset_gpio = devm_gpiod_get_optional(s5k3l6->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k3l6->reset_gpio))
+		return dev_err_probe(s5k3l6->dev, PTR_ERR(s5k3l6->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	for (i = 0; i < S5K3L6_NUM_SUPPLIES; i++)
+		s5k3l6->supplies[i].supply = s5k3l6_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k3l6->dev, S5K3L6_NUM_SUPPLIES,
+				      s5k3l6->supplies);
+	if (ret)
+		return dev_err_probe(s5k3l6->dev, ret,
+				     "failed to get supply regulators\n");
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5k3l6_power_on(s5k3l6->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k3l6_identify_sensor(s5k3l6);
+	if (ret) {
+		dev_err_probe(s5k3l6->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5k3l6->mode = &s5k3l6_supported_modes[0];
+	ret = s5k3l6_init_controls(s5k3l6);
+	if (ret) {
+		dev_err_probe(s5k3l6->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k3l6->sd.state_lock = s5k3l6->ctrl_handler.lock;
+	s5k3l6->sd.internal_ops = &s5k3l6_internal_ops;
+	s5k3l6->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k3l6->sd.entity.ops = &s5k3l6_subdev_entity_ops;
+	s5k3l6->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k3l6->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k3l6->sd.entity, 1, &s5k3l6->pad);
+	if (ret) {
+		dev_err_probe(s5k3l6->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5k3l6->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3l6->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5k3l6->dev);
+	pm_runtime_enable(s5k3l6->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k3l6->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k3l6->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k3l6->dev, 1000);
+	pm_runtime_use_autosuspend(s5k3l6->dev);
+	pm_runtime_idle(s5k3l6->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k3l6->sd);
+	pm_runtime_disable(s5k3l6->dev);
+	pm_runtime_set_suspended(s5k3l6->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5k3l6->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5k3l6->sd.ctrl_handler);
+
+power_off:
+	s5k3l6_power_off(s5k3l6->dev);
+
+	return ret;
+}
+
+static void s5k3l6_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k3l6 *s5k3l6 = to_s5k3l6(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k3l6->dev);
+
+	if (!pm_runtime_status_suspended(s5k3l6->dev)) {
+		s5k3l6_power_off(s5k3l6->dev);
+		pm_runtime_set_suspended(s5k3l6->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k3l6_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k3l6_power_off, s5k3l6_power_on, NULL)
+};
+
+static const struct of_device_id s5k3l6_of_match[] = {
+	{ .compatible = "samsung,s5k3l6" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k3l6_of_match);
+
+static struct i2c_driver s5k3l6_i2c_driver = {
