From: Noa Himesaka <himesaka@noa.codes>
Subject: [PATCH] arm64: dts: qcom: sm8350-b2q: enable USB OTG and Iris firmware

Update the Samsung Galaxy Z Flip3 (b2q) device tree:
- Link the max77705 charger node to usb_1_dwc3 through its
  usb-role-switch property, so the charger driver can switch the DWC3
  between host and device. The usb-role-switch flag on usb_1_dwc3
  itself is already set by the board patch.
- Remove the dead pmic-glink node and the usb_1_dwc3_hs endpoint:
  Type-C detection and role switching are done by the MAX77705, and the
  data lines are routed to the SoC by the MAX77705 USB-C block. The usb_1_qmpphy_out and usb_1_dwc3_hs
  endpoints in sm8350.dtsi are left without a remote endpoint.
- Correct the Iris firmware name to vpu20_4v.mbn, the image in the stock
  Samsung b2q firmware.
- Include dt-bindings/leds/common.h for the S2MPB02 flash LED node that
  a later patch adds.

Signed-off-by: Noa Himesaka <himesaka@noa.codes>
Assisted-by: Claude:claude-opus-5-5
---
 .../boot/dts/qcom/sm8350-samsung-b2q.dts      | 44 ++-----------------
 1 file changed, 3 insertions(+), 41 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-samsung-b2q.dts b/arch/arm64/boot/dts/qcom/sm8350-samsung-b2q.dts
index d2a3b4d38..555e5ce60 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-samsung-b2q.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-samsung-b2q.dts
@@ -10,6 +10,7 @@
  */
 
 #include <dt-bindings/input/gpio-keys.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 #include "sm8350.dtsi"
@@ -363,42 +364,6 @@ codec {
 		};
 	};
 
-	pmic-glink {
-		compatible = "qcom,sm8350-pmic-glink", "qcom,pmic-glink";
-		#address-cells = <1>;
-		#size-cells = <0>;
-		orientation-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
-
-		connector@0 {
-			compatible = "usb-c-connector";
-			reg = <0>;
-			power-role = "dual";
-			data-role = "dual";
-
-			ports {
-				#address-cells = <1>;
-				#size-cells = <0>;
-
-				port@0 {
-					reg = <0>;
-
-					pmic_glink_hs_in: endpoint {
-						remote-endpoint = <&usb_1_dwc3_hs>;
-					};
-				};
-
-				port@1 {
-					reg = <1>;
-
-					pmic_glink_ss_in: endpoint {
-						remote-endpoint = <&usb_1_qmpphy_out>;
-					};
-				};
-
-			};
-		};
-	};
-
 	s2dos05_i2c: i2c-51 {
 		compatible = "i2c-gpio";
 	 	sda-gpios = <&tlmm 104 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
@@ -1521,6 +1486,7 @@ max77705_charger: charger@69 {
 		compatible = "maxim,max77705-charger";
 		reg = <0x69>;
 		monitored-battery = <&battery>;
+		usb-role-switch = <&usb_1_dwc3>;
 
 		/* BC1.2 port type from the USB-C block (MFD irq 3) */
 		maxim,pmic = <&max77705>;
@@ -1713,10 +1679,6 @@ &usb_1_hsphy {
 	vdda33-supply = <&vreg_l2b_3p07>;
 };
 
-&usb_1_dwc3_hs {
-	remote-endpoint = <&pmic_glink_hs_in>;
-};
-
 &usb_1_qmpphy {
 	status = "okay";
 
@@ -1746,7 +1708,7 @@ &ipa {
 
 &iris {
 	status = "okay";
-	firmware-name = "qcom/sm8350/Samsung/b2q/vpu20_p4.mbn";
+	firmware-name = "qcom/sm8350/Samsung/b2q/vpu20_4v.mbn";
 };
 
 &mpss {
