+
+static const struct cci_reg_sequence imx563_4000x3000_regs[] = {
+	{ CCI_REG8(0x0112), 0x0a },	/* CSI data format: RAW10 in, RAW10 out */
+	{ CCI_REG8(0x0113), 0x0a },
+	{ CCI_REG8(0x0114), 0x02 },	/* CSI lane mode: 3 trios */
+	{ CCI_REG8(0x0220), 0x00 },	/* HDR mode: off */
+	{ CCI_REG8(0x0221), 0x11 },
