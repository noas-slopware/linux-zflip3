+struct imx563 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[IMX563_NUM_SUPPLIES];
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+
+	/* Mode of the active state, protected by the state lock */
+	const struct imx563_mode *mode;
+};
+
+static inline struct imx563 *to_imx563(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx563, sd);
+}
+
+/* -----------------------------------------------------------------------------
+ * Controls
+ */
+
+static int imx563_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx563 *imx563 = container_of(ctrl->handler, struct imx563,
+					     ctrl_handler);
+	const struct imx563_mode *mode = imx563->mode;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int exposure_max = mode->height + ctrl->val -
+				   IMX563_EXPOSURE_OFFSET;
+
+		exposure_max = min(exposure_max, IMX563_EXPOSURE_MAX);
+		ret = __v4l2_ctrl_modify_range(imx563->exposure,
+					       imx563->exposure->minimum,
+					       exposure_max,
+					       imx563->exposure->step,
+					       min_t(int, exposure_max,
+						     mode->exposure_def));
+		if (ret)
+			return ret;
+	}
+
+	/* Registers are written only while the sensor is powered */
+	if (pm_runtime_get_if_in_use(imx563->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(imx563->regmap, IMX563_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(imx563->regmap, IMX563_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(imx563->regmap, IMX563_REG_DIGITAL_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(imx563->regmap, IMX563_REG_FRM_LENGTH_LINES,
+			  mode->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		/* Stock writes 0xb000 = 0 with every pattern change */
+		cci_write(imx563->regmap, IMX563_REG_TP_B000, 0, &ret);
+		cci_write(imx563->regmap, IMX563_REG_TEST_PATTERN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_RED:
+		cci_write(imx563->regmap, IMX563_REG_TESTP_RED, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENR:
+		cci_write(imx563->regmap, IMX563_REG_TESTP_GREENR, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_BLUE:
+		cci_write(imx563->regmap, IMX563_REG_TESTP_BLUE, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENB:
+		cci_write(imx563->regmap, IMX563_REG_TESTP_GREENB, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_LINK_FREQ:
+	case V4L2_CID_PIXEL_RATE:
+	case V4L2_CID_HBLANK:
+		/* Read-only, fixed by the mode list */
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(imx563->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx563_ctrl_ops = {
+	.s_ctrl = imx563_set_ctrl,
+};
+
+static int imx563_init_controls(struct imx563 *imx563)
+{
+	const struct imx563_mode *mode = imx563->mode;
+	struct v4l2_ctrl_handler *hdl = &imx563->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	unsigned int i;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 14);
+	if (ret)
+		return ret;
+
+	imx563->pixel_rate = v4l2_ctrl_new_std(hdl, &imx563_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       IMX563_PIXEL_RATE,
+					       IMX563_PIXEL_RATE, 1,
+					       IMX563_PIXEL_RATE);
+
+	imx563->link_freq =
+		v4l2_ctrl_new_int_menu(hdl, &imx563_ctrl_ops,
+				       V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(imx563_link_freq_menu) - 1,
+				       0, imx563_link_freq_menu);
+	if (imx563->link_freq)
+		imx563->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx563->hblank = v4l2_ctrl_new_std(hdl, &imx563_ctrl_ops,
+					   V4L2_CID_HBLANK,
+					   mode->llp - mode->width,
+					   mode->llp - mode->width, 1,
+					   mode->llp - mode->width);
+	if (imx563->hblank)
+		imx563->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	/* Frames can be made longer than stock's, not shorter */
+	imx563->vblank = v4l2_ctrl_new_std(hdl, &imx563_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->fll_min - mode->height,
+					   IMX563_FLL_MAX - mode->height, 1,
+					   mode->fll_def - mode->height);
+
+	imx563->exposure = v4l2_ctrl_new_std(hdl, &imx563_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX563_EXPOSURE_MIN,
+					     mode->fll_def - IMX563_EXPOSURE_OFFSET,
+					     IMX563_EXPOSURE_STEP,
+					     mode->exposure_def);
+
+	v4l2_ctrl_new_std(hdl, &imx563_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX563_ANA_GAIN_MIN, IMX563_ANA_GAIN_MAX,
+			  IMX563_ANA_GAIN_STEP, IMX563_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx563_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX563_DGTL_GAIN_MIN, IMX563_DGTL_GAIN_MAX,
+			  IMX563_DGTL_GAIN_STEP, IMX563_DGTL_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx563_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx563_test_pattern_menu) - 1,
+				     0, 0, imx563_test_pattern_menu);
+	for (i = 0; i < 4; i++) {
+		/*
+		 * V4L2_CID_TEST_PATTERN_GREENR, _BLUE and _GREENB follow
+		 * V4L2_CID_TEST_PATTERN_RED in that order. The solid colour
+		 * pattern is white by default.
+		 */
+		v4l2_ctrl_new_std(hdl, &imx563_ctrl_ops,
+				  V4L2_CID_TEST_PATTERN_RED + i,
+				  IMX563_TESTP_COLOUR_MIN,
+				  IMX563_TESTP_COLOUR_MAX,
+				  IMX563_TESTP_COLOUR_STEP,
+				  IMX563_TESTP_COLOUR_MAX);
+	}
+
+	if (hdl->error) {
+		ret = hdl->error;
+		dev_err_probe(imx563->dev, ret, "control init failed\n");
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(imx563->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx563_ctrl_ops, &props);
+	if (ret)
+		goto error;
+
+	imx563->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+/* -----------------------------------------------------------------------------
+ * Subdev operations
+ */
+
+static int imx563_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx563 *imx563 = to_imx563(sd);
+	const struct imx563_mode *mode = imx563->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx563->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(imx563->regmap, imx563_init_regs,
+				  ARRAY_SIZE(imx563_init_regs), NULL);
+	if (ret) {
+		dev_err(imx563->dev, "failed to write init registers: %d\n",
+			ret);
+		goto err_rpm_put;
+	}
+
+	ret = cci_multi_reg_write(imx563->regmap, mode->regs, mode->num_regs,
+				  NULL);
+	if (ret) {
+		dev_err(imx563->dev, "failed to write mode registers: %d\n",
+			ret);
+		goto err_rpm_put;
+	}
+
+	/*
+	 * After the mode list, which ends with exposure and gain defaults.
+	 * The vertical blanking control sets the frame length, which picks
+	 * 30 or 60 fps for 4000x2252.
+	 */
+	ret = __v4l2_ctrl_handler_setup(imx563->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(imx563->regmap, IMX563_REG_MODE_SELECT,
+			IMX563_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(imx563->dev);
+	return ret;
+}
+
+static int imx563_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx563 *imx563 = to_imx563(sd);
+	int ret;
+
+	ret = cci_write(imx563->regmap, IMX563_REG_MODE_SELECT,
+			IMX563_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(imx563->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(imx563->dev);
+
+	return ret;
+}
+
+static int imx563_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = IMX563_MBUS_CODE;
+
+	return 0;
+}
+
+static int imx563_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	const struct imx563_mode *mode;
+
+	if (fse->code != IMX563_MBUS_CODE ||
+	    fse->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+
+	mode = &supported_modes[fse->index];
+	fse->min_width = mode->width;
+	fse->max_width = mode->width;
+	fse->min_height = mode->height;
+	fse->max_height = mode->height;
+
+	return 0;
+}
+
+static int imx563_update_controls(struct imx563 *imx563,
+				  const struct imx563_mode *mode)
+{
+	int hblank = mode->llp - mode->width;
+	int vblank = mode->fll_def - mode->height;
+	int ret;
+
+	ret = __v4l2_ctrl_modify_range(imx563->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(imx563->vblank,
+				       mode->fll_min - mode->height,
+				       IMX563_FLL_MAX - mode->height, 1,
+				       vblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx563->vblank, vblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(imx563->exposure,
+					IMX563_EXPOSURE_MIN,
+					mode->fll_def - IMX563_EXPOSURE_OFFSET,
+					IMX563_EXPOSURE_STEP,
+					mode->exposure_def);
+}
+
+static int imx563_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx563 *imx563 = to_imx563(sd);
+	const struct imx563_mode *mode;
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+	int ret;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	mode = v4l2_find_nearest_size(supported_modes,
+				      ARRAY_SIZE(supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	fmt->format.code = IMX563_MBUS_CODE;
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	*format = fmt->format;
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	*crop = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		imx563->mode = mode;
+		ret = imx563_update_controls(imx563, mode);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int imx563_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX563_NATIVE_WIDTH;
+		sel->r.height = IMX563_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx563_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = IMX563_MBUS_CODE,
+			.width = supported_modes[0].width,
+			.height = supported_modes[0].height,
+		},
+	};
+
+	return imx563_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops imx563_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx563_pad_ops = {
+	.enum_mbus_code = imx563_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx563_set_pad_format,
+	.get_selection = imx563_get_selection,
+	.enum_frame_size = imx563_enum_frame_size,
+	.enable_streams = imx563_enable_streams,
+	.disable_streams = imx563_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx563_subdev_ops = {
+	.video = &imx563_video_ops,
+	.pad = &imx563_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx563_internal_ops = {
+	.init_state = imx563_init_state,
+};
+
+/* -----------------------------------------------------------------------------
+ * Power management
+ */
+
+/*
+ * Stock's power sequence: the extra 1.8 V rail, VANA, VDIG and VIF 1 ms
+ * apart, then XCLR released, MCLK 2 ms later, then 18 ms before the first
+ * access. Power-down asserts XCLR, stops MCLK and drops the rails in
+ * reverse, 1 ms apart.
+ */
+static int imx563_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx563 *imx563 = to_imx563(sd);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < IMX563_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(imx563->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				imx563->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+		usleep_range(1000, 1100);
+	}
+
+	gpiod_set_value_cansleep(imx563->reset_gpio, 0);
+	usleep_range(2000, 2200);
+
+	ret = clk_prepare_enable(imx563->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		gpiod_set_value_cansleep(imx563->reset_gpio, 1);
+		goto err_supplies;
+	}
+	usleep_range(18000, 19000);
+
+	return 0;
+
+err_supplies:
+	while (i--)
+		regulator_disable(imx563->supplies[i].consumer);
+
+	return ret;
+}
+
+static int imx563_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx563 *imx563 = to_imx563(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(imx563->reset_gpio, 1);
+	usleep_range(1000, 1100);
+
+	clk_disable_unprepare(imx563->xclk);
+	usleep_range(1000, 1100);
+
+	for (i = IMX563_NUM_SUPPLIES; i--;) {
+		regulator_disable(imx563->supplies[i].consumer);
+		usleep_range(1000, 1100);
+	}
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * Probe & remove
+ */
+
+static int imx563_identify_module(struct imx563 *imx563)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(imx563->regmap, IMX563_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(imx563->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != IMX563_CHIP_ID)
+		return dev_err_probe(imx563->dev, -ENODEV,
+				     "chip id mismatch: expected 0x%04x, read 0x%04llx\n",
+				     IMX563_CHIP_ID, val);
+
+	return 0;
+}
+
+static int imx563_check_hwcfg(struct imx563 *imx563)
+{
+	struct device *dev = imx563->dev;
+	struct v4l2_fwnode_endpoint ep_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY
+	};
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "endpoint node not found\n");
+
+	/* Fails with -ENXIO if the endpoint gives a bus type other than C-PHY */
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret == -ENXIO)
+		return dev_err_probe(dev, ret, "only C-PHY is supported\n");
+	if (ret)
+		return dev_err_probe(dev, ret, "could not parse endpoint\n");
+
+	if (ep_cfg.bus.mipi_csi2.num_data_lanes != IMX563_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "only %u C-PHY trios are supported\n",
+				    IMX563_DATA_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, ep_cfg.link_frequencies,
+				       ep_cfg.nr_of_link_frequencies,
+				       imx563_link_freq_menu,
+				       ARRAY_SIZE(imx563_link_freq_menu),
+				       &link_freq_bitmap);
+
+out:
+	v4l2_fwnode_endpoint_free(&ep_cfg);
+
+	return ret;
+}
+
+static int imx563_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx563 *imx563;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	imx563 = devm_kzalloc(dev, sizeof(*imx563), GFP_KERNEL);
+	if (!imx563)
+		return -ENOMEM;
+
+	imx563->dev = dev;
+
+	v4l2_i2c_subdev_init(&imx563->sd, client, &imx563_subdev_ops);
+	imx563->sd.internal_ops = &imx563_internal_ops;
+
+	ret = imx563_check_hwcfg(imx563);
+	if (ret)
+		return ret;
+
+	imx563->mode = &supported_modes[0];
+
+	imx563->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx563->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx563->regmap),
+				     "failed to initialize CCI\n");
+
+	imx563->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(imx563->xclk))
+		return dev_err_probe(dev, PTR_ERR(imx563->xclk),
+				     "failed to get clock\n");
+
+	freq = clk_get_rate(imx563->xclk);
+	if (freq != IMX563_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock frequency %lu Hz not supported, need %u Hz\n",
+				     freq, IMX563_XCLK_FREQ);
+
+	for (i = 0; i < IMX563_NUM_SUPPLIES; i++)
+		imx563->supplies[i].supply = imx563_supply_name[i];
+
+	ret = devm_regulator_bulk_get(dev, IMX563_NUM_SUPPLIES,
+				      imx563->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* XCLR is active low: request it asserted, the sensor held in reset */
+	imx563->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx563->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx563->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = imx563_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx563_identify_module(imx563);
+	if (ret)
+		goto error_power_off;
+
+	ret = imx563_init_controls(imx563);
+	if (ret)
+		goto error_power_off;
+
+	imx563->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx563->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx563->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx563->sd.entity, 1, &imx563->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto error_handler_free;
+	}
+
+	imx563->sd.state_lock = imx563->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx563->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "subdev init error\n");
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx563->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "failed to register sensor sub-device\n");
+		goto error_subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+error_subdev_cleanup:
+	v4l2_subdev_cleanup(&imx563->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+
+error_media_entity:
+	media_entity_cleanup(&imx563->sd.entity);
+
+error_handler_free:
+	v4l2_ctrl_handler_free(&imx563->ctrl_handler);
+
+error_power_off:
+	imx563_power_off(dev);
+
+	return ret;
+}
+
+static void imx563_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx563 *imx563 = to_imx563(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx563->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		imx563_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
+
+static const struct of_device_id imx563_of_match[] = {
+	{ .compatible = "sony,imx563" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx563_of_match);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx563_pm_ops, imx563_power_off,
+				 imx563_power_on, NULL);
+
+static struct i2c_driver imx563_i2c_driver = {
+	.driver = {
+		.name = "imx563",
+		.of_match_table = imx563_of_match,
+		.pm = pm_ptr(&imx563_pm_ops),
+	},
+	.probe = imx563_probe,
+	.remove = imx563_remove,
+};
+
+module_i2c_driver(imx563_i2c_driver);
