+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX563 image sensor driver
+ *
+ * The register lists come from the IMX563 sensor module that the Samsung
+ * Galaxy Z Flip3 (SM-F711N) ships for its rear wide camera. No datasheet
+ * was used; registers outside the SMIA/CCS standard set are written as the
+ * stock lists write them, without a name.
+ *
+ * Structure follows the imx374 driver.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define IMX563_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX563_CHIP_ID			0x0563
+
+#define IMX563_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX563_MODE_STANDBY		0x00
+#define IMX563_MODE_STREAMING		0x01
+
+#define IMX563_REG_FRM_LENGTH_LINES	CCI_REG16(0x0340)
+
+/*
+ * Exposure in lines. The stock module limits it to 10 lines minimum, to
+ * frame length - 96 and to 65436 lines in total.
+ */
+#define IMX563_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX563_EXPOSURE_MIN		10
+#define IMX563_EXPOSURE_STEP		1
+#define IMX563_EXPOSURE_OFFSET		96
+#define IMX563_EXPOSURE_MAX		65436
+#define IMX563_FLL_MAX			(IMX563_EXPOSURE_MAX + IMX563_EXPOSURE_OFFSET)
+
+/* Analogue gain code: gain = 1024 / (1024 - code), up to 8x */
+#define IMX563_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX563_ANA_GAIN_MIN		0
+#define IMX563_ANA_GAIN_MAX		896
+#define IMX563_ANA_GAIN_STEP		1
+#define IMX563_ANA_GAIN_DEFAULT		0
+
+/*
+ * Digital gain, Q8 (0x100 = 1.0x). Stock's sensor library caps it at
+ * 15.84x.
+ */
+#define IMX563_REG_DIGITAL_GAIN		CCI_REG16(0x020e)
+#define IMX563_DGTL_GAIN_MIN		0x0100
+#define IMX563_DGTL_GAIN_MAX		0x0fd7
+#define IMX563_DGTL_GAIN_STEP		1
+#define IMX563_DGTL_GAIN_DEFAULT	0x0100
+
+/* Test pattern (SMIA/CCS layout) */
+#define IMX563_REG_TP_B000		CCI_REG8(0xb000)
+#define IMX563_REG_TEST_PATTERN		CCI_REG16(0x0600)
+#define IMX563_REG_TESTP_RED		CCI_REG16(0x0602)
+#define IMX563_REG_TESTP_GREENR		CCI_REG16(0x0604)
+#define IMX563_REG_TESTP_BLUE		CCI_REG16(0x0606)
+#define IMX563_REG_TESTP_GREENB		CCI_REG16(0x0608)
+#define IMX563_TESTP_COLOUR_MIN		0
+#define IMX563_TESTP_COLOUR_MAX		0x03ff
+#define IMX563_TESTP_COLOUR_STEP	1
+
+/* The init list programs EXCK for a 19.2 MHz input clock (0x0136) */
+#define IMX563_XCLK_FREQ		19200000
+
+/*
+ * Pixel rate for the timing registers. The VT PLL is the same in every
+ * mode (19.2 MHz / 3 * 322 = 2060.8 MHz), and line length x frame length
+ * x frame rate comes to twice that in every stock mode. This is the rate
+ * that makes line length / pixel rate the line time.
+ *
+ * The CSI-2 output rate is lower: stock gives 1296.864 Mpixel/s for these
+ * modes, which is what three trios at 1896 Msps carry in RAW10.
+ */
+#define IMX563_PIXEL_RATE		4121600000LL
+
+/*
+ * The pixel array, as the stock module gives it. The stock modes read out
+ * the full width (x 0 to 4031) and crop it to 4000 columns digitally.
+ */
+#define IMX563_NATIVE_WIDTH		4032U
+#define IMX563_NATIVE_HEIGHT		3024U
+
+/* Three C-PHY trios */
+#define IMX563_DATA_LANES		3
+
+/*
+ * OP PLL: 19.2 MHz / 0x030d * 0x030e:0x030f / 0x030b = 19.2 / 2 * 395 / 2
+ * = 1896 Msps per trio, the base entry of the stock kernel's adaptive MIPI
+ * table for this sensor. On C-PHY the link frequency is half the symbol
+ * rate.
+ */
+static const s64 imx563_link_freq_menu[] = {
+	948000000,
+};
+
+static const char * const imx563_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+	"Colour Bars With Fade to Grey",
+	"Pseudorandom Sequence (PN9)",
+};
+
+/* In stock's power-up order */
+static const char * const imx563_supply_name[] = {
+	"vcustom",	/* Extra 1.8 V rail, stock's cam_v_custom1 */
+	"vana",		/* Analogue (2.8 V) */
+	"vdig",		/* Digital core (1.1 V) */
+	"vif",		/* Interface (1.8 V) */
+};
+
+#define IMX563_NUM_SUPPLIES ARRAY_SIZE(imx563_supply_name)
+
+/*
+ * The stock module has no flip settings, so the sensor runs unflipped.
+ * Its CFA code for every mode is 3, the code the IMX258 module also gives,
+ * and mainline reports the unflipped IMX258 as RGGB.
+ */
+#define IMX563_MBUS_CODE		MEDIA_BUS_FMT_SRGGB10_1X10
+
+struct imx563_mode {
+	unsigned int width;
+	unsigned int height;
+
+	/* Analogue and digital crop, in native pixel array coordinates */
+	struct v4l2_rect crop;
+
+	/* Line length as the mode list sets it */
+	unsigned int llp;
+
+	/*
+	 * Frame length: the shortest that stock runs the mode list with, and
+	 * the one the list sets.
+	 */
+	unsigned int fll_min;
+	unsigned int fll_def;
+
+	/* Coarse integration time as the mode list sets it */
+	unsigned int exposure_def;
+
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+/*
+ * Register lists, verbatim from the stock module, in stock's order.
+ *
+ * imx563_init_regs is stock's init list, written before any mode list.
+ * It sets the 19.2 MHz EXCK and C-PHY signalling, then a run of
+ * 0xf800-0xf8c3 writes that are left alone.
+ *
+ * Stock has three modes at 1896 Msps, all with the same 95 addresses in
+ * the same order. The 4000x3000 list is stock's mode 0 (30 fps). The
+ * 4000x2252 list is stock's mode 1 (30 fps). Stock's mode 2 (60 fps) is
+ * the same list with a frame length of 4000 lines and the coarse
+ * integration time at 4000 - 96; nothing else differs. Here it is the
+ * 4000x2252 mode with the shortest vertical blanking.
+ *
+ * For each of these modes stock also describes a second RAW10 stream on
+ * virtual channel 1, a quarter of the image height, which looks like PDAF
+ * data. Only the image on virtual channel 0 is described here.
+ *
+ * The HDR mode (0x0220) is off in all three lists, so the short exposure
+ * and gain registers they seed are not driven by any control.
+ */
+
+static const struct cci_reg_sequence imx563_init_regs[] = {
+	{ CCI_REG8(0x0136), 0x13 },	/* EXCK frequency: 19.20 MHz */
+	{ CCI_REG8(0x0137), 0x33 },
+	{ CCI_REG8(0x33f0), 0x03 },
+	{ CCI_REG8(0x33f1), 0x01 },
+	{ CCI_REG8(0x0111), 0x03 },	/* CSI signalling mode: C-PHY */
+	{ CCI_REG8(0xf800), 0x9b },
+	{ CCI_REG8(0xf801), 0x9b },
+	{ CCI_REG8(0xf802), 0xea },
+	{ CCI_REG8(0xf803), 0xdb },
