+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx563.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX563 CMOS Digital Image Sensor
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description:
+  IMX563 is a CMOS active pixel image sensor with a 10-bit RAW Bayer output.
+  It is programmed through I2C and sends image data over a three-trio MIPI
+  CSI-2 C-PHY interface.
+
+$ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx563
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: Input clock (INCK), 19.2 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Reference to the GPIO connected to the XCLR pin, if any.
+    maxItems: 1
+
+  vana-supply:
+    description: Analogue voltage (VANA) supply, 2.8 V.
+
+  vdig-supply:
+    description: Digital core voltage (VDIG) supply, 1.1 V.
+
+  vif-supply:
+    description: Interface voltage (VIF) supply, 1.8 V.
+
+  vcustom-supply:
+    description:
+      An additional 1.8 V supply on the camera module, which the Samsung
+      Galaxy Z Flip3 vendor driver calls cam_v_custom1. Which pins it feeds
+      is not documented. It is enabled first, before VANA, VDIG and VIF, and
+      disabled last.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 1 # MEDIA_BUS_TYPE_CSI2_CPHY
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+
+          link-frequencies: true
+
+        required:
+          - bus-type
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/media/video-interfaces.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "sony,imx563";
+            reg = <0x10>;
+            clocks = <&imx563_clk>;
+            reset-gpios = <&gpio 136 GPIO_ACTIVE_LOW>;
+            vana-supply = <&vana>;
+            vdig-supply = <&vdig>;
+            vif-supply = <&vif>;
+            vcustom-supply = <&vcustom>;
+            orientation = <1>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy0_ep>;
+                    bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+                    data-lanes = <1 2 3>;
+                    link-frequencies = /bits/ 64 <948000000>;
+                };
+            };
+        };
+    };
