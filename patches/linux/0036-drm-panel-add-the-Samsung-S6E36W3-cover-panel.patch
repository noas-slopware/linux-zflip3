From: Noa Himesaka <himesaka@noa.codes>
Subject: [PATCH] drm/panel: add the Samsung S6E36W3 cover panel

The Galaxy Z Flip3 cover display is a 260x512 S6E36W3 AMB190ZB01 on
DSI1: one lane, command mode, 60 Hz, reset GPIO 17 and TE GPIO 83.
The init sequence and porch values are from stock's
ss_dsi_panel_S6E36W3_AMB190ZB01_260X488 node. The command tables are sent
with stock's packet types (0x29 even for short payloads), which the
mipi_dsi write helpers would change, so they go through the host's
transfer op directly.

The panel takes VDD3 from PM8350C L8C and VCI from S2MPB02 LDO11 (3.3 V).
The connector is marked non-desktop: KWin and KScreen must not treat the
cover as a desktop output, and KWin only offers non-desktop connectors
for a DRM lease to the cover daemon.

The backlight is the panel's 8-bit WRDISBV (DCS 0x51), as in stock, so
max_brightness is 255. Stock's 256..510 levels are HBM, which goes
through its own gamma command set and is not ported. The backlight is
handed to the DRM panel core so it is switched off and on with the
panel; brightness writes while the panel is unprepared are skipped, and
a lock keeps them from racing the LPM toggling in the panel callbacks.

Signed-off-by: Noa Himesaka <himesaka@noa.codes>
Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/panel/Kconfig                 |  11 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-samsung-s6e36w3.c | 371 ++++++++++++++++++++++++++
 3 files changed, 383 insertions(+)

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1028,6 +1028,17 @@ config DRM_PANEL_SAMSUNG_S6E3HAD
 	  S6E3HAD DDIC with the AMF670ZA01 panel, the main display of the
 	  Galaxy Z Flip3 (1080x2640, DSC, command mode, 120 Hz).
 
+config DRM_PANEL_SAMSUNG_S6E36W3
+	tristate "Samsung S6E36W3 DSI command mode cover panel"
+	depends on GPIOLIB
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y or M here if you want to enable support for the Samsung
+	  S6E36W3 DDIC with the AMB190ZB01 cover panel of the Galaxy Z
+	  Flip3 (260x512, one DSI lane, command mode, 60 Hz).
+
 config DRM_PANEL_SAMSUNG_S6E3HA8
 	tristate "Samsung S6E3HA8 DSI video mode panel"
 	depends on GPIOLIB
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -99,6 +99,7 @@ obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FA7) += panel-samsung-s6e3fa7.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FC2X01) += panel-samsung-s6e3fc2x01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA2) += panel-samsung-s6e3ha2.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HAD) += panel-samsung-s6e3had.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E36W3) += panel-samsung-s6e36w3.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA8) += panel-samsung-s6e3ha8.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E63J0X03) += panel-samsung-s6e63j0x03.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E63M0) += panel-samsung-s6e63m0.o
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e36w3.c b/drivers/gpu/drm/panel/panel-samsung-s6e36w3.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e36w3.c
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E36W3 AMB190ZB01 cover panel (260x512, one DSI lane, command mode)
+ *
+ * Timing and command set from stock's
+ * ss_dsi_panel_S6E36W3_AMB190ZB01_260X488 node (dtbo entry.3).
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
+#include <video/mipi_display.h>
+
+#include <drm/drm_device.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct s6e36w3 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset;
+	/*
+	 * Serialises the panel callbacks against backlight updates: both
+	 * toggle MIPI_DSI_MODE_LPM, and a brightness write must not reach a
+	 * panel that is unpowered.
+	 */
+	struct mutex lock;
+	bool prepared;
+};
+
+struct s6e36w3_cmd {
+	u8 type;
+	u8 wait;
+	u16 len;
+	const u8 *data;
+};
+
+#define S6E36W3_CMD(_type, _wait, ...) {				\
+	.type = _type, .wait = _wait,					\
+	.len = sizeof((const u8[]){ __VA_ARGS__ }),			\
+	.data = (const u8[]){ __VA_ARGS__ },				\
+}
+
+static const struct s6e36w3_cmd s6e36w3_on_cmds[] = {
+	S6E36W3_CMD(0x29, 0, 0xf0, 0x5a, 0x5a),
+	S6E36W3_CMD(0x05, 20, 0x11),
+	S6E36W3_CMD(0x29, 0, 0x35, 0x00),
+	S6E36W3_CMD(0x29, 0, 0x2a, 0x00, 0x00, 0x01, 0x03),
+	S6E36W3_CMD(0x29, 0, 0x2b, 0x00, 0x00, 0x01, 0xff),
+	S6E36W3_CMD(0x29, 0, 0xb0, 0x1f, 0xb5),
+	S6E36W3_CMD(0x29, 0, 0xb5, 0x00, 0x00),
+	S6E36W3_CMD(0x29, 0, 0xf6, 0x16),
+	S6E36W3_CMD(0x29, 0, 0xfd, 0x88, 0x05, 0x3e, 0x80, 0x0a, 0x00, 0xec,
+		    0x25, 0x00, 0x00, 0x0a, 0xaa, 0x44, 0xd0),
+	S6E36W3_CMD(0x29, 0, 0x53, 0x20),
+	S6E36W3_CMD(0x29, 0, 0xb5, 0x19, 0xcd, 0x0a),
+	S6E36W3_CMD(0x29, 0, 0x51, 0xff),
+	S6E36W3_CMD(0x29, 0, 0xf7, 0x03),
+	S6E36W3_CMD(0x29, 0, 0xf0, 0xa5, 0xa5),
+};
+
+static const struct s6e36w3_cmd s6e36w3_off_cmds[] = {
+	S6E36W3_CMD(0x05, 1, 0x28),
+	S6E36W3_CMD(0x05, 120, 0x10),
+};
+
+static inline struct s6e36w3 *to_s6e36w3(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e36w3, panel);
+}
+
+/*
+ * Sends the stock command tables with their packet types as they are (0x29
+ * generic long write even for two-byte payloads, 0x05 DCS short write). The
+ * mipi_dsi helpers pick the type from the length (0x23 / 0x39), which is not
+ * what this DDIC was verified with.
+ */
+static int s6e36w3_send(struct s6e36w3 *ctx, const struct s6e36w3_cmd *cmds, int count)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	int i;
+
+	if (!dsi->host || !dsi->host->ops || !dsi->host->ops->transfer)
+		return -ENODEV;
+
+	for (i = 0; i < count; i++) {
+		const struct s6e36w3_cmd *c = &cmds[i];
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = c->type,
+			.tx_buf = c->data,
+			.tx_len = c->len,
+		};
+		ssize_t ret;
+
+		if (dsi->mode_flags & MIPI_DSI_MODE_LPM)
+			msg.flags |= MIPI_DSI_MSG_USE_LPM;
+
+		ret = dsi->host->ops->transfer(dsi->host, &msg);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "failed to send %02x: %zd\n",
+				c->data[0], ret);
+			return ret;
+		}
+
+		if (c->wait)
+			msleep(c->wait);
+	}
+
+	return 0;
+}
+
+static int s6e36w3_bl_update_status(struct backlight_device *bl)
+{
+	struct s6e36w3 *ctx = bl_get_data(bl);
+	/* WRDISBV is one byte here, as in stock (gm2_wrdisbv & 0xff). */
+	u8 value = backlight_get_brightness(bl);
+	unsigned long flags;
+	int ret;
+
+	guard(mutex)(&ctx->lock);
+
+	/*
+	 * The panel is off: nothing to write. The DRM core calls
+	 * backlight_enable() after the panel is enabled again, which brings
+	 * the current brightness back.
+	 */
+	if (!ctx->prepared)
+		return 0;
+
+	flags = ctx->dsi->mode_flags;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_write(ctx->dsi, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				 &value, sizeof(value));
+	ctx->dsi->mode_flags = flags;
+
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops s6e36w3_bl_ops = {
+	.update_status = s6e36w3_bl_update_status,
+};
+
+static int s6e36w3_prepare(struct drm_panel *panel)
+{
+	struct s6e36w3 *ctx = to_s6e36w3(panel);
+	int ret;
+
+	guard(mutex)(&ctx->lock);
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret)
+		return ret;
+
+	/* Active-low reset: assert first, then release and keep it released. */
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(5);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(10);
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	ret = s6e36w3_send(ctx, s6e36w3_on_cmds, ARRAY_SIZE(s6e36w3_on_cmds));
+	if (ret)
+		goto err_reset;
+
+	ctx->prepared = true;
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	return ret;
+}
+
+static int s6e36w3_enable(struct drm_panel *panel)
+{
+	struct s6e36w3 *ctx = to_s6e36w3(panel);
+	int ret;
+
+	guard(mutex)(&ctx->lock);
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_on(ctx->dsi);
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret < 0 ? ret : 0;
+}
+
+static int s6e36w3_disable(struct drm_panel *panel)
+{
+	struct s6e36w3 *ctx = to_s6e36w3(panel);
+	int ret;
+
+	guard(mutex)(&ctx->lock);
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_off(ctx->dsi);
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret < 0 ? ret : 0;
+}
+
+static int s6e36w3_unprepare(struct drm_panel *panel)
+{
+	struct s6e36w3 *ctx = to_s6e36w3(panel);
+	int ret;
+
+	guard(mutex)(&ctx->lock);
+
+	ctx->prepared = false;
+
+	ret = s6e36w3_send(ctx, s6e36w3_off_cmds, ARRAY_SIZE(s6e36w3_off_cmds));
+	if (ret)
+		dev_err(&ctx->dsi->dev, "failed to send off commands: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	return 0;
+}
+
+static int s6e36w3_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+	static const struct drm_display_mode default_mode = {
+		/* 260x512 at 60 Hz, 40-pixel porches as stock. */
+		.clock = (260 + 40 + 40 + 40) * (512 + 40 + 40 + 40) * 60 / 1000,
+		.hdisplay = 260,
+		.hsync_start = 260 + 40,
+		.hsync_end = 260 + 40 + 40,
+		.htotal = 260 + 40 + 40 + 40,
+		.vdisplay = 512,
+		.vsync_start = 512 + 40,
+		.vsync_end = 512 + 40 + 40,
+		.vtotal = 512 + 40 + 40 + 40,
+		.width_mm = 44,
+		.height_mm = 23,
+		.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+	};
+
+	/*
+	 * This is not a desktop output. Marking it non-desktop keeps KWin and
+	 * KScreen away from it and lets the cover daemon get it through a DRM
+	 * lease (KWin only offers non-desktop connectors for lease).
+	 */
+	connector->display_info.non_desktop = true;
+	drm_object_property_set_value(&connector->base,
+				      connector->dev->mode_config.non_desktop_property,
+				      connector->display_info.non_desktop);
+
+	mode = drm_mode_duplicate(connector->dev, &default_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs s6e36w3_panel_funcs = {
+	.prepare = s6e36w3_prepare,
+	.enable = s6e36w3_enable,
+	.disable = s6e36w3_disable,
+	.unprepare = s6e36w3_unprepare,
+	.get_modes = s6e36w3_get_modes,
+};
+
+static int s6e36w3_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e36w3 *ctx;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		/*
+		 * Stock's 256..510 range is HBM, reached through its own gamma
+		 * command set that is not ported; WRDISBV itself is 8 bits.
+		 */
+		.max_brightness = 0xff,
+		.brightness = 0xff,
+	};
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e36w3, panel,
+				   &s6e36w3_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ret = devm_mutex_init(dev, &ctx->lock);
+	if (ret)
+		return ret;
+
+	ctx->supplies[0].supply = "vdd3";
+	ctx->supplies[1].supply = "vci";
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset),
+				     "failed to get reset GPIO\n");
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+							     dev, ctx,
+							     &s6e36w3_bl_ops,
+							     &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "failed to register backlight\n");
+
+	dsi->lanes = 1;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void s6e36w3_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e36w3 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e36w3_of_match[] = {
+	{ .compatible = "samsung,s6e36w3-amb190zb01" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s6e36w3_of_match);
+
+static struct mipi_dsi_driver s6e36w3_driver = {
+	.probe = s6e36w3_probe,
+	.remove = s6e36w3_remove,
+	.driver = {
+		.name = "panel-samsung-s6e36w3",
+		.of_match_table = s6e36w3_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e36w3_driver);
+
+MODULE_AUTHOR("Noa Himesaka <himesaka@noa.codes>");
+MODULE_DESCRIPTION("Samsung S6E36W3 AMB190ZB01 cover panel");
+MODULE_LICENSE("GPL");
