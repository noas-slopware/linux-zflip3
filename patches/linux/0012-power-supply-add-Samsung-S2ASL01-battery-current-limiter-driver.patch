+static const struct attribute_group s2asl01_attr_group = {
+	.attrs = s2asl01_attrs,
+};
+
+static const struct attribute_group *s2asl01_attr_groups[] = {
+	&s2asl01_attr_group,
+	NULL,
+};
+
+static int s2asl01_parse_dt(struct s2asl01_chip *chip)
+{
+	struct device *dev = chip->dev;
+	struct device_node *np = dev_of_node(dev);
+	const char *cell;
+	unsigned int val;
+	unsigned int i;
+	int ret;
+
+	ret = of_property_read_string(np, "samsung,cell", &cell);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing samsung,cell\n");
+
+	if (!strcmp(cell, "main")) {
+		chip->psy_name = "s2asl01-limiter-main";
+	} else if (!strcmp(cell, "sub")) {
+		chip->psy_name = "s2asl01-limiter-sub";
+	} else {
+		return dev_err_probe(dev, -EINVAL, "bad samsung,cell \"%s\"\n",
+				     cell);
+	}
+
+	ret = of_property_read_u32(np, "samsung,charge-current-limit-microamp",
+				   &val);
+	chip->charge_current_ua = ret ? S2ASL01_DEFAULT_CHARGE_CURRENT_UA : val;
+
+	ret = of_property_read_u32(np, "samsung,eoc-current-microamp", &val);
+	chip->eoc_current_ua = ret ? S2ASL01_DEFAULT_EOC_CURRENT_UA : val;
+
+	ret = of_property_read_u32(np, "samsung,eoc-voltage-microvolt", &val);
+	chip->eoc_voltage_uv = ret ? S2ASL01_DEFAULT_EOC_VOLTAGE_UV : val;
+
+	ret = of_property_read_u32_array(np,
+					 "samsung,powermeter-hysteresis-levels",
+					 chip->hyst_levels, 4);
+	if (ret) {
+		chip->hyst_levels[0] = S2ASL01_DEFAULT_HYST_LEVEL;
+		chip->hyst_levels[1] = S2ASL01_DEFAULT_HYST_LEVEL;
+		chip->hyst_levels[2] = S2ASL01_DEFAULT_HYST_LEVEL;
+		chip->hyst_levels[3] = S2ASL01_DEFAULT_HYST_LEVEL;
+	} else {
+		for (i = 0; i < ARRAY_SIZE(chip->hyst_levels); i++) {
+			if (chip->hyst_levels[i] > 7)
+				return dev_err_probe(dev, -EINVAL,
+						     "hysteresis level %u out of range\n",
+						     chip->hyst_levels[i]);
+		}
+	}
+
+	chip->fully_on_at_init =
+		of_property_read_bool(np, "samsung,charge-current-fully-turn-on");
+	chip->tsd_enable =
+		of_property_read_bool(np, "samsung,thermal-shutdown-enable");
+
+	return 0;
+}
+
+/* ID register: bit 0 is the IC generation, 7:6 the ES number, 5:4 the revision */
+static int s2asl01_read_id(struct s2asl01_chip *chip)
+{
+	unsigned int id;
+	int ret;
+
+	ret = regmap_read(chip->regmap, S2ASL01_REG_ID, &id);
+	if (ret)
+		return ret;
+
+	chip->ic_version = (id & 0x01) ? S2ASL01_VER_6130 : S2ASL01_VER_6030;
+	chip->es_num = (id & 0xc0) >> 6;
+	chip->rev_id = (id & 0x30) >> 4;
+
+	dev_info(chip->dev, "ID 0x%02x: revision %u, ES %u, IC %s\n", id,
+		 chip->rev_id, chip->es_num,
+		 chip->ic_version == S2ASL01_VER_6130 ? "6130" : "6030");
+
+	return 0;
+}
+
+static int s2asl01_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s2asl01_chip *chip;
+	struct power_supply_config psy_cfg = {};
+	int ret;
+
+	chip = devm_kzalloc(dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+
+	chip->dev = dev;
+	i2c_set_clientdata(client, chip);
+
+	chip->regmap = devm_regmap_init_i2c(client, &s2asl01_regmap_config);
+	if (IS_ERR(chip->regmap))
+		return dev_err_probe(dev, PTR_ERR(chip->regmap),
+				     "cannot set up the register map\n");
+
+	ret = s2asl01_parse_dt(chip);
+	if (ret)
+		return ret;
+
+	/* Detection and enable pins are only ever read, as in stock */
+	chip->det_gpio = devm_gpiod_get_optional(dev, "battery-detect",
+						 GPIOD_IN);
+	if (IS_ERR(chip->det_gpio))
+		return dev_err_probe(dev, PTR_ERR(chip->det_gpio),
+				     "cannot get the battery detect GPIO\n");
+
+	chip->enb_gpio = devm_gpiod_get_optional(dev, "battery-enable",
+						 GPIOD_ASIS);
+	if (IS_ERR(chip->enb_gpio))
+		return dev_err_probe(dev, PTR_ERR(chip->enb_gpio),
+				     "cannot get the battery enable GPIO\n");
+
+	chip->enb2_gpio = devm_gpiod_get_optional(dev, "battery-enable2",
+						  GPIOD_ASIS);
+	if (IS_ERR(chip->enb2_gpio))
+		return dev_err_probe(dev, PTR_ERR(chip->enb2_gpio),
+				     "cannot get the second battery enable GPIO\n");
+
+	ret = s2asl01_read_id(chip);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot read the ID register\n");
+
+	/*
+	 * Unlike stock, which initialises after registering the power supply,
+	 * program the chip first: nothing should be able to read a half
+	 * configured limiter.
+	 */
+	ret = s2asl01_init_hw(chip);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot initialise the limiter\n");
+
+	chip->psy_desc.name = chip->psy_name;
+	chip->psy_desc.type = POWER_SUPPLY_TYPE_UNKNOWN;
+	chip->psy_desc.properties = s2asl01_props;
+	chip->psy_desc.num_properties = ARRAY_SIZE(s2asl01_props);
+	chip->psy_desc.get_property = s2asl01_get_property;
+	chip->psy_desc.no_thermal = true;
+
+	psy_cfg.drv_data = chip;
+	psy_cfg.fwnode = dev_fwnode(dev);
+	psy_cfg.attr_grp = s2asl01_attr_groups;
+
+	chip->psy = devm_power_supply_register(dev, &chip->psy_desc, &psy_cfg);
+	if (IS_ERR(chip->psy))
+		return dev_err_probe(dev, PTR_ERR(chip->psy),
+				     "cannot register %s\n", chip->psy_name);
+
+	if (chip->det_gpio)
+		dev_info(dev, "%s: battery %s\n", chip->psy_name,
+			 gpiod_get_value_cansleep(chip->det_gpio) ?
+			 "connected" : "not connected");
+	else
+		dev_info(dev, "%s: registered\n", chip->psy_name);
+
+	return 0;
+}
+
