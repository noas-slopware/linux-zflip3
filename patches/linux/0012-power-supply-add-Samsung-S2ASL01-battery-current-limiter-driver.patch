+	&dev_attr_trickle_charge_current_limit.attr,
+	&dev_attr_discharge_current_limit.attr,
+	&dev_attr_recharge_voltage.attr,
+	&dev_attr_eoc_voltage.attr,
+	&dev_attr_eoc_current.attr,
+	&dev_attr_charge_mode.attr,
+	&dev_attr_discharge_mode.attr,
+	&dev_attr_chgin_ok.attr,
+	&dev_attr_supplement_mode.attr,
+	&dev_attr_powermeter_enable.attr,
+	&dev_attr_input_voltage.attr,
+	&dev_attr_discharge_current.attr,
+	&dev_attr_battery_detect.attr,
+	&dev_attr_battery_enable.attr,
+	&dev_attr_limiter_data.attr,
+	NULL,
+};
