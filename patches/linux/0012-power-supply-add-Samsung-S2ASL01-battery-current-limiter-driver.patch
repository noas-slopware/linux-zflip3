+static struct i2c_driver s2asl01_driver = {
+	.driver = {
+		.name = "s2asl01-limiter",
+		.of_match_table = s2asl01_of_match,
+	},
+	.probe = s2asl01_probe,
+	.id_table = s2asl01_i2c_id,
+};
+module_i2c_driver(s2asl01_driver);
