 #define S6E3HAD_BRIGHTNESS_MAX		0x7ff
 
+/* A gamma set: 14 points of R, G and B, five register bytes per point */
+#define S6E3HAD_GAMMA_POINTS		14
+#define S6E3HAD_GAMMA_R_SIZE		(S6E3HAD_GAMMA_POINTS * 5)
+#define S6E3HAD_GAMMA_V_SIZE		(S6E3HAD_GAMMA_POINTS * 3)
+/* The 96/48 Hz offsets touch V values 18 to 35 only */
+#define S6E3HAD_GAMMA_OFS_FIRST		18
+#define S6E3HAD_GAMMA_OFS_COUNT		18
+/* samsung,flash_table_normal_gamma_offset: the HS120 normal gamma */
+#define S6E3HAD_FLASH_NORMAL_GAMMA	0x0d15be
+
 struct s6e3had {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi;
@@ -37,6 +48,13 @@ struct s6e3had {
 	struct regulator_bulk_data *supplies;
 	struct drm_connector *connector;
 	const struct s6e3had_timing *timing;
+
+	/* The HS120 normal gamma from the panel's flash, as V values */
+	u16 gamma_v[S6E3HAD_GAMMA_V_SIZE];
+	bool gamma_read;
+	bool gamma_valid;
+	/* Stock's cur_br_mode: the last brightness packet compensated 96/48 Hz */
+	bool comp_prev;
 };
 
 /* Stock order and delays: vdd3, vddr, then vci and 11 ms. */
@@ -70,6 +88,12 @@ struct s6e3had_cmd {
 	.data = (const u8[]){ __VA_ARGS__ },				\
 }
 
+/* A packet whose payload is built at run time */
+#define S6E3HAD_BUF(_type, _last, _wait, _buf) {			\
+	.type = _type, .last = _last, .wait = _wait,			\
+	.len = sizeof(_buf), .data = _buf,				\
+}
