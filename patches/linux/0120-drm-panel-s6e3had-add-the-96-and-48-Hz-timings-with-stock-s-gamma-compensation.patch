+/*
+ * ss_gm2_gamma_comp_init()'s gamma layout: each point is the high bits of R,
+ * the high bits of G and B, then the low bytes of R, G and B. The first and
+ * last points have 12 bits per colour, the others 11.
+ */
+static u8 s6e3had_gamma_high_mask(int point)
+{
+	return (point == 0 || point == S6E3HAD_GAMMA_POINTS - 1) ? 0x0f : 0x07;
