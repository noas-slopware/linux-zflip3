+
+static bool s6e3had_gamma_r_to_v(const u8 *r, u16 *v)
+{
+	int p;
+
+	for (p = 0; p < S6E3HAD_GAMMA_POINTS; p++, r += 5, v += 3) {
+		u8 hi = s6e3had_gamma_high_mask(p);
+
+		/* The bits above each colour's width are zero in a good read */
+		if ((r[0] & ~hi) || (r[1] & ~(hi << 4 | hi)))
+			return false;
+
+		v[0] = (r[0] & hi) << 8 | r[2];
+		v[1] = (r[1] >> 4 & hi) << 8 | r[3];
+		v[2] = (r[1] & hi) << 8 | r[4];
+	}
+
+	return true;
+}
+
+static void s6e3had_gamma_v_to_r(const u16 *v, u8 *r)
+{
+	int p;
+
+	for (p = 0; p < S6E3HAD_GAMMA_POINTS; p++, r += 5, v += 3) {
+		u8 hi = s6e3had_gamma_high_mask(p);
+
+		r[0] = v[0] >> 8 & hi;
+		r[1] = (v[1] >> 8 & hi) << 4 | (v[2] >> 8 & hi);
+		r[2] = v[0] & 0xff;
+		r[3] = v[1] & 0xff;
+		r[4] = v[2] & 0xff;
+	}
