+	ret = s6e3had_send_set(ctx, s6e3had_flash_pre_cmds);
+	if (!ret)
+		ret = s6e3had_send_set(ctx, flash_read_cmds);
+	if (!ret) {
+		usleep_range(10000, 11000);
+		len = dsi->host->ops->transfer(dsi->host, &msg);
+	}
+	/* The post set locks the keys again, so it goes out whatever happened */
+	s6e3had_send_set(ctx, s6e3had_flash_post_cmds);
+
+	dsi->mode_flags = flags;
+
+	if (ret || len != sizeof(r)) {
+		dev_warn(dev, "no gamma for 96/48 Hz: flash read failed (%d, %zd)\n", ret, len);
+		return;
+	}
+
+	dev_info(dev, "HS120 gamma: %*ph\n", 35, r);
+	dev_info(dev, "HS120 gamma: %*ph\n", 35, r + 35);
+
+	if (!memchr_inv(r, 0, sizeof(r)) || !s6e3had_gamma_r_to_v(r, ctx->gamma_v)) {
+		dev_warn(dev, "no gamma for 96/48 Hz: the flash read does not look like gamma\n");
+		return;
+	}
