+/*
+ * ss_gm2_gamma_comp_init(): read the HS120 normal gamma from the panel's flash
+ * through the DDI (TX_FLASH_GAMMA_PRE1, flash_read_bytes(), TX_FLASH_GAMMA_POST),
+ * in HS as stock sends it. 96 and 48 Hz run without the compensation if this
+ * fails.
+ */
+static void s6e3had_read_gamma(struct s6e3had *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
+	/* samsung,flash_gamma_tx_cmds_revA: 6Bh at the address, 0xc00000 | size */
+	u8 flash_read[] = {
+		0xc1, 0x00, 0x00, 0x6b,
+		(S6E3HAD_FLASH_NORMAL_GAMMA >> 16) & 0xff,
+		(S6E3HAD_FLASH_NORMAL_GAMMA >> 8) & 0xff,
+		S6E3HAD_FLASH_NORMAL_GAMMA & 0xff,
+		0xc0, 0x00, S6E3HAD_GAMMA_R_SIZE,
+	};
+	const struct s6e3had_cmd flash_read_cmds[] = {
+		S6E3HAD_BUF(0x39, 1, 0, flash_read),
+		S6E3HAD_CMD(0x39, 1, 0, 0xc0, 0x03),
+	};
+	static const u8 rx_cmd = 0x6e;	/* samsung,flash_gamma_rx_cmds_revA */
+	u8 r[S6E3HAD_GAMMA_R_SIZE];
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.type = MIPI_DSI_DCS_READ,
+		.tx_buf = &rx_cmd,
+		.tx_len = 1,
+		.rx_buf = r,
+		.rx_len = sizeof(r),
+	};
+	unsigned long flags = dsi->mode_flags;
+	ssize_t len = 0;
+	int ret;
