From: Noa Himesaka <himesaka@noa.codes>
Subject: [PATCH] power: supply: add Samsung dual cell battery charging

Samsung's sec_battery and sec_dual_battery charge the Galaxy Z Flip3's
two cells through two S2ASL01 limiters: the charge current is split by
zone, the first full stage ends on fuel gauge current and voltage, the
second ends when each cell reaches its full voltage at its end of
charge current (supplement mode for a full cell, forced 30 minutes
after the first), the charger then stops with its buck on, and charging
restarts by the limiter recharge condition. Without a charger both
cells balance. Checked on charger changes and every 30 s with a
charger attached, as stock polls.

Signed-off-by: Noa Himesaka <himesaka@noa.codes>
---
diff --git a/Documentation/devicetree/bindings/power/supply/samsung,dual-battery.yaml b/Documentation/devicetree/bindings/power/supply/samsung,dual-battery.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/samsung,dual-battery.yaml
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/samsung,dual-battery.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung dual cell battery charging
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description:
+  A battery made of two cells, each behind its own current limiter, charged
+  by one charger as Samsung phones such as the Galaxy Z Flip3 do it. The
+  charge current is split between the cells by zone, a cell that reaches
+  its full voltage at its end of charge current is taken out of charging,
+  the charger stops once both are full, and charging restarts when the
+  higher cell falls to the recharge voltage or the cells drift apart.
+
+properties:
+  compatible:
+    const: samsung,dual-battery
+
+  samsung,charger:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The charger, with charge_behaviour and constant charge current.
+
+  samsung,fuel-gauge:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The fuel gauge of the pack.
+
+  samsung,main-limiter:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The main cell's current limiter.
+
+  samsung,sub-limiter:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The sub cell's current limiter.
+
+  samsung,zone-current-rates-percent:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      Share of the charge current for the main and the sub cell, in percent,
+      for charge currents up to 1.2 A, up to 3 A and above.
+    items:
+      - description: zone 1, main
+      - description: zone 1, sub
+      - description: zone 2, main
+      - description: zone 2, sub
+      - description: zone 3, main
+      - description: zone 3, sub
+
+  samsung,limiter-current-range-microamp:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - description: main cell minimum
+      - description: main cell maximum
+      - description: sub cell minimum
+      - description: sub cell maximum
+
+  samsung,cell-full-microvolt:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - description: main cell
+      - description: sub cell
+
+  samsung,cell-eoc-microamp:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    items:
+      - description: main cell end of charge current
+      - description: sub cell end of charge current
+
+  samsung,full-check-current-microamp:
+    description: Pack current below which the first full stage ends.
+
+  samsung,full-condition-microvolt:
+    description: Pack voltage the first full stage needs.
+
+  samsung,recharge-microvolt:
+    description: Higher cell voltage at or below which charging restarts.
+
+  samsung,force-recharge-margin-microvolt:
+    description: Cell voltage difference above which charging restarts.
+
+required:
+  - compatible
+  - samsung,charger
+  - samsung,fuel-gauge
+  - samsung,main-limiter
+  - samsung,sub-limiter
+  - samsung,zone-current-rates-percent
+  - samsung,limiter-current-range-microamp
+  - samsung,cell-full-microvolt
+  - samsung,cell-eoc-microamp
+  - samsung,full-check-current-microamp
+  - samsung,full-condition-microvolt
+  - samsung,recharge-microvolt
+  - samsung,force-recharge-margin-microvolt
+
+additionalProperties: false
+
+examples:
+  - |
+    dual-battery {
+        compatible = "samsung,dual-battery";
+        samsung,charger = <&charger>;
+        samsung,fuel-gauge = <&fuel_gauge>;
+        samsung,main-limiter = <&limiter_main>;
+        samsung,sub-limiter = <&limiter_sub>;
+        samsung,zone-current-rates-percent = <40 85 33 77 46 60>;
+        samsung,limiter-current-range-microamp = <0 3150000 200000 3150000>;
+        samsung,cell-full-microvolt = <4400000 4400000>;
+        samsung,cell-eoc-microamp = <45000 115000>;
+        samsung,full-check-current-microamp = <480000>;
+        samsung,full-condition-microvolt = <4390000>;
+        samsung,recharge-microvolt = <4350000>;
+        samsung,force-recharge-margin-microvolt = <140000>;
+    };
