 	  Say Y to include support for Rockchip RK817 Battery Charger.
 
+config BATTERY_SAMSUNG_DUAL
+	tristate "Samsung dual cell battery charging"
+	depends on OF
+	help
+	  Charging of a battery made of two cells behind two current
+	  limiters, as Samsung phones such as the Galaxy Z Flip3 do it:
+	  the charge current is split between the cells, each cell is
+	  taken out of charging when it is full, and charging restarts
+	  when the cells need it.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called samsung-dual-battery.
+
 config CHARGER_S2ASL01
 	tristate "Samsung S2ASL01 battery current limiter"
 	depends on I2C
diff --git a/drivers/power/supply/Makefile b/drivers/power/supply/Makefile
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -108,6 +108,7 @@ obj-$(CONFIG_CHARGER_BQ25980)	+= bq25980_charger.o
 obj-$(CONFIG_CHARGER_BQ25630)	+= bq25630_charger.o
 obj-$(CONFIG_CHARGER_BQ256XX)	+= bq256xx_charger.o
 obj-$(CONFIG_CHARGER_RK817)	+= rk817_charger.o
+obj-$(CONFIG_BATTERY_SAMSUNG_DUAL)	+= samsung-dual-battery.o
 obj-$(CONFIG_CHARGER_S2ASL01)	+= s2asl01_limiter.o
