From: Noa Himesaka <himesaka@noa.codes>
Subject: [PATCH] rpmsg: qcom: add the GLINK edge to the secure processor (SPSS)

On SM8350 the boot firmware starts the secure processor (SPSS) and its
apps; the application processor reaches them over one GLINK edge whose
FIFOs live in SMEM item 478 of host SPSS: a descriptor with head, tail and
size per direction, followed by a 2 KiB TX and a 2 KiB RX FIFO. The SPSS
finds them through two registers in its address space that the
application processor fills in with the descriptor's address and size,
and both sides signal over the IPCC (client SPSS, signal GLINK_QMP).

Port the downstream qcom_glink_spss transport onto qcom_glink_native as a
standalone platform driver, since there is no SPSS remoteproc to hang it
off, and describe the edge in sm8350.dtsi.

On the Galaxy Z Flip3 the SPSS answers with the channels cryptoapp,
glink_ssr, sec_nvm_sp_nvm, sp_kernel, sp_keymaster, sp_nvm and sp_qfprom.

Signed-off-by: Noa Himesaka <himesaka@noa.codes>
Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350.dtsi |   12 +
 drivers/rpmsg/Kconfig                |   10 +
 drivers/rpmsg/Makefile               |    1 
 drivers/rpmsg/qcom_glink_spss.c      |  286 ++++++++++++++++++++++++++++++++++
 4 files changed, 309 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350.dtsi b/arch/arm64/boot/dts/qcom/sm8350.dtsi
index e3cca5a..8eadbda 100644
--- a/arch/arm64/boot/dts/qcom/sm8350.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8350.dtsi
@@ -707,6 +707,18 @@
 				 <0>;
 		};
 
+		/* GLINK edge to the secure processor, started by the boot firmware */
+		glink-edge@1885008 {
+			compatible = "qcom,glink-spss";
+			reg = <0x0 0x01885008 0x0 0x8>, <0x0 0x01885010 0x0 0x4>;
+			reg-names = "spss-addr", "spss-size";
+			interrupts-extended = <&ipcc IPCC_CLIENT_SPSS IPCC_MPROC_SIGNAL_GLINK_QMP
+						     IRQ_TYPE_LEVEL_HIGH>;
+			mboxes = <&ipcc IPCC_CLIENT_SPSS IPCC_MPROC_SIGNAL_GLINK_QMP>;
+			qcom,remote-pid = <8>;
+			label = "spss";
+		};
+
 		ipcc: mailbox@408000 {
 			compatible = "qcom,sm8350-ipcc", "qcom,ipcc";
 			reg = <0 0x00408000 0 0x1000>;
diff --git a/drivers/rpmsg/Kconfig b/drivers/rpmsg/Kconfig
index d379586..6efbac1 100644
--- a/drivers/rpmsg/Kconfig
+++ b/drivers/rpmsg/Kconfig
@@ -64,6 +64,16 @@ config RPMSG_QCOM_GLINK_SMEM
 	  which provides support for using the GLINK communication protocol
 	  over SMEM.
 
+config RPMSG_QCOM_GLINK_SPSS
+	tristate "Qualcomm GLINK edge to the secure processor (SPSS)"
+	select RPMSG_QCOM_GLINK
+	depends on MAILBOX
+	depends on QCOM_SMEM
+	help
+	  Say y or m here to talk GLINK to the SPSS that the boot firmware
+	  started on SoCs such as SM8350: its apps (keymaster, crypto, NVM
+	  service) then appear as rpmsg channels.
+
 config RPMSG_QCOM_SMD
 	tristate "Qualcomm Shared Memory Driver (SMD)"
 	depends on MAILBOX
diff --git a/drivers/rpmsg/Makefile b/drivers/rpmsg/Makefile
index 1e02b58..e4a5362 100644
--- a/drivers/rpmsg/Makefile
+++ b/drivers/rpmsg/Makefile
@@ -9,5 +9,6 @@ qcom_glink-objs			:= qcom_glink_native.o qcom_glink_ssr.o
 obj-$(CONFIG_RPMSG_QCOM_GLINK) += qcom_glink.o
 obj-$(CONFIG_RPMSG_QCOM_GLINK_RPM) += qcom_glink_rpm.o
 obj-$(CONFIG_RPMSG_QCOM_GLINK_SMEM) += qcom_glink_smem.o
+obj-$(CONFIG_RPMSG_QCOM_GLINK_SPSS) += qcom_glink_spss.o
 obj-$(CONFIG_RPMSG_QCOM_SMD)	+= qcom_smd.o
 obj-$(CONFIG_RPMSG_VIRTIO)	+= virtio_rpmsg_bus.o
diff --git a/drivers/rpmsg/qcom_glink_spss.c b/drivers/rpmsg/qcom_glink_spss.c
new file mode 100644
index 0000000..661166b
--- /dev/null
+++ b/drivers/rpmsg/qcom_glink_spss.c
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * GLINK edge to the Qualcomm secure processor (SPSS).
+ *
+ * The SPSS is started by the boot firmware and runs on its own; the
+ * application processor talks to it over one GLINK edge whose FIFOs live in
+ * SMEM item 478 of host SPSS: a small descriptor (head/tail/size per
+ * direction) followed by a 2 KiB TX and a 2 KiB RX FIFO. The SPSS learns
+ * where that is from two registers in its address space that the
+ * application processor writes, and both sides signal each other through
+ * the IPCC (client SPSS, signal GLINK_QMP).
+ *
+ * Based on the downstream qcom_glink_spss.c (The Linux Foundation); here it
+ * is a standalone platform driver, as there is no SPSS remoteproc.
+ */
+
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mailbox_client.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/rpmsg/qcom_glink.h>
+#include <linux/sizes.h>
+#include <linux/soc/qcom/smem.h>
+
+#include "qcom_glink_native.h"
+
+#define FIFO_FULL_RESERVE		8
+#define TX_BLOCKED_CMD_RESERVE		8	/* struct read_notif_request */
+#define SMEM_GLINK_NATIVE_XPRT_DESCRIPTOR	478
+#define SPSS_TX_FIFO_SIZE		SZ_2K
+#define SPSS_RX_FIFO_SIZE		SZ_2K
+
+struct glink_spss_cfg {
+	__le32 tx_tail;
+	__le32 tx_head;
+	__le32 tx_fifo_size;
+	__le32 rx_tail;
+	__le32 rx_head;
+	__le32 rx_fifo_size;
+};
+
+struct glink_spss;
+
+struct glink_spss_pipe {
+	struct qcom_glink_pipe native;
+	__le32 *tail;
+	__le32 *head;
+	void *fifo;
+	struct glink_spss *spss;
+};
+
+struct glink_spss {
+	struct device *dev;
+	struct qcom_glink *glink;
+	struct glink_spss_pipe rx, tx;
+	struct mbox_client mbox_client;
+	struct mbox_chan *mbox_chan;
+	int irq;
+};
+
+#define to_spss_pipe(p) container_of(p, struct glink_spss_pipe, native)
+
+static size_t glink_spss_rx_avail(struct qcom_glink_pipe *np)
+{
+	struct glink_spss_pipe *pipe = to_spss_pipe(np);
+	u32 head = le32_to_cpu(READ_ONCE(*pipe->head));
+	u32 tail = le32_to_cpu(READ_ONCE(*pipe->tail));
+
+	return head < tail ? pipe->native.length - tail + head : head - tail;
+}
+
+static void glink_spss_rx_peek(struct qcom_glink_pipe *np, void *data,
+			       unsigned int offset, size_t count)
+{
+	struct glink_spss_pipe *pipe = to_spss_pipe(np);
+	u32 tail = le32_to_cpu(READ_ONCE(*pipe->tail)) + offset;
+	size_t len;
+
+	if (tail >= pipe->native.length)
+		tail -= pipe->native.length;
+	len = min_t(size_t, count, pipe->native.length - tail);
+	if (len)
+		memcpy_fromio(data, pipe->fifo + tail, len);
+	if (len != count)
+		memcpy_fromio(data + len, pipe->fifo, count - len);
+}
+
+static void glink_spss_rx_advance(struct qcom_glink_pipe *np, size_t count)
+{
+	struct glink_spss_pipe *pipe = to_spss_pipe(np);
+	u32 tail = le32_to_cpu(READ_ONCE(*pipe->tail)) + count;
+
+	if (tail >= pipe->native.length)
+		tail -= pipe->native.length;
+	WRITE_ONCE(*pipe->tail, cpu_to_le32(tail));
+}
+
+static size_t glink_spss_tx_avail(struct qcom_glink_pipe *np)
+{
+	struct glink_spss_pipe *pipe = to_spss_pipe(np);
+	u32 head = le32_to_cpu(READ_ONCE(*pipe->head));
+	u32 tail = le32_to_cpu(READ_ONCE(*pipe->tail));
+	u32 avail = tail <= head ? pipe->native.length - head + tail : tail - head;
+
+	if (avail < FIFO_FULL_RESERVE + TX_BLOCKED_CMD_RESERVE)
+		return 0;
+	return avail - FIFO_FULL_RESERVE - TX_BLOCKED_CMD_RESERVE;
+}
+
+static unsigned int glink_spss_tx_write_one(struct glink_spss_pipe *pipe, unsigned int head,
+					    const void *data, size_t count)
+{
+	size_t len = min_t(size_t, count, pipe->native.length - head);
+
+	if (len)
+		memcpy(pipe->fifo + head, data, len);
+	if (len != count)
+		memcpy(pipe->fifo, data + len, count - len);
+	head += count;
+	if (head >= pipe->native.length)
+		head -= pipe->native.length;
+	return head;
+}
+
+static void glink_spss_tx_write(struct qcom_glink_pipe *np, const void *hdr, size_t hlen,
+				const void *data, size_t dlen)
+{
+	struct glink_spss_pipe *pipe = to_spss_pipe(np);
+	unsigned int head = le32_to_cpu(READ_ONCE(*pipe->head));
+
+	head = glink_spss_tx_write_one(pipe, head, hdr, hlen);
+	head = glink_spss_tx_write_one(pipe, head, data, dlen);
+	head = ALIGN(head, 8);
+	if (head >= pipe->native.length)
+		head -= pipe->native.length;
+	/* the FIFO contents before the new head */
+	wmb();
+	WRITE_ONCE(*pipe->head, cpu_to_le32(head));
+}
+
+static void glink_spss_tx_kick(struct qcom_glink_pipe *np)
+{
+	struct glink_spss *spss = to_spss_pipe(np)->spss;
+
+	mbox_send_message(spss->mbox_chan, NULL);
+	mbox_client_txdone(spss->mbox_chan, 0);
+}
+
+static irqreturn_t glink_spss_intr(int irq, void *data)
+{
+	struct glink_spss *spss = data;
+
+	qcom_glink_native_rx(spss->glink);
+	return IRQ_HANDLED;
+}
+
+/* Tell the SPSS where the descriptor is: its physical address and size */
+static int glink_spss_advertise(struct platform_device *pdev, phys_addr_t pa, u32 size)
+{
+	void __iomem *addr, *len;
+
+	addr = devm_platform_ioremap_resource_byname(pdev, "spss-addr");
+	if (IS_ERR(addr))
+		return PTR_ERR(addr);
+	len = devm_platform_ioremap_resource_byname(pdev, "spss-size");
+	if (IS_ERR(len))
+		return PTR_ERR(len);
+	writeq_relaxed(pa, addr);
+	writel_relaxed(size, len);
+	return 0;
+}
+
+static int glink_spss_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct glink_spss_cfg *cfg;
+	struct glink_spss *spss;
+	size_t size = sizeof(*cfg) + SPSS_TX_FIFO_SIZE + SPSS_RX_FIFO_SIZE;
+	u32 remote_pid;
+	int ret;
+
+	spss = devm_kzalloc(dev, sizeof(*spss), GFP_KERNEL);
+	if (!spss)
+		return -ENOMEM;
+	spss->dev = dev;
+
+	ret = of_property_read_u32(dev->of_node, "qcom,remote-pid", &remote_pid);
+	if (ret)
+		return dev_err_probe(dev, ret, "no qcom,remote-pid\n");
+
+	ret = qcom_smem_alloc(remote_pid, SMEM_GLINK_NATIVE_XPRT_DESCRIPTOR, size);
+	if (ret && ret != -EEXIST)
+		return dev_err_probe(dev, ret, "allocating the GLINK descriptor\n");
+	cfg = qcom_smem_get(remote_pid, SMEM_GLINK_NATIVE_XPRT_DESCRIPTOR, &size);
+	if (IS_ERR(cfg))
+		return dev_err_probe(dev, PTR_ERR(cfg), "getting the GLINK descriptor\n");
+	if (size != sizeof(*cfg) + SPSS_TX_FIFO_SIZE + SPSS_RX_FIFO_SIZE)
+		return dev_err_probe(dev, -EINVAL, "GLINK descriptor of %zu bytes\n", size);
+
+	cfg->tx_fifo_size = cpu_to_le32(SPSS_TX_FIFO_SIZE);
+	cfg->rx_fifo_size = cpu_to_le32(SPSS_RX_FIFO_SIZE);
+
+	spss->tx.spss = spss;
+	spss->tx.tail = &cfg->tx_tail;
+	spss->tx.head = &cfg->tx_head;
+	spss->tx.fifo = (u8 *)cfg + sizeof(*cfg);
+	spss->tx.native.length = SPSS_TX_FIFO_SIZE;
+	spss->tx.native.avail = glink_spss_tx_avail;
+	spss->tx.native.write = glink_spss_tx_write;
+	spss->tx.native.kick = glink_spss_tx_kick;
+
+	spss->rx.spss = spss;
+	spss->rx.tail = &cfg->rx_tail;
+	spss->rx.head = &cfg->rx_head;
+	spss->rx.fifo = (u8 *)cfg + sizeof(*cfg) + SPSS_TX_FIFO_SIZE;
+	spss->rx.native.length = SPSS_RX_FIFO_SIZE;
+	spss->rx.native.avail = glink_spss_rx_avail;
+	spss->rx.native.peek = glink_spss_rx_peek;
+	spss->rx.native.advance = glink_spss_rx_advance;
+
+	*spss->rx.tail = 0;
+	*spss->tx.head = 0;
+
+	spss->irq = platform_get_irq(pdev, 0);
+	if (spss->irq < 0)
+		return spss->irq;
+	ret = devm_request_irq(dev, spss->irq, glink_spss_intr,
+			       IRQF_NO_SUSPEND | IRQF_NO_AUTOEN, "glink-spss", spss);
+	if (ret)
+		return dev_err_probe(dev, ret, "requesting the IRQ\n");
+
+	spss->mbox_client.dev = dev;
+	spss->mbox_client.knows_txdone = true;
+	spss->mbox_chan = mbox_request_channel(&spss->mbox_client, 0);
+	if (IS_ERR(spss->mbox_chan))
+		return dev_err_probe(dev, PTR_ERR(spss->mbox_chan), "requesting the IPCC channel\n");
+
+	ret = glink_spss_advertise(pdev, qcom_smem_virt_to_phys(cfg), size);
+	if (ret)
+		goto err_mbox;
+
+	spss->glink = qcom_glink_native_probe(dev, GLINK_FEATURE_INTENT_REUSE,
+					      &spss->rx.native, &spss->tx.native, false);
+	if (IS_ERR(spss->glink)) {
+		ret = PTR_ERR(spss->glink);
+		goto err_mbox;
+	}
+	platform_set_drvdata(pdev, spss);
+	enable_irq(spss->irq);
+	dev_info(dev, "GLINK edge to the SPSS at %pa\n", &(phys_addr_t){ qcom_smem_virt_to_phys(cfg) });
+	return 0;
+
+err_mbox:
+	mbox_free_channel(spss->mbox_chan);
+	return ret;
+}
+
+static void glink_spss_remove(struct platform_device *pdev)
+{
+	struct glink_spss *spss = platform_get_drvdata(pdev);
+
+	disable_irq(spss->irq);
+	qcom_glink_native_remove(spss->glink);
+	mbox_free_channel(spss->mbox_chan);
+}
+
+static const struct of_device_id glink_spss_of_match[] = {
+	{ .compatible = "qcom,glink-spss" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, glink_spss_of_match);
+
+static struct platform_driver glink_spss_driver = {
+	.probe = glink_spss_probe,
+	.remove = glink_spss_remove,
+	.driver = {
+		.name = "qcom-glink-spss",
+		.of_match_table = glink_spss_of_match,
+	},
+};
+module_platform_driver(glink_spss_driver);
+
+MODULE_DESCRIPTION("Qualcomm GLINK edge to the secure processor (SPSS)");
+MODULE_LICENSE("GPL");
