+struct imx374 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct regmap *regmap;
+	struct clk *xclk;
+
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[IMX374_NUM_SUPPLIES];
+
+	/* Link frequencies listed in the firmware node, by menu index */
+	unsigned long link_freq_bitmap;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *analogue_gain;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+
+	/* Mode of the active state, protected by the state lock */
+	const struct imx374_mode *mode;
+};
+
+static inline struct imx374 *to_imx374(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx374, sd);
+}
+
+static bool imx374_mode_usable(struct imx374 *imx374,
+			       const struct imx374_mode *mode)
+{
+	return imx374->link_freq_bitmap & BIT(mode->link_freq_index);
+}
+
+static const struct imx374_mode *imx374_default_mode(struct imx374 *imx374)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++)
+		if (imx374_mode_usable(imx374, &supported_modes[i]))
+			return &supported_modes[i];
+
+	return NULL;
+}
+
+static const struct imx374_mode *imx374_find_mode(struct imx374 *imx374,
+						  u32 width, u32 height)
+{
+	const struct imx374_mode *best = NULL;
+	unsigned int best_err = UINT_MAX;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++) {
+		const struct imx374_mode *mode = &supported_modes[i];
+		unsigned int err;
+
+		if (!imx374_mode_usable(imx374, mode))
+			continue;
+
+		err = abs((int)mode->width - (int)width) +
+		      abs((int)mode->height - (int)height);
+		if (err < best_err) {
+			best_err = err;
+			best = mode;
+		}
+	}
+
+	return best;
+}
+
+/* -----------------------------------------------------------------------------
+ * Controls
+ */
+
+static int imx374_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx374 *imx374 = container_of(ctrl->handler, struct imx374,
+					     ctrl_handler);
+	const struct imx374_mode *mode = imx374->mode;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int exposure_max = mode->height + ctrl->val -
+				   IMX374_EXPOSURE_OFFSET;
+
+		exposure_max = min(exposure_max, IMX374_EXPOSURE_MAX);
+		ret = __v4l2_ctrl_modify_range(imx374->exposure,
+					       imx374->exposure->minimum,
+					       exposure_max,
+					       imx374->exposure->step,
+					       min_t(int, exposure_max,
+						     mode->exposure_def));
+		if (ret)
+			return ret;
+	}
+
+	/* Registers are written only while the sensor is powered */
+	if (pm_runtime_get_if_in_use(imx374->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(imx374->regmap, IMX374_REG_EXPOSURE, ctrl->val, &ret);
+		if (mode->hdr)
+			cci_write(imx374->regmap, IMX374_REG_EXPOSURE_2ND,
+				  ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(imx374->regmap, IMX374_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		if (mode->hdr)
+			cci_write(imx374->regmap, IMX374_REG_ANALOG_GAIN_2ND,
+				  ctrl->val, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(imx374->regmap, IMX374_REG_DIGITAL_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(imx374->regmap, IMX374_REG_FRM_LENGTH_LINES,
+			  mode->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		/* Stock writes 0xb000/0xb001 = 0 with every pattern change */
+		cci_write(imx374->regmap, IMX374_REG_TP_B000, 0, &ret);
+		cci_write(imx374->regmap, IMX374_REG_TP_B001, 0, &ret);
+		cci_write(imx374->regmap, IMX374_REG_TEST_PATTERN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_RED:
+		cci_write(imx374->regmap, IMX374_REG_TESTP_RED, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENR:
+		cci_write(imx374->regmap, IMX374_REG_TESTP_GREENR, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_BLUE:
+		cci_write(imx374->regmap, IMX374_REG_TESTP_BLUE, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENB:
+		cci_write(imx374->regmap, IMX374_REG_TESTP_GREENB, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_LINK_FREQ:
+	case V4L2_CID_PIXEL_RATE:
+	case V4L2_CID_HBLANK:
+		/* Read-only, fixed by the mode list */
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(imx374->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx374_ctrl_ops = {
+	.s_ctrl = imx374_set_ctrl,
+};
+
+static int imx374_init_controls(struct imx374 *imx374)
+{
+	const struct imx374_mode *mode = imx374->mode;
+	struct v4l2_ctrl_handler *hdl = &imx374->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	unsigned int i;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 14);
+	if (ret)
+		return ret;
+
+	imx374->pixel_rate = v4l2_ctrl_new_std(hdl, &imx374_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       IMX374_PIXEL_RATE,
+					       IMX374_PIXEL_RATE, 1,
+					       IMX374_PIXEL_RATE);
+
+	imx374->link_freq =
+		v4l2_ctrl_new_int_menu(hdl, &imx374_ctrl_ops,
+				       V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(imx374_link_freq_menu) - 1,
+				       mode->link_freq_index,
+				       imx374_link_freq_menu);
+	if (imx374->link_freq)
+		imx374->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx374->hblank = v4l2_ctrl_new_std(hdl, &imx374_ctrl_ops,
+					   V4L2_CID_HBLANK,
+					   mode->llp - mode->width,
+					   mode->llp - mode->width, 1,
+					   mode->llp - mode->width);
+	if (imx374->hblank)
+		imx374->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	/* Frames can be made longer than stock's, not shorter */
+	imx374->vblank = v4l2_ctrl_new_std(hdl, &imx374_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->fll - mode->height,
+					   IMX374_FLL_MAX - mode->height, 1,
+					   mode->fll - mode->height);
+
+	imx374->exposure = v4l2_ctrl_new_std(hdl, &imx374_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX374_EXPOSURE_MIN,
+					     mode->fll - IMX374_EXPOSURE_OFFSET,
+					     IMX374_EXPOSURE_STEP,
+					     mode->exposure_def);
+
+	imx374->analogue_gain = v4l2_ctrl_new_std(hdl, &imx374_ctrl_ops,
+						  V4L2_CID_ANALOGUE_GAIN,
+						  IMX374_ANA_GAIN_MIN,
+						  IMX374_ANA_GAIN_MAX,
+						  IMX374_ANA_GAIN_STEP,
+						  IMX374_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx374_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX374_DGTL_GAIN_MIN, IMX374_DGTL_GAIN_MAX,
+			  IMX374_DGTL_GAIN_STEP, IMX374_DGTL_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx374_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx374_test_pattern_menu) - 1,
+				     0, 0, imx374_test_pattern_menu);
+	for (i = 0; i < 4; i++) {
+		/*
+		 * V4L2_CID_TEST_PATTERN_GREENR, _BLUE and _GREENB follow
+		 * V4L2_CID_TEST_PATTERN_RED in that order. The solid colour
+		 * pattern is white by default.
+		 */
+		v4l2_ctrl_new_std(hdl, &imx374_ctrl_ops,
+				  V4L2_CID_TEST_PATTERN_RED + i,
+				  IMX374_TESTP_COLOUR_MIN,
+				  IMX374_TESTP_COLOUR_MAX,
+				  IMX374_TESTP_COLOUR_STEP,
+				  IMX374_TESTP_COLOUR_MAX);
+	}
+
+	if (hdl->error) {
+		ret = hdl->error;
+		dev_err_probe(imx374->dev, ret, "control init failed\n");
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(imx374->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx374_ctrl_ops, &props);
+	if (ret)
+		goto error;
+
+	imx374->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
+}
+
+/* -----------------------------------------------------------------------------
+ * Subdev operations
+ */
+
+static int imx374_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx374 *imx374 = to_imx374(sd);
+	const struct imx374_mode *mode = imx374->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx374->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(imx374->regmap, imx374_init_regs,
+				  ARRAY_SIZE(imx374_init_regs), NULL);
+	if (ret) {
+		dev_err(imx374->dev, "failed to write init registers: %d\n",
+			ret);
+		goto err_rpm_put;
+	}
+
+	ret = cci_multi_reg_write(imx374->regmap, mode->regs, mode->num_regs,
+				  NULL);
+	if (ret) {
+		dev_err(imx374->dev, "failed to write mode registers: %d\n",
+			ret);
+		goto err_rpm_put;
+	}
+
+	/* After the mode list, which ends with exposure and gain defaults */
+	ret = __v4l2_ctrl_handler_setup(imx374->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(imx374->regmap, IMX374_REG_MODE_SELECT,
+			IMX374_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put_autosuspend(imx374->dev);
+	return ret;
+}
+
+static int imx374_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx374 *imx374 = to_imx374(sd);
+	int ret;
+
+	ret = cci_write(imx374->regmap, IMX374_REG_MODE_SELECT,
+			IMX374_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(imx374->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put_autosuspend(imx374->dev);
+
+	return ret;
+}
+
+static int imx374_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = IMX374_MBUS_CODE;
+
+	return 0;
+}
+
+static int imx374_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx374 *imx374 = to_imx374(sd);
+	unsigned int i, n = 0;
+
+	if (fse->code != IMX374_MBUS_CODE)
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++) {
+		const struct imx374_mode *mode = &supported_modes[i];
+
+		if (!imx374_mode_usable(imx374, mode))
+			continue;
+
+		if (n++ == fse->index) {
+			fse->min_width = mode->width;
+			fse->max_width = mode->width;
+			fse->min_height = mode->height;
+			fse->max_height = mode->height;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static int imx374_update_controls(struct imx374 *imx374,
+				  const struct imx374_mode *mode)
+{
+	int hblank = mode->llp - mode->width;
+	int vblank = mode->fll - mode->height;
+	int ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx374->link_freq, mode->link_freq_index);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(imx374->hblank, hblank, hblank, 1,
+				       hblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_modify_range(imx374->vblank, vblank,
+				       IMX374_FLL_MAX - mode->height, 1,
+				       vblank);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(imx374->vblank, vblank);
+	if (ret)
+		return ret;
+
+	return __v4l2_ctrl_modify_range(imx374->exposure,
+					IMX374_EXPOSURE_MIN,
+					mode->fll - IMX374_EXPOSURE_OFFSET,
+					IMX374_EXPOSURE_STEP,
+					mode->exposure_def);
+}
+
+static int imx374_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx374 *imx374 = to_imx374(sd);
+	const struct imx374_mode *mode;
+	struct v4l2_mbus_framefmt *format;
+	struct v4l2_rect *crop;
+	int ret;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	mode = imx374_find_mode(imx374, fmt->format.width,
+				fmt->format.height);
+	if (!mode)
+		return -EINVAL;
+
+	fmt->format.code = IMX374_MBUS_CODE;
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	format = v4l2_subdev_state_get_format(state, 0);
+	*format = fmt->format;
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	*crop = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		imx374->mode = mode;
+		ret = imx374_update_controls(imx374, mode);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int imx374_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX374_NATIVE_WIDTH;
+		sel->r.height = IMX374_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx374_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct imx374 *imx374 = to_imx374(sd);
+	const struct imx374_mode *mode = imx374_default_mode(imx374);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = IMX374_MBUS_CODE,
+			.width = mode->width,
+			.height = mode->height,
+		},
+	};
+
+	return imx374_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops imx374_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx374_pad_ops = {
+	.enum_mbus_code = imx374_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx374_set_pad_format,
+	.get_selection = imx374_get_selection,
+	.enum_frame_size = imx374_enum_frame_size,
+	.enable_streams = imx374_enable_streams,
+	.disable_streams = imx374_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx374_subdev_ops = {
+	.video = &imx374_video_ops,
+	.pad = &imx374_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx374_internal_ops = {
+	.init_state = imx374_init_state,
+};
+
+/* -----------------------------------------------------------------------------
+ * Power management
+ */
+
+/*
+ * Stock's power sequence: VANA, VIO, VDIG and MCLK 1 ms apart, then XCLR
+ * released 1 ms later, then 10 ms before the first access. Power-down is
+ * the reverse with 1 ms steps.
+ */
+static int imx374_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx374 *imx374 = to_imx374(sd);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < IMX374_NUM_SUPPLIES; i++) {
+		ret = regulator_enable(imx374->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				imx374->supplies[i].supply, ret);
+			goto err_supplies;
+		}
+		usleep_range(1000, 1100);
+	}
+
+	ret = clk_prepare_enable(imx374->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable clock: %d\n", ret);
+		goto err_supplies;
+	}
+	usleep_range(1000, 1100);
+
+	gpiod_set_value_cansleep(imx374->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+
+err_supplies:
+	while (i--)
+		regulator_disable(imx374->supplies[i].consumer);
+
+	return ret;
+}
+
+static int imx374_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx374 *imx374 = to_imx374(sd);
+	unsigned int i;
+
+	gpiod_set_value_cansleep(imx374->reset_gpio, 1);
+	usleep_range(1000, 1100);
+
+	clk_disable_unprepare(imx374->xclk);
+	usleep_range(1000, 1100);
+
+	for (i = IMX374_NUM_SUPPLIES; i--;) {
+		regulator_disable(imx374->supplies[i].consumer);
+		usleep_range(1000, 1100);
+	}
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * Probe & remove
+ */
+
+static int imx374_identify_module(struct imx374 *imx374)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(imx374->regmap, IMX374_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(imx374->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != IMX374_CHIP_ID)
+		return dev_err_probe(imx374->dev, -ENODEV,
+				     "chip id mismatch: expected 0x%04x, read 0x%04llx\n",
+				     IMX374_CHIP_ID, val);
+
+	return 0;
+}
+
+static int imx374_check_hwcfg(struct imx374 *imx374)
+{
+	struct device *dev = imx374->dev;
+	struct v4l2_fwnode_endpoint ep_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct fwnode_handle *endpoint;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(dev, -EINVAL, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not parse endpoint\n");
+
+	if (ep_cfg.bus.mipi_csi2.num_data_lanes != IMX374_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "only %u data lanes are supported\n",
+				    IMX374_DATA_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, ep_cfg.link_frequencies,
+				       ep_cfg.nr_of_link_frequencies,
+				       imx374_link_freq_menu,
+				       ARRAY_SIZE(imx374_link_freq_menu),
+				       &imx374->link_freq_bitmap);
+
+out:
+	v4l2_fwnode_endpoint_free(&ep_cfg);
+
+	return ret;
+}
+
+static int imx374_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx374 *imx374;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	imx374 = devm_kzalloc(dev, sizeof(*imx374), GFP_KERNEL);
+	if (!imx374)
+		return -ENOMEM;
+
+	imx374->dev = dev;
+
+	v4l2_i2c_subdev_init(&imx374->sd, client, &imx374_subdev_ops);
+	imx374->sd.internal_ops = &imx374_internal_ops;
+
+	ret = imx374_check_hwcfg(imx374);
+	if (ret)
+		return ret;
+
+	imx374->mode = imx374_default_mode(imx374);
+
+	imx374->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx374->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx374->regmap),
+				     "failed to initialize CCI\n");
+
+	imx374->xclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(imx374->xclk))
+		return dev_err_probe(dev, PTR_ERR(imx374->xclk),
+				     "failed to get clock\n");
+
+	freq = clk_get_rate(imx374->xclk);
+	if (freq != IMX374_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock frequency %lu Hz not supported, need %u Hz\n",
+				     freq, IMX374_XCLK_FREQ);
+
+	for (i = 0; i < IMX374_NUM_SUPPLIES; i++)
+		imx374->supplies[i].supply = imx374_supply_name[i];
+
+	ret = devm_regulator_bulk_get(dev, IMX374_NUM_SUPPLIES,
+				      imx374->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* XCLR is active low: request it asserted, the sensor held in reset */
+	imx374->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx374->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx374->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = imx374_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx374_identify_module(imx374);
+	if (ret)
+		goto error_power_off;
+
+	ret = imx374_init_controls(imx374);
+	if (ret)
+		goto error_power_off;
+
+	imx374->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx374->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx374->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx374->sd.entity, 1, &imx374->pad);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to init entity pads\n");
+		goto error_handler_free;
+	}
+
+	imx374->sd.state_lock = imx374->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx374->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "subdev init error\n");
+		goto error_media_entity;
+	}
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx374->sd);
+	if (ret < 0) {
+		dev_err_probe(dev, ret, "failed to register sensor sub-device\n");
+		goto error_subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+error_subdev_cleanup:
+	v4l2_subdev_cleanup(&imx374->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+
+error_media_entity:
+	media_entity_cleanup(&imx374->sd.entity);
+
+error_handler_free:
+	v4l2_ctrl_handler_free(&imx374->ctrl_handler);
+
+error_power_off:
+	imx374_power_off(dev);
+
+	return ret;
+}
+
+static void imx374_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx374 *imx374 = to_imx374(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx374->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		imx374_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
+
+static const struct of_device_id imx374_of_match[] = {
+	{ .compatible = "sony,imx374" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx374_of_match);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx374_pm_ops, imx374_power_off,
+				 imx374_power_on, NULL);
+
+static struct i2c_driver imx374_i2c_driver = {
+	.driver = {
+		.name = "imx374",
+		.of_match_table = imx374_of_match,
+		.pm = pm_ptr(&imx374_pm_ops),
+	},
+	.probe = imx374_probe,
+	.remove = imx374_remove,
+};
+
+module_i2c_driver(imx374_i2c_driver);
