+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx374.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX374 CMOS Digital Image Sensor
+
+maintainers:
+  - Noa Himesaka <himesaka@noa.codes>
+
+description:
+  IMX374 is a CMOS active pixel image sensor with a 10-bit RAW Bayer output.
+  It is programmed through I2C and sends image data over a four-lane MIPI
+  CSI-2 D-PHY interface.
+
+$ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx374
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: Input clock (INCK), 24 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Reference to the GPIO connected to the XCLR pin, if any.
+    maxItems: 1
+
+  vana-supply:
+    description: Analogue voltage (VANA) supply, 2.8 V.
+
+  vdig-supply:
+    description: Digital core voltage (VDIG) supply, 1.05 V.
+
+  vif-supply:
+    description: Interface voltage (VIF) supply, 1.8 V.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx374";
+            reg = <0x1a>;
+            clocks = <&imx374_clk>;
+            reset-gpios = <&gpio 202 GPIO_ACTIVE_LOW>;
+            vana-supply = <&vana>;
+            vdig-supply = <&vdig>;
+            vif-supply = <&vif>;
+            orientation = <0>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy3_ep>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <909000000 897000000 399000000>;
+                };
+            };
+        };
+    };
