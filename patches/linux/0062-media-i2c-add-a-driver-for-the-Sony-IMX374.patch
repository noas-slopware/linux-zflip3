+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX374 image sensor driver
+ *
+ * The register lists come from the IMX374 sensor module that the Samsung
+ * Galaxy Z Flip3 (SM-F711N) ships for its front camera. No datasheet was
+ * used; registers outside the SMIA/CCS standard set are written as the
+ * stock lists write them, without a name.
+ *
+ * Structure follows the imx219 driver.
+ */
+
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+#define IMX374_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX374_CHIP_ID			0x0374
+
+#define IMX374_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX374_MODE_STANDBY		0x00
+#define IMX374_MODE_STREAMING		0x01
+
+#define IMX374_REG_FRM_LENGTH_LINES	CCI_REG16(0x0340)
+
+/*
+ * Exposure in lines. The stock module limits it to 2 lines minimum, to
+ * frame length - 10 and to 55000 lines in total.
+ */
+#define IMX374_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX374_REG_EXPOSURE_2ND		CCI_REG16(0x0224)
+#define IMX374_EXPOSURE_MIN		2
+#define IMX374_EXPOSURE_STEP		1
+#define IMX374_EXPOSURE_OFFSET		10
+#define IMX374_EXPOSURE_MAX		55000
+#define IMX374_FLL_MAX			(IMX374_EXPOSURE_MAX + IMX374_EXPOSURE_OFFSET)
+
+/* Analogue gain code: gain = 1024 / (1024 - code), up to 8x */
+#define IMX374_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX374_REG_ANALOG_GAIN_2ND	CCI_REG16(0x0216)
+#define IMX374_ANA_GAIN_MIN		0
+#define IMX374_ANA_GAIN_MAX		896
+#define IMX374_ANA_GAIN_STEP		1
+#define IMX374_ANA_GAIN_DEFAULT		0
+
+/* Digital gain, Q8 (0x100 = 1.0x) */
+#define IMX374_REG_DIGITAL_GAIN		CCI_REG16(0x020e)
+#define IMX374_DGTL_GAIN_MIN		0x0100
+#define IMX374_DGTL_GAIN_MAX		0x0fff
+#define IMX374_DGTL_GAIN_STEP		1
+#define IMX374_DGTL_GAIN_DEFAULT	0x0100
+
+/* Test pattern (SMIA/CCS layout) */
+#define IMX374_REG_TP_B000		CCI_REG8(0xb000)
+#define IMX374_REG_TP_B001		CCI_REG8(0xb001)
+#define IMX374_REG_TEST_PATTERN		CCI_REG16(0x0600)
+#define IMX374_REG_TESTP_RED		CCI_REG16(0x0602)
+#define IMX374_REG_TESTP_GREENR		CCI_REG16(0x0604)
+#define IMX374_REG_TESTP_BLUE		CCI_REG16(0x0606)
+#define IMX374_REG_TESTP_GREENB		CCI_REG16(0x0608)
+#define IMX374_TESTP_COLOUR_MIN		0
+#define IMX374_TESTP_COLOUR_MAX		0x03ff
+#define IMX374_TESTP_COLOUR_STEP	1
+
+/* The init list programs EXCK for a 24 MHz input clock (0x0136) */
+#define IMX374_XCLK_FREQ		24000000
+
+/*
+ * Pixel rate for the timing registers. The VT PLL is the same in every
+ * mode (24 MHz / 4 * 210 = 1260 MHz), and line length x frame length x
+ * frame rate comes to 840 Mpixel/s in every stock mode.
+ */
+#define IMX374_PIXEL_RATE		840000000
+
+/*
+ * The largest window the stock modes read out: x 0 to 3983, y 0 to 2735.
+ * The stock module does not state the pixel array size.
+ */
+#define IMX374_NATIVE_WIDTH		3984U
+#define IMX374_NATIVE_HEIGHT		2736U
+
+/* Four lanes; per-lane D-PHY rate = 2 x link frequency */
+#define IMX374_DATA_LANES		4
+
+enum {
+	IMX374_LINK_FREQ_909MHZ,
+	IMX374_LINK_FREQ_897MHZ,
+	IMX374_LINK_FREQ_399MHZ,
+};
+
+/*
+ * OP PLL: 24 MHz / 0x030d * 0x030e:0x030f / 0x030b. The stock lists set
+ * 303 (1818 Mbps), 299 (1794 Mbps) and 266 with 0x030b = 2 (798 Mbps).
+ */
+static const s64 imx374_link_freq_menu[] = {
+	[IMX374_LINK_FREQ_909MHZ] = 909000000,
+	[IMX374_LINK_FREQ_897MHZ] = 897000000,
+	[IMX374_LINK_FREQ_399MHZ] = 399000000,
+};
+
+static const char * const imx374_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+	"Colour Bars With Fade to Grey",
+	"Pseudorandom Sequence (PN9)",
+};
+
+static const char * const imx374_supply_name[] = {
+	"vana",		/* Analogue (2.8 V) */
+	"vif",		/* Interface (1.8 V) */
+	"vdig",		/* Digital core (1.05 V) */
+};
+
+#define IMX374_NUM_SUPPLIES ARRAY_SIZE(imx374_supply_name)
+
+/*
+ * The stock module has no flip settings, so the sensor runs unflipped.
+ * Its CFA code for every mode is that of GRBG.
+ */
+#define IMX374_MBUS_CODE		MEDIA_BUS_FMT_SGRBG10_1X10
+
+struct imx374_mode {
+	unsigned int width;
+	unsigned int height;
+
+	/* Analogue crop rectangle, in native pixel array coordinates */
+	struct v4l2_rect crop;
+
+	/* Line length and frame length as the mode list sets them */
+	unsigned int llp;
+	unsigned int fll;
+
+	/* Coarse integration time as the mode list sets it */
+	unsigned int exposure_def;
+
+	unsigned int link_freq_index;
+
+	/*
+	 * The mode list turns on the sensor's HDR mode (0x0220 = 0x61) and
+	 * seeds the second exposure with the first. Keep the second exposure
+	 * and analogue gain equal to the first so the frame stays uniform.
+	 */
+	bool hdr;
+
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+/*
+ * Register lists, verbatim from the stock module, in stock's order.
+ *
+ * imx374_init_regs is stock's init list. It is the same for both stock
+ * front cameras and is written before any mode list. It opens with a run
+ * of 0xf800-0xf90f writes, which are left alone.
+ *
+ * The three mode lists write the same addresses in the same order, except
+ * that the 1824x1368 list also writes 0x3f8c-0x3f8f, 0x6e40 and 0x6e44.
+ * The values that differ between them are 0x0220, the frame and line
+ * length, binning, the readout window, output size and digital crop, the
+ * OP PLL (0x030b, 0x030f), the initial exposures (0x0202, 0x0224) and
+ * 0x3f56/0x3f57, 0x3fa8/0x3fa9, 0x3ff4/0x3ff5 and 0x6e62. The rest is the
+ * same in all three.
+ */
