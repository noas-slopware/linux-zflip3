+/*
+ * Stock command sets: DSI packet type, the "last" flag (unused: the packets go
+ * out one by one), the post wait in ms and the payload, in the order of the
+ * panel device tree.
+ */
+struct s6e3had_cmd {
+	u8 type;
+	u8 last;
+	u8 wait;
+	u16 len;
+	const u8 *data;
+};
