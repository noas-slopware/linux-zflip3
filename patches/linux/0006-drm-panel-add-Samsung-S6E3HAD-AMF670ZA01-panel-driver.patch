+	S6E3HAD_CMD(0x29, 0, 0, 0xc5, 0x11, 0x10, 0x50, 0x05),
+	S6E3HAD_CMD(0x29, 0, 0, 0xb0, 0x00, 0x16, 0xc5),
+	S6E3HAD_CMD(0x29, 0, 0, 0xc5, 0x73, 0xf9, 0x77, 0xe9, 0x44, 0xfe, 0x43, 0xa8),
+	S6E3HAD_CMD(0x29, 0, 0, 0xfc, 0xa5, 0xa5),
+	S6E3HAD_CMD(0x29, 0, 0, 0xf0, 0xa5, 0xa5),
+};
+static const struct s6e3had_cmd s6e3had_keys_on_cmds[] = {
+	S6E3HAD_CMD(0x29, 0, 0, 0xf0, 0x5a, 0x5a),
+	S6E3HAD_CMD(0x29, 0, 0, 0xfc, 0x5a, 0x5a),
+};
+
+static const struct s6e3had_cmd s6e3had_keys_off_cmds[] = {
+	S6E3HAD_CMD(0x29, 0, 0, 0xfc, 0xa5, 0xa5),
+	S6E3HAD_CMD(0x29, 0, 0, 0xf0, 0xa5, 0xa5),
+};
+
+/*
+ * The stock timings this driver offers. All of them run the DSI lanes at
+ * 910 Mbps (qcom,mdss-dsi-panel-clockrate), because the panel's frame rate
+ * follows the lane rate. MSM derives the lane rate from the mode clock,
+ * compressed by DSC to a third of hdisplay, so the horizontal front porch is
+ * stretched until that comes to 910 Mbps at the stock refresh rate; the other
+ * porches are stock. 96 and 48 Hz are left out: stock corrects their gamma
+ * with values computed from the panel's flash, which this driver doesn't do.
+ */
+struct s6e3had_timing {
+	struct drm_display_mode mode;
+	const struct s6e3had_cmd *on;
+	int on_count;
+	const struct s6e3had_cmd *vrr;
+	int vrr_count;
+};
+
+#define S6E3HAD_MODE(_rr, _hfp, _vfp, _vbp) {				\
+	.clock = (1080 + (_hfp) + 28 + 28) * (2640 + (_vfp) + 28 + (_vbp)) * (_rr) / 1000, \
+	.hdisplay = 1080,							\
+	.hsync_start = 1080 + (_hfp),						\
+	.hsync_end = 1080 + (_hfp) + 28,					\
+	.htotal = 1080 + (_hfp) + 28 + 28,					\
+	.vdisplay = 2640,							\
+	.vsync_start = 2640 + (_vfp),						\
+	.vsync_end = 2640 + (_vfp) + 28,					\
+	.vtotal = 2640 + (_vfp) + 28 + (_vbp),					\
+	.width_mm = 64,								\
+	.height_mm = 158,							\
+}
+
+static const struct s6e3had_timing s6e3had_timings[] = {
+	{	/* fhd120hs, the stock default */
+		.mode = S6E3HAD_MODE(120, 50, 16, 28),
+		.on = s6e3had_on_120hs_cmds, .on_count = ARRAY_SIZE(s6e3had_on_120hs_cmds),
+		.vrr = s6e3had_vrr_120hs_cmds, .vrr_count = ARRAY_SIZE(s6e3had_vrr_120hs_cmds),
+	},
+	{	/* fhd60hs */
+		.mode = S6E3HAD_MODE(60, 513, 24, 28),
+		.on = s6e3had_on_60hs_cmds, .on_count = ARRAY_SIZE(s6e3had_on_60hs_cmds),
+		.vrr = s6e3had_vrr_60hs_cmds, .vrr_count = ARRAY_SIZE(s6e3had_vrr_60hs_cmds),
+	},
+	{	/* fhd60ns */
+		.mode = S6E3HAD_MODE(60, 512, 28, 28),
+		.on = s6e3had_on_60ns_cmds, .on_count = ARRAY_SIZE(s6e3had_on_60ns_cmds),
+		.vrr = s6e3had_vrr_60ns_cmds, .vrr_count = ARRAY_SIZE(s6e3had_vrr_60ns_cmds),
+	},
+};
+
+/*
+ * Send a command set packet by packet, with the stock post waits.
+ * @override replaces the payload of the packet starting with its first byte.
+ */
+static int s6e3had_send(struct s6e3had *ctx, const struct s6e3had_cmd *cmds, int count,
+			const u8 *override, size_t override_len)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	int i;
+
+	for (i = 0; i < count; i++) {
+		const struct s6e3had_cmd *c = &cmds[i];
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = c->type,
+			.tx_buf = c->data,
+			.tx_len = c->len,
+		};
+		ssize_t ret;
+
+		if (override && c->len == override_len && c->data[0] == override[0])
+			msg.tx_buf = override;
+
+		if (dsi->mode_flags & MIPI_DSI_MODE_LPM)
+			msg.flags |= MIPI_DSI_MSG_USE_LPM;
+
+		ret = dsi->host->ops->transfer(dsi->host, &msg);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "failed to send %02x: %zd\n", c->data[0], ret);
+			return ret;
+		}
+
+		if (c->wait)
+			msleep(c->wait);
+	}
+
+	return 0;
+}
+
+#define s6e3had_send_set(ctx, set) \
+	s6e3had_send(ctx, set, ARRAY_SIZE(set), NULL, 0)
+
+/*
+ * Samsung's brightness packet (ss_brightness_dcs() with this panel's
+ * make_brightness_packet() and ss_brightness_tot_level()): F0h and FCh
+ * unlocked, then ACL on, gamma, IRC, VINT and VRR, then locked again.
+ */
+static int s6e3had_send_brightness(struct s6e3had *ctx, u16 level)
+{
+	u8 wrdisbv[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, level >> 8, level & 0xff };
+	int ret;
+
+	ret = s6e3had_send_set(ctx, s6e3had_keys_on_cmds);
+	if (!ret)
+		ret = s6e3had_send_set(ctx, s6e3had_acl_on_cmds);
+	if (!ret)
+		ret = s6e3had_send(ctx, s6e3had_gamma_cmds, ARRAY_SIZE(s6e3had_gamma_cmds),
+				   wrdisbv, sizeof(wrdisbv));
+	if (!ret)
+		ret = s6e3had_send_set(ctx, s6e3had_irc_cmds);
+	if (!ret)
+		ret = s6e3had_send_set(ctx, s6e3had_vint_cmds);
+	if (!ret)
+		ret = s6e3had_send(ctx, ctx->timing->vrr, ctx->timing->vrr_count, NULL, 0);
+	if (!ret)
+		ret = s6e3had_send_set(ctx, s6e3had_keys_off_cmds);
+
+	return ret;
+}
+
+static int s6e3had_power_on(struct s6e3had *ctx)
+{
+	int ret;
+
+	ret = regulator_enable(ctx->supplies[0].consumer);
+	if (ret)
+		return ret;
+
+	ret = regulator_enable(ctx->supplies[1].consumer);
+	if (ret)
+		goto err_vdd3;
+
+	ret = regulator_enable(ctx->supplies[2].consumer);
+	if (ret)
+		goto err_vddr;
+	usleep_range(11000, 12000);
+
+	/* Stock reset sequence: release reset and wait 10 ms. */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+
+	return 0;
+
+err_vddr:
+	regulator_disable(ctx->supplies[1].consumer);
+err_vdd3:
+	regulator_disable(ctx->supplies[0].consumer);
+	return ret;
+}
+
+static void s6e3had_power_off(struct s6e3had *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	regulator_disable(ctx->supplies[2].consumer);
+	regulator_disable(ctx->supplies[1].consumer);
+	regulator_disable(ctx->supplies[0].consumer);
+}
+
+static int s6e3had_on(struct s6e3had *ctx)
+{
+	int ret;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;	/* on-command state: dsi_lp_mode */
+
+	ret = s6e3had_send(ctx, ctx->timing->on, ctx->timing->on_count, NULL, 0);
+	if (ret)
+		return ret;
+
+	/* ss_panel_on_post(): brightness packet, then FFC */
+	ret = s6e3had_send_brightness(ctx, backlight_get_brightness(ctx->panel.backlight));
+	if (ret)
+		return ret;
+
+	return s6e3had_send_set(ctx, s6e3had_ffc_cmds);
+}
+
+/*
+ * drm_panel isn't told which mode was set, so look it up in the state of the
+ * connector the modes were handed to. A mode change is a full modeset, which
+ * powers the panel down and back up through here.
+ */
+static const struct s6e3had_timing *s6e3had_current_timing(struct s6e3had *ctx)
+{
+	struct drm_connector_state *conn_state;
+	int i;
+
+	conn_state = ctx->connector ? ctx->connector->state : NULL;
+	if (conn_state && conn_state->crtc && conn_state->crtc->state) {
+		const struct drm_display_mode *mode = &conn_state->crtc->state->mode;
+
+		for (i = 0; i < ARRAY_SIZE(s6e3had_timings); i++)
+			if (drm_mode_match(mode, &s6e3had_timings[i].mode,
+					   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+				return &s6e3had_timings[i];
+	}
+
+	return &s6e3had_timings[0];
+}
+
+static int s6e3had_prepare(struct drm_panel *panel)
+{
+	struct s6e3had *ctx = to_s6e3had(panel);
+	int ret;
+
+	ctx->timing = s6e3had_current_timing(ctx);
+
+	ret = s6e3had_power_on(ctx);
+	if (ret)
+		return ret;
+
+	ret = s6e3had_on(ctx);
+	if (ret) {
+		dev_err(&ctx->dsi->dev, "failed to initialize panel: %d\n", ret);
+		s6e3had_power_off(ctx);
+	}
+
+	return ret;
+}
+
+static int s6e3had_enable(struct drm_panel *panel)
+{
+	return s6e3had_send_set(to_s6e3had(panel), s6e3had_display_on_cmds);
+}
+
+static int s6e3had_disable(struct drm_panel *panel)
+{
+	struct s6e3had *ctx = to_s6e3had(panel);
+	int ret;
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;	/* off-command state: dsi_hs_mode */
+	ret = s6e3had_send_set(ctx, s6e3had_off_cmds);
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret;
+}
+
+static int s6e3had_unprepare(struct drm_panel *panel)
+{
+	s6e3had_power_off(to_s6e3had(panel));
+
+	return 0;
+}
+
+static int s6e3had_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct s6e3had *ctx = to_s6e3had(panel);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(s6e3had_timings); i++) {
+		struct drm_display_mode *mode;
+
+		mode = drm_mode_duplicate(connector->dev, &s6e3had_timings[i].mode);
+		if (!mode)
+			return -ENOMEM;
+
+		drm_mode_set_name(mode);
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = s6e3had_timings[0].mode.width_mm;
+	connector->display_info.height_mm = s6e3had_timings[0].mode.height_mm;
+	ctx->connector = connector;
+
+	return ARRAY_SIZE(s6e3had_timings);
+}
+
+static const struct drm_panel_funcs s6e3had_panel_funcs = {
+	.prepare = s6e3had_prepare,
+	.enable = s6e3had_enable,
+	.disable = s6e3had_disable,
+	.unprepare = s6e3had_unprepare,
+	.get_modes = s6e3had_get_modes,
+};
+
+static int s6e3had_bl_update_status(struct backlight_device *bl)
+{
+	struct s6e3had *ctx = bl_get_data(bl);
+	unsigned long flags = ctx->dsi->mode_flags;
+	int ret;
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = s6e3had_send_brightness(ctx, backlight_get_brightness(bl));
+	ctx->dsi->mode_flags = flags;
+
+	return ret;
+}
+
+static const struct backlight_ops s6e3had_bl_ops = {
+	.update_status = s6e3had_bl_update_status,
+};
+
+static int s6e3had_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = S6E3HAD_BRIGHTNESS_MAX / 2,
+		.max_brightness = S6E3HAD_BRIGHTNESS_MAX,
+	};
+	struct s6e3had *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e3had, panel, &s6e3had_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(s6e3had_supplies),
+					    s6e3had_supplies, &ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* The bootloader leaves the panel running; keep it out of reset. */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	ctx->timing = &s6e3had_timings[0];
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+							       &s6e3had_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "failed to register backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* Stock PPS: DSC 1.1, two 540x40 slices, 8 bpc, 8 bpp, block prediction */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 40;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4; /* 4 fractional bits */
+	ctx->dsc.block_pred_enable = true;
+	dsi->dsc = &ctx->dsc;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void s6e3had_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3had *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e3had_of_match[] = {
+	{ .compatible = "samsung,s6e3had-amf670za01" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s6e3had_of_match);
+
+static struct mipi_dsi_driver s6e3had_driver = {
+	.probe = s6e3had_probe,
+	.remove = s6e3had_remove,
+	.driver = {
+		.name = "panel-samsung-s6e3had",
+		.of_match_table = s6e3had_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e3had_driver);
+
+MODULE_AUTHOR("Noa Himesaka <himesaka@noa.codes>");
+MODULE_DESCRIPTION("DRM driver for the Samsung S6E3HAD AMF670ZA01 panel");
+MODULE_LICENSE("GPL");
