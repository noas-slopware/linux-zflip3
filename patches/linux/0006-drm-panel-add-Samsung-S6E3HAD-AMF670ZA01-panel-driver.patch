+/* Stock order and delays: vdd3, vddr, then vci and 11 ms. */
+static const struct regulator_bulk_data s6e3had_supplies[] = {
+	{ .supply = "vdd3" },
+	{ .supply = "vddr" },
+	{ .supply = "vci" },
+};
+
+static inline struct s6e3had *to_s6e3had(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3had, panel);
+}
