--- a/drivers/firmware/qcom/Kconfig
+++ b/drivers/firmware/qcom/Kconfig
@@ -90,6 +90,18 @@ config QCOM_QSEECOM_PROBE
 
 	  If unsure, say N.
 
+config QCOM_QSEE_APP
+	tristate "Userspace access to QSEE trusted applications"
+	depends on QCOM_QSEECOM
+	help
+	  A /dev/qsee-app character device through which a userspace daemon
+	  loads one QSEE trusted application per file descriptor (from its
+	  .mdt/.bNN image with request_firmware()) and exchanges commands with
+	  it in a TZ shared buffer, the way Android stacks do with downstream
+	  qseecom. Samsung's fingerprint TA is driven this way.
+
+	  If unsure, say N.
+
 config QCOM_QSEECOM_UEFISECAPP
 	bool "Qualcomm SEE UEFI Secure App client driver"
 	depends on QCOM_QSEECOM
