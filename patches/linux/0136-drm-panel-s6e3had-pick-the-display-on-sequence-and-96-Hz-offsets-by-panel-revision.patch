+/* One byte from a DCS read, in LP like every stock read */
+static int s6e3had_read_byte(struct s6e3had *ctx, u8 reg, u8 *val)
+{
+	ssize_t ret = mipi_dsi_dcs_read(ctx->dsi, reg, val, 1);
+
+	return ret == 1 ? 0 : (ret < 0 ? ret : -EIO);
