+/*
+ * ss_panel_revision(): the panel's revision from the third byte of its ID (DAh,
+ * DBh, DCh): 0x00 and 0x01 are A, 0x42 to 0x44 B, 0x45 C, 0x46 D, anything else
+ * D. For A to C, samsung_panel_on_pre() also reads VBIAS and VAINT (C6h at
+ * 0x127 and 0x147, behind the level 2 key) to write them into the display-on
+ * sequence.
+ */
+static void s6e3had_read_id(struct s6e3had *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	unsigned long flags = ctx->dsi->mode_flags;
+	u8 vbias = 0, vaint = 0;
+	int ret;
+
+	ctx->rev = S6E3HAD_REV_D;
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	ret = s6e3had_read_byte(ctx, 0xda, &ctx->id[0]);
+	if (!ret)
+		ret = s6e3had_read_byte(ctx, 0xdb, &ctx->id[1]);
+	if (!ret)
+		ret = s6e3had_read_byte(ctx, 0xdc, &ctx->id[2]);
+	if (ret) {
+		dev_warn(dev, "panel ID read failed (%d), taking revision D\n", ret);
+		goto out;
+	}
+
+	switch (ctx->id[2]) {
+	case 0x00 ... 0x01:
+		ctx->rev = 0;
+		break;
+	case 0x42 ... 0x44:
+		ctx->rev = 1;
+		break;
+	case 0x45:
+		ctx->rev = 2;
+		break;
+	case 0x46:
+		ctx->rev = 3;
+		break;
+	default:
+		dev_warn(dev, "unknown panel ID %*phN, taking revision D\n", 3, ctx->id);
+		break;
+	}
+
+	if (ctx->rev < S6E3HAD_REV_D) {
+		ret = s6e3had_send_set(ctx, s6e3had_level2_on_cmds);
+		if (!ret)
+			ret = s6e3had_send_set(ctx, s6e3had_vbias_pos_cmds);
+		if (!ret)
