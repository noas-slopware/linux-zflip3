+++ b/arch/arm64/boot/dts/qcom/sm8350.dtsi
@@ -669,6 +669,12 @@
 		interrupts-extended = <&ipcc IPCC_CLIENT_SPSS IPCC_MPROC_SIGNAL_TZ IRQ_TYPE_LEVEL_HIGH>;
 	};
 
+	qup_virt: interconnect-qup-virt {
+		compatible = "qcom,sm8350-qup-virt";
+		#interconnect-cells = <2>;
+		qcom,bcm-voters = <&apps_bcm_voter>;
+	};
+
 	soc: soc@0 {
 		#address-cells = <2>;
 		#size-cells = <2>;
