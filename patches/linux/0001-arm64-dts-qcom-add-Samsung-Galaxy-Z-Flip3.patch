From: Noa Himesaka <himesaka@noa.codes>
Subject: [PATCH] arm64: dts: qcom: add Samsung Galaxy Z Flip3 5G (b2q)

Add a device tree for the Samsung Galaxy Z Flip3 5G (SM-F711N, codename
b2q, board-id 08), a Snapdragon 888 (SM8350) foldable.

The board file starts from the WIP device tree by Alicja Michalska
<ellyqw@mainlining.org> for the SM-F711B (gitlab.nura.eco/ellyq/sm8350-mainline,
commit 7a5e01b2) and corrects it for this board from its stock device tree:

  - gpio-reserved-ranges covers every TLMM pin TrustZone owns here: 4-7,
    40-41 and 52-59 from the stock kernel's reserved_gpios, 38-39 for the
    fingerprint sensor, and 30-31, which reset the board on the first read
    when the TLMM driver registers its gpiochip,
  - there is no PM8350B: the stock tree has no SID 3 PMIC and every SPMI
    read from it fails, so pm8350b.dtsi is not included,
  - Volume Up is PM8350 gpio6 (power-source 1), and the MAX77705 interrupt
    and the charger-side line names are on PM8350C, as in the stock tree,
  - a ramoops region at 0xf0b00000, the address Samsung's own kernel uses,
  - the QCA6390 Wi-Fi/Bluetooth combo: its power unit with the rails and
    enable pins of the stock cnss/bt nodes, PCIe0 for Wi-Fi (calibration
    variant Samsung_Galaxy_Z_Flip3) and the 4-wire SE18 UART for Bluetooth,
  - a root model and compatible: without a root compatible the regulator
    core refuses dummy supplies and qcom-pcie fails to probe.
  - the PMK8350 power key and Volume Down (resin), as in the stock pon node.
  - the PMK8350 RTC, as in the stock tree. TrustZone owns its write
    channel, so the time is kept as an offset in SDAM14, which the
    application processor owns and stock leaves unused.
  - the MAX77705 haptic motor as in the stock max77705_vibrator node: its
    supply switch on gpio190, its PWM from GCC GP2 on gpio116 at stock's
    205 Hz LRA frequency, limited to stock's 73 % ratio.
  - the fold hall sensor (gpio80, stock hall_ic "flip") as SW_LID, waking
    the phone when it is opened.
  - the MAX77705 fuel gauge with stock's 2 mOhm sense resistor.
  - the MAX77705 charger with stock's settings and per-port currents, and
    the two cells' S2ASL01 current limiters.
  - the rmtfs shared-memory window off the dtsi's 0x9b800000, where stock
    keeps the camera carveout (the camera image links to that address):
    rmtfs moves to the free gap at 0x9ae00000 and the camera region keeps
    stock's address and size.
  - stock's AFC 9 V and USB PD limits and sink caps, and its dual cell
    charging (zones, full and recharge conditions).
  - audio as in the stock lahaina-mtp-snd-card: the two CS35L41 amps on
    Primary TDM (gpio125-128), the receiver amp (0x41, reset gpio97) on
    slot 0 and the bottom speaker amp (0x40, reset gpio93) on slot 1, with
    stock's TDM framing (short sync, one bit delay, internal sync source);
    the mics are DMICs on the LPASS VA macro (stock main DMIC1, sub DMIC3,
    third DMIC5 on LPI gpio6-9 and 12-13), supplied by L12C, which stock
    keeps on for them. Both amps get the subsystem ID "samsung-b2q", which
    names their speaker protection firmware. Their I2C bus runs at stock's
    1 MHz, which the firmware download needs.

ABL loads U-Boot with this dtb appended and an empty dtbo partition; U-Boot
runs on it and passes it to the kernel.

Signed-off-by: Noa Himesaka <himesaka@noa.codes>
Assisted-by: Claude:claude-opus-5-5
---
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -374,6 +374,7 @@
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8350-hdk.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8350-microsoft-surface-duo2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8350-mtp.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8350-samsung-b2q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8350-sony-xperia-sagami-pdx214.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8350-sony-xperia-sagami-pdx215.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8450-hdk.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8350-samsung-b2q.dts b/arch/arm64/boot/dts/qcom/sm8350-samsung-b2q.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8350-samsung-b2q.dts
@@ -0,0 +1,1835 @@
+/dts-v1/;
+
+/*
+ * Samsung Galaxy Z Flip3 5G (b2q), board-id 08 (SM-F711N).
+ *
+ * Based on the WIP device tree by Alicja Michalska <ellyqw@mainlining.org>
+ * (gitlab.nura.eco/ellyq/sm8350-mainline, commit 7a5e01b2), with the reserved
+ * TLMM pins, ramoops and PMIC GPIO assignments corrected for this board from
+ * its stock device tree.
+ */
+
+#include <dt-bindings/input/gpio-keys.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8350.dtsi"
+#include "pm8350.dtsi"
+#include "pm8350c.dtsi"
+#include "pmk8350.dtsi"
+#include "pmr735a.dtsi"
+#include "pmr735b.dtsi"
+
+// This device's memory mapping for remoteprocs differs a lot from SoC's default
+/delete-node/ &cdsp_secure_heap;
+/delete-node/ &pil_camera_mem;
+/delete-node/ &pil_video_mem;
+/delete-node/ &pil_cvp_mem;
+/delete-node/ &pil_adsp_mem;
+/delete-node/ &pil_slpi_mem;
+/delete-node/ &pil_spss_mem;
+/delete-node/ &rmtfs_mem;
+/delete-node/ &removed_mem;
+
+/ {
+	/*
+	 * ABL does not need msm-id or board-id here (it takes the appended dtb with an
+	 * empty dtbo), but the kernel needs a root compatible: without one,
+	 * of_have_populated_dt() is false, the regulator core refuses dummy supplies, and
+	 * qcom-pcie fails to get its optional vdda supply.
+	 */
+	model = "Samsung Galaxy Z Flip3 5G (SM-F711N)";
+	compatible = "samsung,b2q", "qcom,sm8350";
+
+	chassis-type = "handset";
+
+	aliases {
+		serial0 = &uart2;
+		hsuart0 = &uart18;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		int_lcd_fb: framebuffer@e4000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0xe4000000 0 0x2300000>;
+
+			width = <1080>;
+			height = <2640>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&vol_up_n>;
+
+		key-vol-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8350_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+		};
+
+		/*
+		 * The fold hall sensor, stock hall_ic "flip" (SW_FOLDER, which is
+		 * SW_LID): low when the phone is closed, 50 ms debounce. Only
+		 * opening wakes the phone.
+		 */
+		switch-fold {
+			label = "Fold";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			gpios = <&tlmm 80 GPIO_ACTIVE_LOW>;
+			debounce-interval = <50>;
+			wakeup-source;
+			wakeup-event-action = <EV_ACT_DEASSERTED>;
+		};
+	};
+
+	/*
+	 * QCA6390 power unit. Rails from the stock cnss/bt nodes for board-id 08:
+	 * aon and dig on S11B, io on S10B, rfa2 (1.35 V) on S12B, rfa1 on PM8350C S1.
+	 * WLAN_EN gpio64, BT_EN gpio65.
+	 */
+	qca6390-pmu {
+		compatible = "qcom,qca6390-pmu";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_en_state>, <&wlan_en_state>, <&wlan_fem_sel_state>;
+
+		vddaon-supply = <&vreg_s11b_0p95>;
+		vddpmu-supply = <&vreg_s11b_0p95>;
+		vddrfa0p95-supply = <&vreg_s11b_0p95>;
+		vddrfa1p3-supply = <&vreg_s12b_1p25>;
+		vddrfa1p9-supply = <&vreg_s1c_1p86>;
+		vddpcie1p3-supply = <&vreg_s12b_1p25>;
+		vddpcie1p9-supply = <&vreg_s1c_1p86>;
+		vddio-supply = <&vreg_s10b_1p8>;
+
+		wlan-enable-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 65 GPIO_ACTIVE_HIGH>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p7: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p7";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+
+	reserved-memory {
+		cdsp_secure_heap: memory@80c00000 {
+			reg = <0 0x80c00000 0 0x600000>;
+			no-map;
+		};
+
+		// The dtsi's rmtfs_mem sits at 0x9b800000, where stock keeps the camera
+		// carveout (the camera image links to that address). Stock has no rmtfs
+		// carveout at all; the free gap between pil_modem_mem and the camera
+		// region (0x9ae00000-0x9b800000, unreserved in both trees) fits it.
+		rmtfs_mem: memory@9ae00000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0 0x9ae00000 0 0x280000>;
+			no-map;
+			qcom,client-id = <1>;
+			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+		};
+
+		// Stock's camera PIL region (image linked to this address, dtbo frag 166)
+		pil_camera_mem: memory@9b800000 {
+			reg = <0 0x9b800000 0 0x500000>;
+			no-map;
+		};
+
+		pil_video_mem: memory@9bd00000 {
+			reg = <0 0x9bd00000 0 0x500000>;
+			no-map;
+		};
+
+		pil_cvp_mem: memory@9c200000 {
+			reg = <0 0x9c200000 0 0x500000>;
+			no-map;
+		};
+
+		pil_adsp_mem: memory@85200000 {
+			reg = <0 0x85200000 0 0x3000000>;
+			no-map;
+		};
+
+		pil_slpi_mem: memory@9c700000 {
+			reg = <0 0x9c700000 0 0x1600000>;
+			no-map;
+		};
+
+		pil_spss_mem: memory@8b51c000 {
+			reg = <0 0x8b51c000 0 0x100000>;
+			no-map;
+		};
+
+		// Should be fine with default?
+		pil_modem_mem: memory@8b800000 {
+			reg = <0 0x8b800000 0 0xf600000>;
+			no-map;
+		};
+
+		removed_mem: memory@d8800000 {
+			reg = <0 0xd8800000 0 0x5e00000>;
+			no-map;
+		};
+
+//		framebuffer_cover: memory@9fb00000 {
+//			reg = <0 0x9fb00000 0 0x1000>;
+//			no-map;
+//		};
+
+		/* Samsung's own ramoops address on this board (stock base dtb). */
+		ramoops@f0b00000 {
+			compatible = "ramoops";
+			reg = <0 0xf0b00000 0 0x100000>;
+			record-size = <0x40000>;
+			console-size = <0x80000>;
+		};
+
+		framebuffer_internal: memory@e4000000 {
+			reg = <0 0xe4000000 0 0x2300000>;
+			no-map;
+		};
+	};
+
+	battery: battery {
+		compatible = "simple-battery";
+		/* battery,chg_float_voltage = <0x1158>: 4440 mV */
+		voltage-max-design-microvolt = <4440000>;
+	};
+
+	/*
+	 * Stock sec-dual-battery and sec_battery (dtbo entry.3), age step 0:
+	 * zone rates main/sub 40/85, 33/77, 46/60 %; limiter currents main
+	 * 0-3150 mA, sub 200-3150 mA; cell full 4400 mV at 45 / 115 mA;
+	 * first full below 480 mA (full_check_current_1st) at 4390 mV
+	 * (full_condition_vcell); recharge at 4350 mV
+	 * (recharge_condition_vcell) or 140 mV apart.
+	 */
+	dual-battery {
+		compatible = "samsung,dual-battery";
+		samsung,charger = <&max77705_charger>;
+		samsung,fuel-gauge = <&fuel_gauge>;
+		samsung,main-limiter = <&limiter_main>;
+		samsung,sub-limiter = <&limiter_sub>;
+		samsung,zone-current-rates-percent = <40 85 33 77 46 60>;
+		samsung,limiter-current-range-microamp = <0 3150000 200000 3150000>;
+		samsung,cell-full-microvolt = <4400000 4400000>;
+		samsung,cell-eoc-microamp = <45000 115000>;
+		samsung,full-check-current-microamp = <480000>;
+		samsung,full-condition-microvolt = <4390000>;
+		samsung,recharge-microvolt = <4350000>;
+		samsung,force-recharge-margin-microvolt = <140000>;
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* Stock VA/VP supply of the CS35L41 amps, an always-on rail */
+	dummy_vreg: dummy-vreg {
+		compatible = "regulator-fixed";
+		regulator-name = "dummy_vreg";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* The haptic motor's supply switch (stock max77705_vibrator vib_power) */
+	vib_power: vib-power-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vib_power";
+		gpio = <&tlmm 190 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&vib_power_default>;
+		pinctrl-names = "default";
+	};
+
+	sound: sound {
+		compatible = "qcom,sm8250-sndcard";
+		model = "SM-F711N";
+
+		pinctrl-0 = <&pri_tdm_default>;
+		pinctrl-names = "default";
+
+		/* Stock lahaina-mtp-snd-card routes, DMICs on the mic supply */
+		audio-routing =
+			"VA DMIC0", "vdd-micb",
+			"VA DMIC1", "vdd-micb",
+			"VA DMIC2", "vdd-micb",
+			"VA DMIC3", "vdd-micb",
+			"VA DMIC4", "vdd-micb",
+			"VA DMIC5", "vdd-micb";
+
+		mm1-dai-link {
+			link-name = "MultiMedia1";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+			};
+		};
+
+		mm2-dai-link {
+			link-name = "MultiMedia2";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+			};
+		};
+
+		mm3-dai-link {
+			link-name = "MultiMedia3";
+			cpu {
+				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+			};
+		};
+
+		speaker-playback-dai-link {
+			link-name = "Primary TDM Playback";
+			cpu {
+				sound-dai = <&q6afedai PRIMARY_TDM_RX_0>;
+			};
+			platform {
+				sound-dai = <&q6routing>;
+			};
+			/*
+			 * Codec N takes TDM slot N. Stock: the receiver amp
+			 * (0x41, "Left") on slot 0, the bottom speaker amp
+			 * (0x40, "Right") on slot 1.
+			 */
+			codec {
+				sound-dai = <&earpiece_amp 0>, <&bottom_amp 0>;
+			};
+		};
+
+		va-capture-dai-link {
+			link-name = "VA Capture";
+			cpu {
+				sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
+			};
+			platform {
+				sound-dai = <&q6routing>;
+			};
+			codec {
+				sound-dai = <&vamacro 0>;
+			};
+		};
+	};
+
+	pmic-glink {
+		compatible = "qcom,sm8350-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		orientation-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_1_qmpphy_out>;
+					};
+				};
+
+			};
+		};
+	};
+
+	s2dos05_i2c: i2c-51 {
+		compatible = "i2c-gpio";
+	 	sda-gpios = <&tlmm 104 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 105 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+		pinctrl-0 = <&i2c51_sda_state &i2c51_scl_state>;
+		pinctrl-names = "default";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		pmic@60 {
+			compatible = "samsung,s2dos05";
+			reg = <0x60>;
+
+			regulators {
+					s2dos05_ldo1: ldo1 {
+						regulator-active-discharge = <1>;
+						regulator-enable-ramp-delay = <12000>;
+						regulator-min-microvolt = <1500000>;
+						regulator-max-microvolt = <2000000>;
+						regulator-name = "ldo1";
+					};
+
+					s2dos05_ldo2: ldo2 {
+						regulator-active-discharge = <1>;
+						regulator-boot-on;
+						regulator-enable-ramp-delay = <12000>;
+						regulator-min-microvolt = <1800000>;
+						regulator-max-microvolt = <1800000>;
+						regulator-name = "ldo2";
+					};
+					
+					s2dos05_ldo3: ldo3 {
+						regulator-active-discharge = <1>;
+						regulator-boot-on;
+						regulator-enable-ramp-delay = <12000>;
+						regulator-min-microvolt = <3000000>;
+						regulator-max-microvolt = <3000000>;
+						regulator-name = "ldo3";
+					};
+
+					s2dos05_ldo4: ldo4 {
+						regulator-active-discharge = <1>;
+						regulator-enable-ramp-delay = <12000>;
+						regulator-min-microvolt = <2700000>;
+						regulator-max-microvolt = <3775000>;
+						regulator-name = "ldo4";
+					};
+
+					s2dos05_buck: buck {
+						regulator-active-discharge = <1>;
+						regulator-enable-ramp-delay = <12000>;
+						regulator-min-microvolt = <850000>;
+						regulator-max-microvolt = <2100000>;
+						regulator-name = "buck";
+					};
+			};
+		};
+	};
+};
+
+// PMIC
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8350-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		vdd-s1-supply = <&vph_pwr>;
+		vdd-s2-supply = <&vph_pwr>;
+		vdd-s3-supply = <&vph_pwr>;
+		vdd-s4-supply = <&vph_pwr>;
+		vdd-s5-supply = <&vph_pwr>;
+		vdd-s6-supply = <&vph_pwr>;
+		vdd-s7-supply = <&vph_pwr>;
+		vdd-s8-supply = <&vph_pwr>;
+		vdd-s9-supply = <&vph_pwr>;
+		vdd-s10-supply = <&vph_pwr>;
+		vdd-s11-supply = <&vph_pwr>;
+		vdd-s12-supply = <&vph_pwr>;
+
+		vdd-l1-l4-supply = <&vreg_s11b_0p95>;
+		vdd-l2-l7-supply = <&vreg_bob>;
+		vdd-l3-l5-supply = <&vreg_bob>;
+		vdd-l6-l9-l10-supply = <&vreg_s11b_0p95>;
+
