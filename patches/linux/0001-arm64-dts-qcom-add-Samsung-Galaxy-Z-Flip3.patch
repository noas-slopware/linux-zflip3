+		haptic {
+			compatible = "maxim,max77705-haptic";
+			haptic-supply = <&vib_power>;
+			/* stock haptic,frequency 205.0 Hz: 78125000 / 2050 ns */
+			pwms = <&motor_pwm 0 38109>;
+		};
+	};
+
+	/*
+	 * Stock max77705-fuelgauge: fg_resistor 5, Samsung's unit for 2 mOhm
+	 * (1 is 10 mOhm, 2 is 5 mOhm).
+	 */
+	fuel_gauge: fuel-gauge@36 {
+		compatible = "maxim,max77705-battery";
+		reg = <0x36>;
+		maxim,rsns-microohm = <2000>;
+		power-supplies = <&max77705_charger>;
+		interrupt-parent = <&max77705>;
+		interrupts = <2>;
+	};
+
+	/* Stock max77705-charger, battery and cable-info values (dtbo entry.3) */
+	max77705_charger: charger@69 {
+		compatible = "maxim,max77705-charger";
+		reg = <0x69>;
+		monitored-battery = <&battery>;
+
+		/* BC1.2 port type from the USB-C block (MFD irq 3) */
+		maxim,pmic = <&max77705>;
+		interrupt-parent = <&max77705>;
+		interrupts = <0>, <3>;
+
+		/* cable-info: SDP 475/550, CDP 1500/1500, DCP 1800/2100 mA */
+		maxim,input-current-limits-microamp = <475000 1500000 1800000>;
+		maxim,charge-current-limits-microamp = <550000 1500000 2100000>;
+
+		/* charger,fsw = <0>: 3 MHz */
+		maxim,switching-frequency-hz = <3000000>;
+		/* battery,topoff_time = <70> */
+		maxim,topoff-time-minutes = <70>;
+		/* battery,chg_ocp_current = <0>: BAT to SYS OCP off */
+		maxim,b2sovrc-current-microamp = <0>;
+		/* battery,chg_ocp_dtc = <100> */
+		maxim,b2sovrc-dtc-100ms;
+
+		/* AFC 9 V: cable-info current_group_4 (9V_TA) 1650/2850 mA */
+		maxim,hv-input-current-microamp = <1650000>;
+		maxim,hv-charge-current-microamp = <2850000>;
+
+		/*
+		 * USB PD: battery,pd_charging_charge_power 15 W,
+		 * max_input_voltage 9 V, max_input_current 3 A,
+		 * max_charging_current 2850 mA; max77705,snkcap_data.
+		 */
+		maxim,pd-max-power-microwatt = <15000000>;
+		maxim,pd-max-voltage-microvolt = <9000000>;
+		maxim,pd-max-input-current-microamp = <3000000>;
+		maxim,pd-max-charge-current-microamp = <2850000>;
+		maxim,pd-sink-caps = /bits/ 8 <0x03 0x2c 0x91 0x01 0x36 0xc8 0xd0 0x02
+						0x00 0xc8 0x90 0x41 0x8b>;
+	};
+};
