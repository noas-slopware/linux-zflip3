+/* Power and Volume Down: PMK8350 PON, kpdpwr and resin (stock qcom,pon_1/pon_2) */
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+/*
+ * The RTC as in the stock tree. Its write channel belongs to TrustZone, so
+ * the time is kept as an offset from the counter, in SDAM14 (owned by the
+ * application processor, unused by stock).
+ */
+&pmk8350_rtc {
+	nvmem-cells = <&rtc_offset>;
+	nvmem-cell-names = "offset";
+
+	status = "okay";
+};
+
+&pmk8350_sdam_14 {
+	rtc_offset: rtc-offset@bc {
+		reg = <0xbc 0x4>;
+	};
+};
+
+/*
+ * The haptic motor's PWM: GCC GP2 on gpio116, as stock samsung,pwm_gpclk.
+ * Stock drives the LRA at most 73 % (haptic,normal_ratio) either side of
+ * standstill.
+ */
+&soc {
+	motor_pwm: pwm@165000 {
+		compatible = "qcom,gcc-gp-pwm";
+		reg = <0x0 0x00165000 0x0 0x18>;
+		clocks = <&gcc GCC_GP2_CLK>;
+		#pwm-cells = <2>;
+		samsung,lra-ratio = <73>;
+		pinctrl-0 = <&motor_pwm_default>;
+		pinctrl-names = "default";
+	};
+};
+
+&pmk8350_gpios {
+	gpio-line-names =
+		"USB_PBA_ID",
+		"SLAVE_PCB_TYPE",
+		"NC",
+		"NC";
+};
