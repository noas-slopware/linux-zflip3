+	max77705: pmic@66 {
+		compatible = "maxim,max77705";
+		reg = <0x66>;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&pm8350c_gpios>;
+		interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-controller;
+		pinctrl-0 = <&pmic_int_default>;
