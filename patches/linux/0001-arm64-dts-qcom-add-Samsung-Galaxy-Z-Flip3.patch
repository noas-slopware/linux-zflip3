+/*
+ * The mics are DMICs on the LPASS VA macro (stock: wcd-disabled, main DMIC1,
+ * sub DMIC3, third DMIC5), clocked at stock's 2.4 MHz recording rate. Their
+ * supply is L12C, which the stock audio overlay keeps always on.
+ */
+&vamacro {
+	pinctrl-0 = <&dmic01_default>, <&dmic23_default>, <&dmic45_default>;
+	pinctrl-names = "default";
+	vdd-micb-supply = <&vreg_l12c_1p8>;
+	qcom,dmic-sample-rate = <2400000>;
+	status = "okay";
+};
+
+&lpass_tlmm {
+	dmic01_default: dmic01-default-state {
+		clk-pins {
+			pins = "gpio6";
+			function = "dmic1_clk";
+			drive-strength = <2>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio7";
+			function = "dmic1_data";
+			drive-strength = <2>;
+			input-enable;
+		};
+	};
+
+	dmic23_default: dmic23-default-state {
+		clk-pins {
+			pins = "gpio8";
+			function = "dmic2_clk";
+			drive-strength = <2>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio9";
+			function = "dmic2_data";
+			drive-strength = <2>;
+			input-enable;
+		};
+	};
+
+	dmic45_default: dmic45-default-state {
+		clk-pins {
+			pins = "gpio12";
+			function = "dmic3_clk";
+			drive-strength = <2>;
+			output-high;
+		};
+
+		data-pins {
+			pins = "gpio13";
+			function = "dmic3_data";
+			drive-strength = <2>;
+			input-enable;
+		};
+	};
+};
