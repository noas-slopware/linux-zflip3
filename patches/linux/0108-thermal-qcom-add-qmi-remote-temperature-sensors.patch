+	struct qmi_response_type_v01 resp;
+	u8 sensor_list_valid;
+	u32 sensor_list_len;
+	struct ts_sensor_type sensor_list[QMI_TS_SENSOR_LIST_MAX];
+	u8 sensor_list_ext01_valid;
+	u32 sensor_list_ext01_len;
+	struct ts_sensor_type sensor_list_ext01[QMI_TS_SENSOR_LIST_EXT01_MAX];
+};
+
+struct ts_register_notification_req {
+	struct ts_sensor_type sensor_id;
+	u8 send_current_temp_report;
+	u8 temp_threshold_high_valid;
+	u32 temp_threshold_high;
+	u8 temp_threshold_low_valid;
+	u32 temp_threshold_low;
+	u8 seq_num_valid;
+	u32 seq_num;
+};
+
+struct ts_register_notification_resp {
+	struct qmi_response_type_v01 resp;
+};
+
+struct ts_temp_report_ind {
+	struct ts_sensor_type sensor_id;
+	s32 report_type;
+	u8 temp_valid;
+	u32 temp;
+	u8 seq_num_valid;
+	u32 seq_num;
+};
+
