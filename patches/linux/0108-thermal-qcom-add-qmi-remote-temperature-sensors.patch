+#include <linux/thermal.h>
+#include <linux/workqueue.h>
+
+#define TS_SERVICE_ID			0x17
+#define TS_SERVICE_VERS			0x01
+
+#define QMI_TS_GET_SENSOR_LIST		0x0020
+#define QMI_TS_REGISTER_NOTIFICATION	0x0021
+#define QMI_TS_TEMP_REPORT_IND		0x0022
+
+#define QMI_TS_SENSOR_ID_LEN		32
+#define QMI_TS_SENSOR_LIST_MAX		32
+#define QMI_TS_SENSOR_LIST_EXT01_MAX	64
+
+#define QMI_TS_GET_SENSOR_LIST_REQ_LEN	0
+#define QMI_TS_GET_SENSOR_LIST_RESP_LEN	3183
+#define QMI_TS_REGISTER_REQ_LEN		61
+#define QMI_TS_IND_LEN			57
+
+#define QMI_TS_REPORT_CURRENT		0
+
+#define QMI_TS_RESP_TIMEOUT		msecs_to_jiffies(100)
+/* The current-temperature report arrives as an indication after the response. */
+#define QMI_TS_READ_TIMEOUT		msecs_to_jiffies(500)
+
+struct ts_sensor_type {
+	char sensor_id[QMI_TS_SENSOR_ID_LEN + 1];
+};
+
+struct ts_get_sensor_list_req {
+	char placeholder;
+};
+
