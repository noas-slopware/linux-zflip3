+
+static const struct qmi_elem_info ts_register_notification_req_ei[] = {
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 1,
+		.elem_size	= sizeof(struct ts_sensor_type),
+		.tlv_type	= 0x01,
+		.offset		= offsetof(struct ts_register_notification_req, sensor_id),
+		.ei_array	= ts_sensor_type_ei,
+	},
+	{
+		.data_type	= QMI_UNSIGNED_1_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.tlv_type	= 0x02,
+		.offset		= offsetof(struct ts_register_notification_req,
+					   send_current_temp_report),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct ts_register_notification_req,
+					   temp_threshold_high_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u32),
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct ts_register_notification_req,
+					   temp_threshold_high),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.tlv_type	= 0x11,
+		.offset		= offsetof(struct ts_register_notification_req,
+					   temp_threshold_low_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u32),
+		.tlv_type	= 0x11,
+		.offset		= offsetof(struct ts_register_notification_req,
+					   temp_threshold_low),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.tlv_type	= 0x12,
+		.offset		= offsetof(struct ts_register_notification_req, seq_num_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u32),
+		.tlv_type	= 0x12,
+		.offset		= offsetof(struct ts_register_notification_req, seq_num),
+	},
+	{ .data_type = QMI_EOTI, .tlv_type = QMI_COMMON_TLV_TYPE },
+};
+
+static const struct qmi_elem_info ts_register_notification_resp_ei[] = {
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 1,
+		.elem_size	= sizeof(struct qmi_response_type_v01),
+		.tlv_type	= 0x02,
+		.offset		= offsetof(struct ts_register_notification_resp, resp),
+		.ei_array	= qmi_response_type_v01_ei,
+	},
+	{ .data_type = QMI_EOTI, .tlv_type = QMI_COMMON_TLV_TYPE },
+};
+
+static const struct qmi_elem_info ts_temp_report_ind_ei[] = {
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 1,
+		.elem_size	= sizeof(struct ts_sensor_type),
+		.tlv_type	= 0x01,
+		.offset		= offsetof(struct ts_temp_report_ind, sensor_id),
+		.ei_array	= ts_sensor_type_ei,
+	},
+	{
+		.data_type	= QMI_SIGNED_4_BYTE_ENUM,
+		.elem_len	= 1,
+		.elem_size	= sizeof(s32),
+		.tlv_type	= 0x02,
+		.offset		= offsetof(struct ts_temp_report_ind, report_type),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct ts_temp_report_ind, temp_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u32),
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct ts_temp_report_ind, temp),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.tlv_type	= 0x11,
+		.offset		= offsetof(struct ts_temp_report_ind, seq_num_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u32),
+		.tlv_type	= 0x11,
+		.offset		= offsetof(struct ts_temp_report_ind, seq_num),
+	},
+	{ .data_type = QMI_EOTI, .tlv_type = QMI_COMMON_TLV_TYPE },
+};
+
+/* Sensor names the TS service uses; the index is the thermal sensor id. */
+static const char * const qmi_ts_names[] = {
+	"pa", "pa_1", "pa_2", "qfe_pa0", "qfe_wtr0", "modem_tsens",
+	"qfe_mmw0", "qfe_mmw1", "qfe_mmw2", "qfe_mmw3", "xo_therm",
+	"qfe_pa_mdm", "qfe_pa_wtr", "qfe_mmw_streamer0", "qfe_mmw0_mod",
+	"qfe_mmw1_mod", "qfe_mmw2_mod", "qfe_mmw3_mod", "qfe_ret_pa0",
+	"qfe_wtr_pa0", "qfe_wtr_pa1", "qfe_wtr_pa2", "qfe_wtr_pa3",
+	"sys_therm1", "sys_therm2", "modem_tsens1", "mmw_pa1", "mmw_pa2",
+	"mmw_pa3", "sdr_mmw_therm", "msm_skin_therm", "beamer_n_therm",
+	"beamer_e_therm", "beamer_w_therm", "qfe_ret_pa0_fr1",
+	"qfe_wtr_pa0_fr1", "qfe_wtr_pa1_fr1", "qfe_wtr_pa2_fr1",
+	"qfe_wtr_pa3_fr1", "qfe_wtr0_fr1", "qtm_therm", "modem_bcl_warn",
+	"sdr0_pa0", "sdr0_pa1", "sdr0_pa2", "sdr0_pa3", "sdr0_pa4",
+	"sdr0_pa5", "sdr0", "sdr1_pa0", "sdr1_pa1", "sdr1_pa2", "sdr1_pa3",
+	"sdr1_pa4", "sdr1_pa5", "sdr1", "mmw0", "mmw1", "mmw2", "mmw3",
+	"mmw_ific0", "rf_cal", "qfe_wtr_pa4", "qfe_wtr_pa5", "qfe_wtr_pa6",
+	"qfe_wtr_pa4_fr1", "qfe_wtr_pa5_fr1", "qfe_wtr_pa6_fr1",
+	"qfe_ret_pa1", "qfe_ret_pa1_fr1", "sdr0_pa", "sdr1_pa",
+};
+
+struct qmi_ts_instance;
+
+struct qmi_ts_sensor {
+	struct qmi_ts_instance *inst;
+	const char *name;
+	unsigned int id;
+	struct thermal_zone_device *tzd;
+	bool active;
+	int last_temp;			/* millicelsius */
+	bool have_temp;
+	struct completion reading;
+	int high;
+	int low;
+	struct work_struct notify_work;
+};
+
+struct qmi_ts_instance {
+	struct device *dev;
+	struct qmi_handle handle;
+	struct mutex lock;		/* serialises requests on the handle */
+	u32 instance_id;
+	struct qmi_ts_sensor *sensors;
+	unsigned int num_sensors;
+	struct work_struct arrive_work;
+};
+
+/* The service carries temperatures as IEEE 754 single precision, in Celsius. */
+static int qmi_ts_float_to_mc(u32 bits, int *mc)
+{
+	int exp = (bits >> 23) & 0xff;
+	u64 val = ((u64)(bits & 0x7fffff) | 0x800000) * 1000;
+	int shift;
+
+	if (exp == 0xff)
+		return -ERANGE;
+	if (exp == 0) {
+		*mc = 0;
+		return 0;
+	}
+
+	shift = exp - 127 - 23;
+	if (shift > 0) {
+		if (shift > 20)
+			return -ERANGE;
+		val <<= shift;
+	} else {
+		val = -shift >= 64 ? 0 : val >> -shift;
+	}
+	if (val > INT_MAX)
+		return -ERANGE;
+
+	*mc = bits & BIT(31) ? -(int)val : (int)val;
+	return 0;
+}
+
+static u32 qmi_ts_mc_to_float(int mc)
+{
+	u64 mag = abs((s64)mc);
+	u32 sign = mc < 0 ? BIT(31) : 0;
+	u64 fixed;
+	int msb;
+
+	if (!mag)
+		return 0;
+
+	/* Celsius in 32.32 fixed point, then normalise to a 24-bit mantissa. */
+	fixed = div_u64(mag << 32, 1000);
+	msb = fls64(fixed) - 1;
+	if (msb > 23)
+		fixed >>= msb - 23;
+	else
+		fixed <<= 23 - msb;
+
+	return sign | (u32)(msb - 32 + 127) << 23 | (fixed & 0x7fffff);
+}
+
+static int qmi_ts_send(struct qmi_ts_sensor *s, bool current_report)
+{
+	struct qmi_ts_instance *inst = s->inst;
+	struct ts_register_notification_resp resp = {};
+	struct ts_register_notification_req req = {};
+	struct qmi_txn txn;
+	int ret;
+
+	strscpy(req.sensor_id.sensor_id, s->name, sizeof(req.sensor_id.sensor_id));
+	if (current_report) {
+		req.send_current_temp_report = 1;
+		req.seq_num_valid = 1;
+	} else {
+		req.temp_threshold_high_valid = s->high < INT_MAX;
+		req.temp_threshold_high = qmi_ts_mc_to_float(s->high);
+		req.temp_threshold_low_valid = s->low > -INT_MAX;
+		req.temp_threshold_low = qmi_ts_mc_to_float(s->low);
+	}
+
+	mutex_lock(&inst->lock);
+	ret = qmi_txn_init(&inst->handle, &txn, ts_register_notification_resp_ei, &resp);
+	if (ret < 0)
+		goto out;
+
+	ret = qmi_send_request(&inst->handle, NULL, &txn, QMI_TS_REGISTER_NOTIFICATION,
+			       QMI_TS_REGISTER_REQ_LEN, ts_register_notification_req_ei, &req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		goto out;
+	}
+
+	/* On success this is the length of the decoded response. */
+	ret = qmi_txn_wait(&txn, QMI_TS_RESP_TIMEOUT);
+	if (ret >= 0)
+		ret = resp.resp.result == QMI_RESULT_SUCCESS_V01 ? 0 : -EREMOTEIO;
+out:
+	mutex_unlock(&inst->lock);
+	if (ret)
+		dev_dbg(inst->dev, "%s: request failed: %d\n", s->name, ret);
+	return ret;
+}
+
+static int qmi_ts_get_temp(struct thermal_zone_device *tzd, int *temp)
+{
+	struct qmi_ts_sensor *s = thermal_zone_device_priv(tzd);
+
+	/*
+	 * Ask for a current report and wait for it. If that fails, or while
+	 * the remote is down, report the last reading, as downstream does.
+	 */
+	if (READ_ONCE(s->active)) {
+		reinit_completion(&s->reading);
+		if (!qmi_ts_send(s, true))
+			wait_for_completion_timeout(&s->reading, QMI_TS_READ_TIMEOUT);
+	}
+
+	if (!READ_ONCE(s->have_temp))
+		return -ENODATA;
+
+	*temp = READ_ONCE(s->last_temp);
+	return 0;
+}
+
+static int qmi_ts_set_trips(struct thermal_zone_device *tzd, int low, int high)
+{
+	struct qmi_ts_sensor *s = thermal_zone_device_priv(tzd);
+
+	if (s->low == low && s->high == high)
+		return 0;
+
+	s->low = low;
+	s->high = high;
+	if (!READ_ONCE(s->active))
+		return 0;
+
+	return qmi_ts_send(s, false);
+}
+
+static const struct thermal_zone_device_ops qmi_ts_ops = {
+	.get_temp = qmi_ts_get_temp,
+	.set_trips = qmi_ts_set_trips,
+};
+
+static void qmi_ts_notify_work(struct work_struct *work)
+{
+	struct qmi_ts_sensor *s = container_of(work, struct qmi_ts_sensor, notify_work);
+
+	if (s->tzd)
+		thermal_zone_device_update(s->tzd, THERMAL_EVENT_UNSPECIFIED);
+}
+
+static void qmi_ts_ind_cb(struct qmi_handle *handle, struct sockaddr_qrtr *sq,
+			  struct qmi_txn *txn, const void *data)
+{
+	struct qmi_ts_instance *inst = container_of(handle, struct qmi_ts_instance, handle);
+	const struct ts_temp_report_ind *ind = data;
+	struct qmi_ts_sensor *s;
+	unsigned int i;
+	int mc;
+
+	if (!ind->temp_valid || qmi_ts_float_to_mc(ind->temp, &mc))
+		return;
+
+	for (i = 0; i < inst->num_sensors; i++) {
+		s = &inst->sensors[i];
+		if (strncasecmp(s->name, ind->sensor_id.sensor_id, QMI_TS_SENSOR_ID_LEN))
+			continue;
+
+		WRITE_ONCE(s->last_temp, mc);
+		WRITE_ONCE(s->have_temp, true);
+		complete(&s->reading);
+
+		/* Threshold crossings come as their own report type. */
+		if (ind->report_type != QMI_TS_REPORT_CURRENT && !ind->seq_num_valid)
+			queue_work(system_highpri_wq, &s->notify_work);
+		return;
+	}
+}
+
+static const struct qmi_msg_handler qmi_ts_handlers[] = {
+	{
+		.type = QMI_INDICATION,
+		.msg_id = QMI_TS_TEMP_REPORT_IND,
+		.ei = ts_temp_report_ind_ei,
+		.decoded_size = sizeof(struct ts_temp_report_ind),
+		.fn = qmi_ts_ind_cb,
+	},
+	{}
+};
+
+static void qmi_ts_activate(struct qmi_ts_instance *inst, const char *id)
+{
+	struct thermal_zone_device *tzd;
+	struct qmi_ts_sensor *s;
+	unsigned int i;
+
+	for (i = 0; i < inst->num_sensors; i++) {
+		s = &inst->sensors[i];
+		if (strncasecmp(s->name, id, QMI_TS_SENSOR_ID_LEN))
+			continue;
+
+		WRITE_ONCE(s->active, true);
+		if (!s->tzd) {
+			/* Register zones as the remote lists their sensors, as downstream. */
+			tzd = devm_thermal_of_zone_register(inst->dev, s->id + inst->instance_id,
+							    s, &qmi_ts_ops);
+			if (IS_ERR(tzd)) {
+				if (PTR_ERR(tzd) != -ENODEV)
+					dev_err(inst->dev, "%s: zone registration failed: %pe\n",
+						s->name, tzd);
+				return;
+			}
+			s->tzd = tzd;
+		} else if (s->high < INT_MAX || s->low > -INT_MAX) {
+			/* The service restarted: re-arm the thresholds it forgot. */
+			qmi_ts_send(s, false);
+		}
+		return;
+	}
+}
+
+static void qmi_ts_arrive_work(struct work_struct *work)
+{
+	struct qmi_ts_instance *inst = container_of(work, struct qmi_ts_instance, arrive_work);
+	struct ts_get_sensor_list_req req = {};
+	struct ts_get_sensor_list_resp *resp;
+	struct qmi_txn txn;
+	unsigned int i;
+	int ret;
+
+	resp = kzalloc_obj(*resp);
+	if (!resp)
+		return;
+
+	mutex_lock(&inst->lock);
+	ret = qmi_txn_init(&inst->handle, &txn, ts_get_sensor_list_resp_ei, resp);
+	if (ret < 0)
+		goto unlock;
+
+	ret = qmi_send_request(&inst->handle, NULL, &txn, QMI_TS_GET_SENSOR_LIST,
+			       QMI_TS_GET_SENSOR_LIST_REQ_LEN, ts_get_sensor_list_req_ei, &req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		goto unlock;
+	}
+
+	ret = qmi_txn_wait(&txn, QMI_TS_RESP_TIMEOUT);
+	if (ret >= 0)
+		ret = resp->resp.result == QMI_RESULT_SUCCESS_V01 ? 0 : -EREMOTEIO;
+unlock:
+	mutex_unlock(&inst->lock);
+	if (ret) {
+		dev_err(inst->dev, "instance %u: sensor list failed: %d\n", inst->instance_id, ret);
+		goto out;
+	}
+
+	for (i = 0; resp->sensor_list_valid && i < resp->sensor_list_len; i++)
+		qmi_ts_activate(inst, resp->sensor_list[i].sensor_id);
+	for (i = 0; resp->sensor_list_ext01_valid && i < resp->sensor_list_ext01_len; i++)
+		qmi_ts_activate(inst, resp->sensor_list_ext01[i].sensor_id);
+out:
+	kfree(resp);
+}
+
+static int qmi_ts_new_server(struct qmi_handle *handle, struct qmi_service *svc)
+{
+	struct qmi_ts_instance *inst = container_of(handle, struct qmi_ts_instance, handle);
+	struct sockaddr_qrtr sq = { AF_QIPCRTR, svc->node, svc->port };
+	int ret;
+
+	mutex_lock(&inst->lock);
+	ret = kernel_connect(handle->sock, (struct sockaddr_unsized *)&sq, sizeof(sq), 0);
+	mutex_unlock(&inst->lock);
+	if (ret)
+		return ret;
+
+	queue_work(system_highpri_wq, &inst->arrive_work);
+	return 0;
+}
+
+static void qmi_ts_del_server(struct qmi_handle *handle, struct qmi_service *svc)
+{
+	struct qmi_ts_instance *inst = container_of(handle, struct qmi_ts_instance, handle);
+	unsigned int i;
+
+	for (i = 0; i < inst->num_sensors; i++)
+		WRITE_ONCE(inst->sensors[i].active, false);
+}
+
+static const struct qmi_ops qmi_ts_qmi_ops = {
+	.new_server = qmi_ts_new_server,
+	.del_server = qmi_ts_del_server,
+};
+
+static void qmi_ts_release(void *data)
+{
+	struct qmi_ts_instance *inst = data;
+	unsigned int i;
+
+	/* The arrival work uses the handle, the indications queue notify work. */
+	disable_work_sync(&inst->arrive_work);
+	qmi_handle_release(&inst->handle);
+	for (i = 0; i < inst->num_sensors; i++)
+		cancel_work_sync(&inst->sensors[i].notify_work);
+}
+
+static int qmi_ts_probe_instance(struct device *dev, struct device_node *np,
+				 struct qmi_ts_instance **instp)
+{
+	struct qmi_ts_instance *inst;
+	unsigned int i, j;
+	int count, ret;
+
+	inst = devm_kzalloc(dev, sizeof(*inst), GFP_KERNEL);
+	if (!inst)
+		return -ENOMEM;
+
+	inst->dev = dev;
+	mutex_init(&inst->lock);
+	INIT_WORK(&inst->arrive_work, qmi_ts_arrive_work);
+
+	ret = of_property_read_u32(np, "qcom,instance-id", &inst->instance_id);
+	if (ret)
+		return dev_err_probe(dev, ret, "%pOF: no qcom,instance-id\n", np);
+
+	count = of_property_count_strings(np, "qcom,qmi-sensor-names");
+	if (count <= 0)
+		return dev_err_probe(dev, -EINVAL, "%pOF: no qcom,qmi-sensor-names\n", np);
+
+	inst->sensors = devm_kcalloc(dev, count, sizeof(*inst->sensors), GFP_KERNEL);
+	if (!inst->sensors)
+		return -ENOMEM;
+	inst->num_sensors = count;
+
+	for (i = 0; i < count; i++) {
+		struct qmi_ts_sensor *s = &inst->sensors[i];
+
+		of_property_read_string_index(np, "qcom,qmi-sensor-names", i, &s->name);
+		for (j = 0; j < ARRAY_SIZE(qmi_ts_names); j++)
+			if (!strcmp(qmi_ts_names[j], s->name))
+				break;
+		if (j == ARRAY_SIZE(qmi_ts_names))
+			return dev_err_probe(dev, -EINVAL, "unknown sensor %s\n", s->name);
+
+		s->inst = inst;
+		s->id = j;
+		s->low = -INT_MAX;
+		s->high = INT_MAX;
+		init_completion(&s->reading);
+		INIT_WORK(&s->notify_work, qmi_ts_notify_work);
+	}
+
+	ret = qmi_handle_init(&inst->handle, QMI_TS_GET_SENSOR_LIST_RESP_LEN,
+			      &qmi_ts_qmi_ops, qmi_ts_handlers);
+	if (ret)
+		return dev_err_probe(dev, ret, "QMI handle init failed\n");
+
+	ret = devm_add_action_or_reset(dev, qmi_ts_release, inst);
+	if (ret)
+		return ret;
+	*instp = inst;
+
+	return qmi_add_lookup(&inst->handle, TS_SERVICE_ID, TS_SERVICE_VERS, inst->instance_id);
+}
+
+struct qmi_ts_priv {
+	unsigned int num;
+	struct qmi_ts_instance *inst[] __counted_by(num);
+};
+
+static int qmi_ts_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	unsigned int count = of_get_available_child_count(dev->of_node);
+	struct qmi_ts_priv *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, struct_size(priv, inst, count), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->num = count;
+	platform_set_drvdata(pdev, priv);
+
+	count = 0;
+	for_each_available_child_of_node_scoped(dev->of_node, child) {
+		ret = qmi_ts_probe_instance(dev, child, &priv->inst[count++]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * The zones are registered from the arrival work with devres, which releases
+ * them after remove: stop the QMI handles and their work first.
+ */
+static void qmi_ts_remove(struct platform_device *pdev)
+{
+	struct qmi_ts_priv *priv = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	for (i = 0; i < priv->num; i++)
+		devm_release_action(&pdev->dev, qmi_ts_release, priv->inst[i]);
+}
+
+static const struct of_device_id qmi_ts_of_match[] = {
+	{ .compatible = "qcom,qmi-sensors" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, qmi_ts_of_match);
+
+static struct platform_driver qmi_ts_driver = {
+	.probe = qmi_ts_probe,
+	.remove = qmi_ts_remove,
+	.driver = {
+		.name = "qcom-qmi-ts",
+		.of_match_table = qmi_ts_of_match,
+	},
+};
+module_platform_driver(qmi_ts_driver);
+
+MODULE_DESCRIPTION("Qualcomm QMI thermal sensors of remote processors");
+MODULE_LICENSE("GPL");
