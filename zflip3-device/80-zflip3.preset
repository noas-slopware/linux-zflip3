# Galaxy Z Flip3 (zflip3-system): what runs on the phone. Applied by `systemctl preset-all` when the
# image is made, and by `systemctl preset <unit>` for a newly installed one. The same set
# tools/build-rootfs.sh on the senpai branch enables.
enable NetworkManager.service
enable NetworkManager-wait-online.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable bluetooth.service
enable sshd.service
enable serial-getty@.service ttyGS0
# systemd-networkd only runs usb0 (50-usb0.network), which never decides whether the phone is
# online: its wait-online could only time out and hold network-online.target for 2 minutes.
enable systemd-networkd.service
disable systemd-networkd-wait-online.service
enable akari-wifi.service
enable renge.service
enable rmtfs.service
enable tqftpserv.service
enable hexagonrpcd-sdsp.service
enable claire.service
enable ModemManager.service
enable 81voltd.service
enable simamura.service
enable imsroha.service
enable imsroha-bearer.service
enable imsroha-vss-samsung.service
enable imsroha-rcs.service
enable plasmalogin.service
