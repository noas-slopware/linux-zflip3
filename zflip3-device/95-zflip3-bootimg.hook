# After mkinitcpio (90-mkinitcpio-install.hook) has built the initramfs: pack the boot image and
# write it to the recovery partition U-Boot boots from.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/dtb/qcom/sm8350-samsung-b2q.dtb
Target = usr/lib/initcpio/*
Target = usr/share/zflip3/cmdline
Target = usr/bin/zflip3-bootimg

[Action]
Description = Writing the Galaxy Z Flip3 boot image to recovery...
When = PostTransaction
Exec = /usr/bin/zflip3-bootimg
Depends = android-tools
