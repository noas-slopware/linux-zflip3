# Raw material that must not be committed.
.cache/
out/
downstream/

# Device and firmware dumps. Keep the small summaries in evidence/, not the blobs.
evidence/raw/
evidence/device/*
!evidence/device/.gitkeep

# Build products.
*.img
*.img.lz4
*.tar
*.tar.md5
*.cpio
*.cpio.gz
*.zst
*.dtb
__pycache__/
# makepkg's git source mirrors next to a PKGBUILD (source=(name::git+...)).
userspace/libcamera/libcamera/
# Native syntax-check builds from userspace/kita/build.sh.
userspace/kita/kita
userspace/kita/lease-modeset

# Local work that is not part of the project: scratch tests (they carry device
# identities), other people's AUR packaging trees, tool state.
scratch/
clatd-git/
tayga/
.commandcode/

# Work notes, logs and personal settings live in ~/zflip3-private/linux-zflip3
# (notes/ is symlinked here so the sessions working in this checkout still read them;
# rootfs/ is tools/build-rootfs.sh --overlay).
/AGENTS.md
/STATE.md
/HANDOVER*.md
/odin4.log
