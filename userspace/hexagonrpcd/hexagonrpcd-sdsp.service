# SPDX-License-Identifier: MIT
# The SLPI (sdsp) serves the sensor hub; it asks the AP for the files under
# /usr/share/qcom/sm8350/Samsung/b2q: sensor config, the per-unit registry and
# the DSP skels. -s selects the sensor service, -d sdsp the dsp/ subdirectory.
[Unit]
Description=Qualcomm HexagonFS daemon for the b2q sensor hub
Requires=dev-fastrpc\x2dsdsp.device
After=dev-fastrpc\x2dsdsp.device renge.service
Wants=renge.service
Before=iio-sensor-proxy.service

[Service]
User=fastrpc
Group=fastrpc
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-sdsp -d sdsp -s \
	-R /usr/share/qcom/sm8350/Samsung/b2q
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
