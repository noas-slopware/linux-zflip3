[Unit]
Description=Skin temperature estimate and SIOP CPU/GPU limits (stock's LRP2)
Documentation=file:///usr/share/doc/mihari/README.md
ConditionPathExists=/usr/share/mihari/model.conf
# OPP voltages for stock's gold/prime voltage match
Wants=sys-kernel-debug.mount
After=sys-kernel-debug.mount systemd-modules-load.service

[Service]
ExecStart=/usr/lib/mihari/mihari
RuntimeDirectory=mihari
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
