+QCoro::Task<std::optional<QString>> Database::idForMessageId(const QString &messageId)
+{
+    auto id = co_await m_database->getResult<SingleValue<QString>>(SL("SELECT id FROM Messages WHERE messageId == ? AND transport == 'rcs' LIMIT 1"),
+                                                                   messageId);
+    co_return map(std::move(id), [](auto &&v) {
+        return v.value;
+    });
+}
+
+QCoro::Task<QStringList> Database::unreadRcsMessageIds(const PhoneNumberList &phoneNumberList)
+{
+    const auto rows = co_await m_database->getResults<SingleValue<QString>>(
+        SL("SELECT messageId FROM Messages WHERE phoneNumber == ? AND transport == 'rcs' AND sentByMe == False AND NOT read == True"),
+        phoneNumberList.toString());
+    QStringList ids;
+    for (const auto &r : rows) {
+        if (!r.value.isEmpty()) {
+            ids.append(r.value);
+        }
+    }
+    co_return ids;
+}
+
+QCoro::Task<> Database::updateMessageTransport(const QString &id, const QString &transport)
+{
+    co_await m_database->execute(SL("UPDATE Messages SET transport = ? WHERE id == ?"), transport.isEmpty() ? QVariant() : transport, id);
+}
+
