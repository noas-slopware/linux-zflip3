diff --git a/daemon/rcstransport.cpp b/daemon/rcstransport.cpp
new file mode 100644
index 0000000..a20c57a
--- /dev/null
+++ b/daemon/rcstransport.cpp
@@ -0,0 +1,150 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#include "rcstransport.h"
+
+#include <QDBusConnection>
+#include <QDBusInterface>
+#include <QDBusMessage>
+#include <QDBusPendingCall>
+#include <QDBusPendingReply>
+#include <QDBusVariant>
+#include <QDebug>
+
+#include <QCoroDBusPendingReply>
+
+#include <global.h>
+
+static const QString RCS_SERVICE = SL("codes.noa.IMSroha.Rcs");
+static const QString RCS_PATH = SL("/codes/noa/IMSroha/Rcs");
+static const QString RCS_IFACE = SL("codes.noa.IMSroha.Rcs");
+
+RcsTransport::RcsTransport(QObject *parent)
+    : QObject(parent)
+    , m_watcher(RCS_SERVICE, QDBusConnection::systemBus(), QDBusServiceWatcher::WatchForOwnerChange)
+{
+    auto bus = QDBusConnection::systemBus();
+    bus.connect(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("MessageReceived"), this, SLOT(onMessageReceived(QString, QString, QString, qlonglong)));
+    bus.connect(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("MessageStatusChanged"), this, SLOT(onStatusChanged(QString, QString)));
+    bus.connect(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("ComposingChanged"), this, SLOT(onComposingChanged(QString, bool)));
+    bus.connect(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("StateChanged"), this, SLOT(onStateChanged(QString)));
+
+    connect(&m_watcher, &QDBusServiceWatcher::serviceOwnerChanged, this, [this](const QString &, const QString &, const QString &newOwner) {
+        m_caps.clear();
+        if (newOwner.isEmpty()) {
+            m_state.clear();
+            qDebug() << "RCS: IMSroha's RCS service is gone, SMS only";
+        } else {
+            fetchState();
+        }
+    });
+    fetchState();
+}
+
+void RcsTransport::fetchState()
+{
+    QDBusMessage get = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, SL("org.freedesktop.DBus.Properties"), SL("Get"));
+    get << RCS_IFACE << SL("State");
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(get), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *w) {
+        QDBusPendingReply<QDBusVariant> reply = *w;
+        if (reply.isValid()) {
+            onStateChanged(reply.value().variant().toString());
+        } else {
+            m_state.clear();
+        }
+        w->deleteLater();
+    });
+}
+
+bool RcsTransport::isRegistered() const
+{
+    return m_state == SL("registered");
+}
+
+void RcsTransport::onStateChanged(const QString &state)
+{
+    if (state != m_state) {
+        qDebug() << "RCS:" << state;
+    }
+    m_state = state;
+}
+
+QCoro::Task<bool> RcsTransport::canChat(const QString &e164)
+{
+    const auto now = QDateTime::currentDateTimeUtc();
+    const auto cached = m_caps.constFind(e164);
+    if (cached != m_caps.constEnd() && cached->until > now) {
+        co_return cached->chat;
+    }
+    if (!isRegistered()) {
+        co_return false;
+    }
+    QDBusMessage call = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("GetCapabilities"));
+    call << e164;
+    const QDBusPendingReply<QVariantMap> pending = QDBusConnection::systemBus().asyncCall(call);
+    const QDBusPendingReply<QVariantMap> reply = co_await pending;
+    if (!reply.isValid()) {
+        qDebug() << "RCS: capabilities of" << e164 << reply.error().message();
+        co_return false;
+    }
+    const auto caps = reply.value();
+    const bool known = caps.value(SL("known")).toBool();
+    const bool chat = caps.value(SL("chat")).toBool();
+    // An unanswered query is not cached: the next message asks again.
+    if (known) {
+        m_caps.insert(e164, Caps{chat, now.addSecs(chat ? 86400 : 600)});
+    }
+    co_return chat;
+}
+
+QCoro::Task<std::optional<QString>> RcsTransport::send(const QString &e164, const QString &text)
+{
+    QDBusMessage call = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("SendMessage"));
+    call << e164 << text;
+    const QDBusPendingReply<QString> pending = QDBusConnection::systemBus().asyncCall(call);
+    const QDBusPendingReply<QString> reply = co_await pending;
+    if (!reply.isValid()) {
+        qDebug() << "RCS: SendMessage to" << e164 << reply.error().message();
+        co_return std::nullopt;
+    }
+    co_return reply.value();
+}
+
+void RcsTransport::setComposing(const QString &e164, bool active)
+{
+    if (!isRegistered()) {
+        return;
+    }
+    QDBusMessage call = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("SetComposing"));
+    call << e164 << active;
+    QDBusConnection::systemBus().asyncCall(call);
+}
+
+void RcsTransport::markDisplayed(const QString &e164, const QString &messageId)
+{
+    if (!isRegistered()) {
+        return;
+    }
+    QDBusMessage call = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("MarkDisplayed"));
+    call << e164 << messageId;
+    QDBusConnection::systemBus().asyncCall(call);
+}
+
+void RcsTransport::onMessageReceived(const QString &number, const QString &messageId, const QString &text, qlonglong timestampMs)
+{
+    // Whoever chats with us can chat.
+    m_caps.insert(number, Caps{true, QDateTime::currentDateTimeUtc().addSecs(86400)});
+    Q_EMIT messageReceived(number, messageId, text, QDateTime::fromMSecsSinceEpoch(timestampMs));
+}
+
+void RcsTransport::onStatusChanged(const QString &messageId, const QString &status)
+{
+    Q_EMIT statusChanged(messageId, status);
+}
+
+void RcsTransport::onComposingChanged(const QString &number, bool active)
+{
+    Q_EMIT composingChanged(number, active);
+}
