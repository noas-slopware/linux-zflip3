new file mode 100644
index 0000000..c9ffd3b
--- /dev/null
+++ b/daemon/rcstransport.h
@@ -0,0 +1,60 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#pragma once
+
+#include <QDBusServiceWatcher>
+#include <QDateTime>
+#include <QHash>
+#include <QObject>
+
+#include <QCoroTask>
+
+#include <optional>
+
+/*
+ * RCS chat through IMSroha's codes.noa.IMSroha.Rcs on the system bus.
+ * Inert while that service is absent or not registered: then everything goes
+ * the SMS/MMS way through ModemManager, as before.
+ */
+class RcsTransport : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit RcsTransport(QObject *parent = nullptr);
+
+    bool isRegistered() const;
+    // Whether the number can chat (OPTIONS through IMSroha), cached a day when
+    // it can and ten minutes when it cannot.
+    QCoro::Task<bool> canChat(const QString &e164);
+    // The imdn.Message-ID, or nothing when RCS refused it (send it as SMS then).
+    QCoro::Task<std::optional<QString>> send(const QString &e164, const QString &text);
+    void setComposing(const QString &e164, bool active);
+    void markDisplayed(const QString &e164, const QString &messageId);
+
+Q_SIGNALS:
+    void messageReceived(const QString &number, const QString &messageId, const QString &text, const QDateTime &time);
+    // "sent", "delivered", "displayed" or "failed"
+    void statusChanged(const QString &messageId, const QString &status);
+    void composingChanged(const QString &number, bool active);
+
+private Q_SLOTS:
+    void onMessageReceived(const QString &number, const QString &messageId, const QString &text, qlonglong timestampMs);
+    void onStatusChanged(const QString &messageId, const QString &status);
+    void onComposingChanged(const QString &number, bool active);
+    void onStateChanged(const QString &state);
+
+private:
+    void connectService();
+    void fetchState();
+
+    QDBusServiceWatcher m_watcher;
+    QString m_state;
+    struct Caps {
+        bool chat;
+        QDateTime until;
+    };
+    QHash<QString, Caps> m_caps;
+};
