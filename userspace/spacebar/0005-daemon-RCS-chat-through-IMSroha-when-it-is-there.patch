-QCoro::Task<QString> ChannelLogger::sendMessageSMS(const PhoneNumber &phoneNumber, const QString &id, const QString &text)
+void ChannelLogger::setComposing(const QString &numbers, bool active)
+{
+    const PhoneNumberList list(numbers);
+    if (list.size() == 1) {
+        m_rcs.setComposing(list.first().toE164(), active);
+    }
+}
+
+QCoro::Task<QString> ChannelLogger::sendMessageRCS(const PhoneNumber &phoneNumber, const QString &id, const QString &text)
+{
+    Message message;
+    message.id = id;
+    message.phoneNumberList = PhoneNumberList(phoneNumber.toInternational());
+    message.text = text;
+    message.datetime = QDateTime::currentDateTime();
+    message.read = true;
+    message.sentByMe = true;
+    message.deliveryStatus = MessageState::Pending;
+    message.transport = SL("rcs");
+    co_await addMessage(message);
+
+    const auto rcsId = co_await m_rcs.send(phoneNumber.toE164(), text);
+    if (!rcsId) {
+        // RCS would not take it: the same message goes as SMS.
+        co_await m_database.updateMessageTransport(id, QString());
+        co_return co_await sendMessageSMS(phoneNumber, id, text, false);
+    }
+    co_await m_database.updateMessageSent(id, *rcsId, QString());
+    co_return QString();
+}
+
+QCoro::Task<void> ChannelLogger::handleRcsStatus(const QString &messageId, const QString &status)
+{
+    const auto id = co_await m_database.idForMessageId(messageId);
+    if (!id) {
+        co_return;
+    }
+    const auto found = co_await m_database.messagesForNumber(PhoneNumberList(), *id);
+    if (found.empty()) {
+        co_return;
+    }
+    const Message message = found.front();
+    if (status == SL("sent")) {
+        co_await m_database.updateMessageDeliveryState(*id, MessageState::Sent);
+    } else if (status == SL("delivered")) {
+        co_await m_database.updateMessageDeliveryState(*id, MessageState::Sent);
+        co_await m_database.updateMessageDeliveryReport(messageId);
+    } else if (status == SL("displayed")) {
+        co_await m_database.updateMessageReadReport(messageId, message.phoneNumberList.first());
+    } else if (status == SL("failed") && message.deliveryStatus != MessageState::Sent) {
+        // Not delivered over RCS (no session, the far end is gone): fall back to SMS.
+        qDebug() << "RCS: message" << messageId << "failed, sending it as SMS";
+        co_await m_database.updateMessageTransport(*id, QString());
+        co_await sendMessageSMS(message.phoneNumberList.first(), *id, message.text, false);
+        co_return;
+    }
+    updateMessage(message);
+}
+
+QCoro::Task<QString> ChannelLogger::sendMessageSMS(const PhoneNumber &phoneNumber, const QString &id, const QString &text, bool addToDatabase)
 {
     ModemManager::ModemMessaging::Message m;
     m.number = phoneNumber.toE164();
@@ -459,8 +540,13 @@ QCoro::Task<QString> ChannelLogger::sendMessageSMS(const PhoneNumber &phoneNumbe
     message.sentByMe = true;
     message.deliveryStatus = MessageState::Pending;
 
-    // add message to database
-    co_await addMessage(message);
+    // add message to database (an RCS fallback is there already)
+    if (addToDatabase) {
+        co_await addMessage(message);
+    } else {
+        co_await m_database.updateMessageDeliveryState(message.id, MessageState::Pending);
+        updateMessage(message);
+    }
 
     auto maybeReply = ModemController::instance().createMessage(m);
 
