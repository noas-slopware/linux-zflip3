+QCoro::Task<std::optional<QString>> RcsTransport::sendFile(const QString &e164, const QString &path)
+{
+    QDBusMessage call = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("SendFile"));
+    call << e164 << path;
+    const QDBusPendingReply<QString> pending = QDBusConnection::systemBus().asyncCall(call);
+    const QDBusPendingReply<QString> reply = co_await pending;
+    if (!reply.isValid()) {
+        qDebug() << "RCS: SendFile to" << e164 << reply.error().message();
