+// The conversation's attachment folder, where the app looks for its files.
+static QString attachmentsFolder(const PhoneNumberList &phoneNumberList)
+{
+    const QString folder = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + SL("/spacebar/attachments/")
+        + QString::number(hash(phoneNumberList.toString()));
+    QDir().mkpath(folder);
+    return folder;
+}
+
+// A file the app hands over for sending ("file://..."), as a local path.
+static QString localPath(const QString &file)
+{
+    const QUrl url(file);
+    return url.isLocalFile() ? url.toLocalFile() : file;
+}
+
+// Puts a file into the conversation's attachment folder under a new name, as
+// MMS does with its parts (moving it when it is ours to take, copying it
+// otherwise), and describes it the way MMS attachments are described.
+static QJsonObject storeAttachment(const PhoneNumberList &phoneNumberList, const QString &path, const QString &contentType, bool move)
+{
+    const QFileInfo info(path);
+    if (!info.isAbsolute() || info.isSymLink() || !info.isFile()) {
+        return {};
+    }
+    QMimeDatabase db;
+    QMimeType mime = db.mimeTypeForFile(path);
+    if (mime.isDefault() && !contentType.isEmpty()) {
+        const QMimeType given = db.mimeTypeForName(contentType);
+        if (given.isValid()) {
+            mime = given;
+        }
+    }
+    const QString suffix = mime.preferredSuffix();
+    const QString fileName = Database::generateRandomId() + (suffix.isEmpty() ? QString() : SL(".") + suffix);
+    const QString target = attachmentsFolder(phoneNumberList) + SL("/") + fileName;
+    if (!(move ? QFile::rename(path, target) : QFile::copy(path, target))) {
+        qDebug() << "Could not store" << path << "as" << target;
+        return {};
+    }
+    return QJsonObject{
+        {SL("name"), info.fileName()},
+        {SL("fileName"), fileName},
+        {SL("size"), QFileInfo(target).size()},
+        {SL("mimeType"), mime.name()},
+        {SL("iconName"), mime.iconName()},
+        {SL("text"), QString()},
+    };
+}
+
+static QString attachmentJson(const QJsonObject &attachment)
+{
+    return QString::fromUtf8(QJsonDocument(QJsonArray{attachment}).toJson(QJsonDocument::Compact));
+}
+
+// What the conversation says when a file was sent to us over RCS but did
+// not arrive.
+static QString rcsFileFailedText(const QString &reason)
+{
+    if (reason == u"expired") {
+        return i18nc("@info RCS file transfer", "A file was sent to you, but it expired before it could be downloaded.");
+    } else if (reason == u"too-large") {
+        return i18nc("@info RCS file transfer", "A file was sent to you, but it is too large to download.");
+    } else if (reason == u"unauthorized") {
+        return i18nc("@info RCS file transfer", "A file was sent to you, but the server refused to hand it out.");
+    } else if (reason == u"gone") {
+        return i18nc("@info RCS file transfer", "A file was sent to you, but it is no longer on the server.");
+    } else if (reason == u"invalid") {
+        return i18nc("@info RCS file transfer", "A file was sent to you, but its description could not be read.");
+    }
+    return i18nc("@info RCS file transfer", "A file was sent to you, but downloading it failed.");
+}
