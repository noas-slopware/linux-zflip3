+QCoro::Task<std::optional<QString>>
+ChannelLogger::sendFilesRCS(const PhoneNumberList &phoneNumberList, const QString &id, const QString &text, const QStringList &files)
+{
+    // Every file is a message of its own, and so is the text, after them. The
+    // first one takes the id the app shows the message under. Nothing when
+    // RCS did not take the first file: then it all goes the MMS way.
+    const QString e164 = phoneNumberList.first().toE164();
+    bool first = true;
+    for (const auto &file : files) {
+        const QString path = localPath(file);
+        const QJsonObject attachment = storeAttachment(phoneNumberList, path, QString(), false);
+        std::optional<QString> rcsId;
+        if (!attachment.isEmpty()) {
+            // under its own name, which the other side sees
+            rcsId = co_await m_rcs.sendFile(e164, path);
+        }
+        if (!rcsId) {
+            if (!attachment.isEmpty()) {
+                QFile::remove(attachmentsFolder(phoneNumberList) + SL("/") + attachment.value(SL("fileName")).toString());
+            }
+            if (first) {
+                co_return std::nullopt;
+            }
+            // Some went already: this one goes as MMS of its own.
+            co_await sendMessageMMS(phoneNumberList, Database::generateRandomId(), QString(), {file}, QFileInfo(path).size());
+            continue;
+        }
+
+        Message message;
+        message.id = first ? id : Database::generateRandomId();
+        message.phoneNumberList = phoneNumberList;
+        message.datetime = QDateTime::currentDateTime();
+        message.read = true;
+        message.sentByMe = true;
+        message.deliveryStatus = MessageState::Pending;
+        message.attachments = attachmentJson(attachment);
+        message.messageId = *rcsId;
+        message.transport = SL("rcs");
+        co_await addMessage(message);
+        updateMessage(message);
+        first = false;
+    }
+
+    if (!text.isEmpty()) {
+        co_return co_await sendMessageRCS(phoneNumberList.first(), Database::generateRandomId(), text);
+    }
+    co_return QString();
+}
