+QCoro::Task<void> ChannelLogger::handleRcsFile(const QString number,
+                                               const QString messageId,
+                                               const QString path,
+                                               const QString contentType,
+                                               qulonglong size,
+                                               const QString thumbnailPath,
+                                               const QDateTime time)
+{
+    Q_UNUSED(size);
+    const PhoneNumberList phoneNumberList(number);
+    // The conversation shows the file itself, so its thumbnail has no use.
+    if (!thumbnailPath.isEmpty() && QFileInfo(thumbnailPath).absolutePath() == QFileInfo(path).absolutePath()) {
+        QFile::remove(thumbnailPath);
+    }
+    // IMSroha created it as the owner of its download directory: us. It
+    // moves into Spacebar's attachments, like an MMS part.
+    const QJsonObject attachment = storeAttachment(phoneNumberList, path, contentType, true);
+    if (attachment.isEmpty()) {
+        qDebug() << "RCS: file" << messageId << "from" << number << "could not be taken from" << path;
+        co_await saveMessage(phoneNumberList,
+                             time,
+                             rcsFileFailedText(SL("failed")),
+                             QString(),
+                             QString(),
+                             QString(),
+                             QString(),
+                             false,
+                             QString(),
+                             QDateTime(),
+                             0,
+                             SL("rcs"));
+        co_return;
+    }
+    co_await saveMessage(phoneNumberList,
+                         time,
+                         QString(),
+                         attachmentJson(attachment),
+                         QString(),
+                         QString(),
+                         messageId,
+                         false,
+                         QString(),
+                         QDateTime(),
+                         0,
+                         SL("rcs"));
+}
