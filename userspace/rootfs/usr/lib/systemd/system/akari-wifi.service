[Unit]
Description=Use the Wi-Fi MAC address from Samsung efs in NetworkManager
# The QCA6390 reports a Qualcomm placeholder (00:03:7f:...) as its permanent
# address; the real one is on efs. NetworkManager reads /run/NetworkManager/conf.d.
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p /run/NetworkManager/conf.d && printf "[connection-akari]\\nmatch-device=driver:ath11k_pci\\nwifi.cloned-mac-address=%%s\\n" "$(/usr/lib/akari/akari wifi)" > /run/NetworkManager/conf.d/10-akari-wifi.conf'

[Install]
WantedBy=NetworkManager.service
