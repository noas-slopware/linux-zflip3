# neard is the userspace daemon for the kernel NFC/NCI stack. It is not in the
# Arch Ports repositories; build it here. nfctool comes with --enable-tools and
# is the quick way to start polling on /dev/nfc0.

pkgname=neard
pkgver=0.20
pkgrel=1
pkgdesc="Linux NFC daemon for the kernel NCI stack"
arch=(aarch64)
url="https://github.com/linux-nfc/neard"
license=(GPL-2.0-only)
depends=(dbus libnl glib2)
makedepends=(autoconf automake libtool autoconf-archive)
source=("https://github.com/linux-nfc/neard/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('2b3c12e7ce77901a649237ea044d9af5b4df54c0cbeed5036b5342dbc89dc3fd')

build() {
  cd "neard-${pkgver}"
  ./bootstrap
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libexecdir=/usr/lib/neard \
    --with-systemdsystemunitdir=/usr/lib/systemd/system \
    --enable-systemd \
    --enable-tools \
    --enable-ese \
    --disable-debug
  make
}

package() {
  cd "neard-${pkgver}"
  make DESTDIR="$pkgdir" install

  install -Dm644 src/main.conf "$pkgdir/etc/neard/main.conf"
}
