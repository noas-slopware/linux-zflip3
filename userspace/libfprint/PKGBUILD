# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Tom Gundersen <teg@jklm.no>
# Contributor: Thomas Baechler <thomas@archlinux.org>
# b2q: Arch PKGBUILD plus 0001 (misc character devices for udev drivers) and
# 0002 (samsung_securefp driver for Samsung's TrustZone fingerprint TA), and the
# fprintd sandbox drop-in that lets fprintd open /dev/qsee-app and the GPIO chips.

pkgname=libfprint
pkgver=1.94.100
pkgrel=5
pkgdesc="Library for fingerprint readers"
url="https://fprint.freedesktop.org/"
arch=(x86_64 aarch64)
license=(LGPL-2.1-or-later)
depends=(
  libgcc
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
provides=(libfprint-2.so)
groups=(fprint)
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git?signed#tag=v$pkgver"
        0001-fp-context-support-misc-character-devices-for-udev-d.patch
        0002-samsung_securefp-add-a-driver-for-Samsung-s-TrustZon.patch
        fprintd-samsung-securefp.conf)
b2sums=('56cbe62a6d4b98d1de90f45bae8de605418802d1b4d8d5dc55a8557a65045b115df51daf8385decdebd8aea79c86103467d5a327cbd461030d450f0e15466d08'
        'b0bac4907a0e58ffb4c63831010abc6c190bc0bc8858370fef4394d40f83378952d6c884d82fcab3e7c709317dd60aadcacd45786da36c1e72096ec52aa10a63'
        '70e600c27355059e0740ad3c7d9397c5e48697546a979b9fda740708959a1bcc0cad408d269acf8667d0a38279a423982a37dd1cb7c632a3ee932a912ea20a10'
        '9903a4adb5b5f0442979e5f49a2551a0103815f748522cbe896fa1e79ac4afef83a9157adede5e88ad93de18c70cd9361714cb25ebf06e9b52607609e4fdf670')
validpgpkeys=(
  D4C501DA48EB797A081750939449C2F50996635F # Marco Trevisan (Treviño) <mail@3v1n0.net>
)

prepare() {
  cd $pkgname
  git apply ../0001-fp-context-support-misc-character-devices-for-udev-d.patch ../0002-samsung_securefp-add-a-driver-for-Samsung-s-TrustZon.patch
}

build() {
  local meson_options=(
    # Add virtual drivers for integration tests (e.g. in fprintd)
    -D drivers=all

    -D installed-tests=false
  )

  arch-meson $pkgname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 fprintd-samsung-securefp.conf \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/samsung-securefp.conf"
}

