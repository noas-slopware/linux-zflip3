+#pragma once
+
+#include "fpi-device.h"
+
+G_DECLARE_FINAL_TYPE (FpiDeviceSamsungSecurefp, fpi_device_samsung_securefp, FPI, DEVICE_SAMSUNG_SECUREFP, FpDevice)
+
+/* Shared buffer the Android client library (libbauthtzcommon) gives the TA */
+#define SECUREFP_SBUF_SIZE        0x1f4140
+/* libQSEEComAPI rounds it up to a page; Control_OP needs 0x1f4180 */
+#define SECUREFP_SBUF_ALLOC       0x1f5000
+/* BAuth_Control_OP's fixed request and reply sizes */
+#define SECUREFP_CTL_REQ_LEN      0xfa140
+#define SECUREFP_CTL_RSP_LEN      0xfa040
+/* Largest request and reply we send: Control_OP's */
+#define SECUREFP_REQ_MAX          SECUREFP_CTL_REQ_LEN
+#define SECUREFP_RSP_MAX          SECUREFP_CTL_RSP_LEN
+#define SECUREFP_TA_PATH          "qcom/sm8350/Samsung/b2q/securefp"
+
+/* TA opcodes (first word of every request), from libbauthtzcommon.so */
+#define SECUREFP_OP_PREPARE         0x01
+#define SECUREFP_OP_ENROLL_INIT     0x02
+#define SECUREFP_OP_ENROLL_DO       0x03
+#define SECUREFP_OP_ENROLL_FINAL    0x04
+#define SECUREFP_OP_IDENTIFY_INIT   0x05
+#define SECUREFP_OP_IDENTIFY_DO     0x06
+#define SECUREFP_OP_IDENTIFY_FINAL  0x07
+#define SECUREFP_OP_CANCEL          0x0a
+#define SECUREFP_OP_CONTROL         0x0c
+#define SECUREFP_OP_TYPE_CHECK      0x10
+
+/* What stock's HAL passes for and expects from a Goodix GW36T1 */
+#define SECUREFP_GW36T1_TYPE_ARG    18
+#define SECUREFP_GW36T1_TYPE        6
