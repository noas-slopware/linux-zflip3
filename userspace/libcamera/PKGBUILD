  0003-ipa-ipu3-Move-non-specific-parts-of-Af-to-libipa.patch
  0004-ipa-libipa-Add-af-prepareControls.patch
  0005-libcamera-software_isp-Add-variance-to-stats.patch
  0006-ipa-softisp-Add-Af-algorithm.patch
  0007-libcamera-software_isp-Add-autofocus-controls.patch
  0008-ipa-libipa-Use-autofocus-limits-if-available.patch
  0009-libcamera-camera_lens-Close-the-lens-subdev-when-not.patch
  0010-libcamera-pipeline-ipu3-Power-the-lens-only-while-th.patch
  0011-libcamera-software_isp-Compute-the-focus-statistic.patch
  0012-ipa-libipa-af-Scale-the-scan-steps-to-the-lens-range.patch
  0013-ipa-simple-Add-an-IMX563-tuning-file-with-autofocus.patch
  0014-libcamera-pipeline-simple-Power-the-lens-only-while-.patch
)
