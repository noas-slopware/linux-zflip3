# b2q: Arch's libcamera PKGBUILD (packaging/packages/libcamera, 0.7.2-4) for aarch64, plus
# 0001 (sensor helpers for the IMX374 and IMX563, the Flip3's front and rear wide
# cameras) and autofocus for the rear wide's AK7377:
#   0002-0008  Milan Zamazal, "Autofocus basics for software ISP" v2 (patchwork series
#              6324, 2026-10-31), backported from master to 0.7.2 (soft IPA paths and
#              namespaces; 5/8 is cleanup only and left out). In 0007 the lens also
#              moves when the pipeline has a frame-start emitter.
#   0009-0010  Marco Ziliani, lens power RFC (series 6303): close the lens subdev when idle
#   0011       the focus statistic the series leaves at 0
#   0012       AF scan steps scaled to the lens range (4095 here, not IPU3's 1023)
#   0013       IMX563 tuning file with Af
#   0014       the simple pipeline powers the lens only while streaming libcamera-docs is not built: its doxygen/sphinx/texlive toolchain is not
# worth building on the phone, and the docs are the same as Arch's.
# Maintainer: David Runge <dvzrv@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-ipa
  libcamera-tools
  gst-plugin-libcamera
  python-libcamera
)
pkgver=0.7.2
pkgrel=6
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS"
arch=(x86_64 aarch64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
makedepends=(
  cmake
  git
  glib2
  gst-plugins-base
  gtest
  libdrm
  libgcc
  libjpeg-turbo
  libstdc++
  libtiff
  libyaml
  libyuv
  meson
  pybind11
  python-jinja
  python-ply
  python-pyyaml
  qt6-base
  qt6-tools
  sdl2
  systemd
)
