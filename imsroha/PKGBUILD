#
# imsroha: userspace IMS (VoLTE, SMS over IMS) for Linux phones with Qualcomm
# QMI modems.
# b2q: packaging/PKGBUILD from IMSroha (noas-slopware/imsroha) at _imsrohacommit, built from its GitHub
# tarball; nothing of it is copied here.
# vo-amrwbenc (the AMR-WB encoder) is needed at build and run time and is not
# in the Arch repos: build the AUR's vo-amrwbenc first (0.1.3-2 as of 2026-11).

pkgname=imsroha
pkgver=0.2.0
pkgrel=20
pkgdesc="Userspace IMS: VoLTE calls and SMS over IMS on Qualcomm QMI modems, behind ModemManager"
arch=('aarch64' 'x86_64')
url="https://github.com/noas-slopware/imsroha"
license=('GPL-3.0-only')
depends=('glib2' 'glib-networking' 'gnutls' 'libqmi' 'libqrtr-glib' 'systemd-libs' 'alsa-lib' 'opencore-amr' 'vo-amrwbenc' 'iproute2')
makedepends=('meson' 'gcc' 'pkgconf')
# The tests need python, openssl, util-linux (unshare) and dbus (dbus-run-session).
checkdepends=('python' 'openssl' 'util-linux' 'dbus')
optdepends=('modemmanager: with the IMSroha backend from modemmanager/, for dialers and SMS apps'
            'pipewire-alsa: call audio in the user session')
backup=('etc/imsroha/imsroha.conf')
install=imsroha.install
_imsrohacommit=6b0bf8d620faba77e83dd7ca5423f47a0e01c6c0
source=("imsroha-$_imsrohacommit.tar.gz::https://github.com/noas-slopware/imsroha/archive/$_imsrohacommit.tar.gz")
sha256sums=('d82aa4e5056224fe800ef4a1ddffd5cd3fc820cc309cd879873f46b413818942')

_src=imsroha-$_imsrohacommit

build() {
	arch-meson "$_src" build
	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 "$_src/data/imsroha.conf" "$pkgdir/etc/imsroha/imsroha.conf"
	install -Dm644 "$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 "$_src/docs/rcs.md" "$pkgdir/usr/share/doc/$pkgname/rcs.md"
}
