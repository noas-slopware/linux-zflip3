# Maintainer: Noa Himesaka <himesaka@noa.codes>
#
# Hinata: every cell broadcast alert the phone has received (Kirigami, reads cellbroadcastd).
# Source: userspace/hinata on the senpai branch of noas-slopware/linux-zflip3 (cmake).

pkgname=hinata
pkgver=0.1.0
pkgrel=1
pkgdesc='Every cell broadcast alert the phone has received'
url='https://github.com/noas-slopware/linux-zflip3'
arch=(aarch64)
license=(GPL-3.0-or-later)
depends=(cellbroadcastd glib2 kirigami qqc2-desktop-style qt6-base qt6-declarative)
makedepends=(cmake extra-cmake-modules)
# senpai branch (default) of noas-slopware/linux-zflip3
_zf3commit=ce0353f99c7f264353d2824126b19539b9687f1d
source=("linux-zflip3-$_zf3commit.tar.gz::https://github.com/noas-slopware/linux-zflip3/archive/$_zf3commit.tar.gz")
sha256sums=('8142183e365753a5fe57f87b61c9e00b862dee28a0b8be9d74f8ae72e49d059e')

build() {
  cmake -B build -S linux-zflip3-$_zf3commit/userspace/hinata \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 linux-zflip3-$_zf3commit/userspace/hinata/README.md -t "$pkgdir"/usr/share/doc/hinata/
}
