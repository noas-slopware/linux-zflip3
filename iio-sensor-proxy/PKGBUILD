# Maintainer: Noa Himesaka <himesaka@noa.codes>
# SPDX-License-Identifier: MIT
#
# Arch's iio-sensor-proxy is built with the libssc backend, but 3.9 has the
# start-up race where a client (Plasma, GNOME) claims the accelerometer while
# find_sensors() is still doing synchronous QMI calls: the claim only registers
# the client and polling never starts, so the orientation stays undefined.
# Patch from Joonhoe Kim (tb323fu-linux), applies to 3.9 (0085ddf8).

pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=2
pkgdesc="IIO and Qualcomm SSC sensor proxy for the b2q sensors"
arch=(aarch64)
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/"
license=(GPL-3.0-only)
depends=(glib2 libgudev libssc polkit)
makedepends=(meson)
source=("https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/${pkgver}/iio-sensor-proxy-${pkgver}.tar.gz"
        0001-start-sensors-claimed-before-they-were-opened.patch
        0002-proximity-allow-a-udev-selected-raw-channel.patch)
sha256sums=('af5edd307dcfa52dc3a242d13b7cc756e90a71640caf332efbad960e21649ae4'
            'c2f605c7f6bb95631c657b8d79511146a97791818ce19baaee6a1f67eaf262ec'
            '91dc8564d061730dce5bec759a2c663ec9ed2e84bab984e4fa092a8868af7d01')

prepare() {
  for p in 0001-start-sensors-claimed-before-they-were-opened.patch \
           0002-proximity-allow-a-udev-selected-raw-channel.patch; do
    patch -d "iio-sensor-proxy-${pkgver}" -p1 < $p
  done
}

build() {
  arch-meson "iio-sensor-proxy-${pkgver}" build -Dssc-support=enabled -Dtests=false
  meson compile -C build
}

package() {
  DESTDIR="$pkgdir" meson install --no-rebuild -C build
}
