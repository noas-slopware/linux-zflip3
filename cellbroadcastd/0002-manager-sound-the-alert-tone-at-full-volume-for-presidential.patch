+ * SPDX-License-Identifier: GPL-3.0+
+ */
+
+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/*
+ * How an alert sounds, by its channel:
+ *
+ * FULL:   the alert tone on the phone's speakers at full volume, unmuted, and on
+ *         every connected device (Bluetooth, USB, headphones) at that device's
+ *         own volume.
+ * RAISED: the alert tone on the connected devices only, at their own volume,
+ *         when there are any; otherwise on the speakers at half volume or the
+ *         user's volume, whichever is higher, unmuted.
+ * NORMAL: a short chime on the default output at the user's volume (silent when
+ *         that is muted).
+ *
+ * A connected device always keeps its own volume, for the ears it is on. The
+ * speakers' volume and mute are put back when the tone is over, unless the user
+ * changed them meanwhile.
+ */
+typedef enum {
+  CBD_ALERT_SOUND_NONE,
+  CBD_ALERT_SOUND_NORMAL,
+  CBD_ALERT_SOUND_RAISED,
+  CBD_ALERT_SOUND_FULL,
+} CbdAlertSoundLevel;
+
+typedef struct _CbdAlertSound CbdAlertSound;
+
+CbdAlertSound *cbd_alert_sound_new  (void);
+void           cbd_alert_sound_free (CbdAlertSound *self);
+/* A new alert replaces one still playing. */
+void           cbd_alert_sound_play (CbdAlertSound *self, CbdAlertSoundLevel level);
+
+/* For tests: called when the tone has started on every output, and when it is over. */
+typedef void (*CbdAlertSoundHook) (CbdAlertSound *self, gboolean started, gpointer user_data);
+void           cbd_alert_sound_set_hook (CbdAlertSound *self, CbdAlertSoundHook hook, gpointer user_data);
+/* For tests: the length of the alert tone in ms (default 10500). */
+void           cbd_alert_sound_set_tone_ms (CbdAlertSound *self, guint ms);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (CbdAlertSound, cbd_alert_sound_free)
+
+G_END_DECLS
