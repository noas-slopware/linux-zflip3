+{
+  g_autoptr (GVariant) v = g_settings_get_value (settings, key);
+  gsize n = 0;
+  const guint16 *ch = g_variant_get_fixed_array (v, &n, sizeof (guint16));
+
+  for (gsize i = 0; i < n; i++) {
+    if (ch[i] == channel)
+      return TRUE;
+  }
+  return FALSE;
+}
+
+/* The alert tone for these channels sounds whether or not notifications are sent. */
+static CbdAlertSoundLevel
+alert_sound_level (CbdManager *self, CbdMessage *msg, guint channel)
+{
+  if (channel_in (self->settings, "alert-sound-full-channels", channel))
+    return CBD_ALERT_SOUND_FULL;
+  if (channel_in (self->settings, "alert-sound-raised-channels", channel))
+    return CBD_ALERT_SOUND_RAISED;
+  if (check_send_notification (self, msg))
+    return CBD_ALERT_SOUND_NORMAL;
+  return CBD_ALERT_SOUND_NONE;
+}
