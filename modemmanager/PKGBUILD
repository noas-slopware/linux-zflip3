# Maintainer: Noa Himesaka <himesaka@noa.codes>
# b2q: modemmanager/PKGBUILD and its patches from IMSroha (noas-slopware/imsroha) at _imsrohacommit, built from its GitHub
# tarball; nothing of it is copied here.
# SPDX-License-Identifier: GPL-3.0-only
# (this recipe; ModemManager and the patches to it are GPL-2.0-or-later)
#
# ModemManager 1.24.2 with the IMSroha backend (voice and messaging handed to
# imsroha over D-Bus), the bearer-count crash fix, IMS DTMF, the kept IPA QMAP
# path, per-carrier SMS (SKT keeps SMS on the modem) and port-addressed SMS
# from the modem handed to imsroha (imsroha's modemmanager/README.md; 0002 is
# kept for reference and not applied). pkgrel is above the Arch package's, so
# this build wins. The udev rule that enables the backend ships with imsroha.

pkgname=modemmanager
pkgver=1.24.2
pkgrel=19
pkgdesc="Mobile broadband modem management service with IMSroha (userspace IMS) support"
url="https://www.freedesktop.org/wiki/Software/ModemManager/"
arch=(aarch64 x86_64)
license=(GPL-2.0-or-later)
depends=(
  bash
  glib2
  glibc
  hicolor-icon-theme
  libgcc
  libgudev
  libmbim
  libqmi
  libqrtr-glib
  mobile-broadband-provider-info
  polkit
  ppp
  systemd-libs
  libmm-glib
)
makedepends=(
  bash-completion
  git
  glib2-devel
  gobject-introspection
  # include/meson.build runs xsltproc even with gtk_doc off (Arch gets it through gtk-doc)
  libxslt
  meson
  systemd
)
_imsrohacommit=6f8f9ffaea6e27b41580ab1bd76c4b55e52bb0e7
source=(
  "git+https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git#tag=${pkgver}"
  "imsroha-$_imsrohacommit.tar.gz::https://github.com/noas-slopware/imsroha/archive/$_imsrohacommit.tar.gz"
  # Cell Broadcast over QMI, from upstream main after 1.24.2 (git format-patch of the cherry-picks,
  # each with its upstream commit): 1.24.2 only has the AT path, so a QMI-only modem never got the
  # interface ("CellBroadcast not supported") and no alert reached the phone
  cbs-0001-broadband-modem-qmi-Add-initial-interface-bits.patch
  cbs-0002-broadband-modem-qmi-Add-support-for-setting-channels.patch
  cbs-0003-broadband-modem-qmi-Add-support-for-loading-channels.patch
  cbs-0004-broadband-modem-qmi-Enable-Cell-Broadcast.patch
  cbs-0005-broadband-modem-qmi-cellbroadcast-Return-on-failure.patch
  cbs-0006-broadband-modem-qmi-cellbroadcast-Allow-for-G_MAXUIN.patch
  cbs-0007-base-cbm-Install-properties-one-by-one.patch
  cbs-0008-cbm-part-Use-automatic-cleanup.patch
  cbs-0009-cbm-part-Fix-parsing-of-language-encodings.patch
  cbs-0010-cbm-part-Handle-additional-coding-schemes-and-parse-.patch
  cbs-0011-base-cbm-Export-the-lang-property-on-DBus.patch
  cbs-0012-cbm-part-Use-the-correct-codes-for-Czech-and-Danish.patch
  cbs-0013-mm-cbm-part-Try-harder-to-convert-message-text.patch
  cbs-0014-CVE-2026-95622-cbm-don-t-assert-handling-unsupported.patch
  cbs-0015-tests-a-Korean-presidential-alert-UCS-2-channel-4370.patch
  # upstream 5a3b810b, 857efa1f: the bus let no user call the CellBroadcast interface
  cbs-0016-polkit-conf-Add-missing-Cell-Broadcast-methods.patch
  cbs-0017-polkit-conf-Add-missing-Cell-Broadcast-SetChannel-method.patch
)
