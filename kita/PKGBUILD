# Maintainer: Noa Himesaka <himesaka@noa.codes>
#
# Kita, the Galaxy Z Flip3 cover display daemon: leases the cover panel (DSI-2) from the compositor
# through wp_drm_lease_v1 and draws the clock, notifications and calls on it. Source: userspace/kita
# on the senpai branch of noas-slopware/linux-zflip3 (meson).

pkgname=kita
pkgver=0.1.0
pkgrel=1
pkgdesc='Galaxy Z Flip3 cover display: clock, notifications and calls'
url='https://github.com/noas-slopware/linux-zflip3'
arch=(aarch64)
license=(MIT)
depends=(cairo glib2 libdrm pango qt6-declarative systemd-libs wayland)
makedepends=(meson wayland-protocols)
# senpai branch (default) of noas-slopware/linux-zflip3
_zf3commit=a160d0fa7207ec7348d1ef4c5b1ac756d28f5f59
source=("linux-zflip3-$_zf3commit.tar.gz::https://github.com/noas-slopware/linux-zflip3/archive/$_zf3commit.tar.gz")
sha256sums=('1c5a8c4711833692c78bfea170bf5c6e9e99b777de00601706c41ebe970859ff')

build() {
  arch-meson linux-zflip3-$_zf3commit/userspace/kita build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
  install -Dm644 linux-zflip3-$_zf3commit/userspace/kita/README.md -t "$pkgdir"/usr/share/doc/kita/
}
